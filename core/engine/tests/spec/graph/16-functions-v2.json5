// --- $nodes: reading earlier node outputs ----------------------------------------------------

{
  name: "v2 reads the input node and an earlier expression node",
  graph: {
    nodes: [
      {expression: "calc", fields: {doubled: "a * 2"}},
      {function: "f", source: """export const handler = async (input) => ({
  fromInput: input.$nodes.input.a,
  fromCalc: input.$nodes.calc.doubled,
  direct: input.doubled,
});"""},
    ],
  },
  cases: [
    [{a: 2}, {fromInput: 2, fromCalc: 4, direct: 4}],
    [{a: 0}, {fromInput: 0, fromCalc: 0, direct: 0}],
    [{a: -1.5}, {fromInput: -1.5, fromCalc: -3, direct: -3}],
  ],
}

{
  name: "v2 $nodes lists only nodes that have run",
  graph: {
    nodes: [
      {expression: "first", fields: {v: "1"}},
      {function: "f", source: """export const handler = async (input) => ({
  names: Object.keys(input.$nodes).sort(),
  hasLast: 'last' in input.$nodes,
  lastType: typeof input.$nodes.last,
});"""},
      {expression: "last", fields: {names: "names", hasLast: "hasLast", lastType: "lastType"}},
    ],
  },
  cases: [
    [{}, {names: ["first", "input"], hasLast: false, lastType: "undefined"}],
    [{x: 1}, {names: ["first", "input"], hasLast: false, lastType: "undefined"}],
  ],
}

{
  name: "v2 $nodes of a branch that did not run",
  graph: {
    nodes: [
      {switch: "route", when: ["kind == 'a'", ""]},
      {expression: "a", fields: {picked: "'a'"}},
      {expression: "b", fields: {picked: "'b'"}},
      {function: "f", source: """export const handler = async (input) => ({
  picked: input.picked,
  ranA: input.$nodes.a !== undefined,
  ranB: input.$nodes.b !== undefined,
});"""},
    ],
    edges: ["input -> route", "route:0 -> a -> f", "route:1 -> b -> f", "f -> output"],
  },
  cases: [
    [{kind: "a"}, {picked: "a", ranA: true, ranB: false}],
    [{kind: "b"}, {picked: "b", ranA: false, ranB: true}],
    [{}, {picked: "b", ranA: false, ranB: true}],
  ],
}

{
  name: "v2 reads the output of an earlier function node",
  graph: {
    nodes: [
      {function: "one", source: """export const handler = async (input) => ({ step: 1, value: input.v * 10 });"""},
      {function: "two", source: """export const handler = async (input) => ({ step: input.$nodes.one.step + 1, value: input.$nodes.one.value + input.$nodes.input.v });"""},
    ],
  },
  cases: [
    [{v: 1}, {step: 2, value: 11}],
    [{v: 3}, {step: 2, value: 33}],
  ],
}

{
  name: "v2 reads a decision table output by node name",
  graph: {
    nodes: [
      {table: "tier", inputs: ["score"], outputs: ["tier"], rules: [
        [">= 80", "'gold'"],
        [">= 50", "'silver'"],
        ["", "'bronze'"],
      ]},
      {function: "f", source: """export const handler = async (input) => ({ tier: input.$nodes.tier.tier, score: input.$nodes.input.score ?? null });"""},
    ],
  },
  cases: [
    [{score: 90}, {tier: "gold", score: 90}],
    [{score: 60}, {tier: "silver", score: 60}],
    [{score: 1}, {tier: "bronze", score: 1}],
    [{}, {tier: "bronze"}],
  ],
}

{
  name: "v2 $nodes inside a sub-decision reaches the parent through its input node",
  decisions: {
    child: {nodes: [
      {input: "request"},
      {function: "inner", source: """export const handler = async (input) => ({
  parentCalc: input.$nodes.request.$nodes?.calc?.v ?? null,
  own: Object.keys(input.$nodes).sort(),
});"""},
    ], edges: ["request -> inner -> output"]},
  },
  graph: {
    nodes: [
      {expression: "calc", fields: {v: "a + 1"}},
      {decision: "call", key: "child"},
    ],
  },
  cases: [
    [{a: 1}, {parentCalc: 2, own: ["request"]}],
    [{a: 9}, {parentCalc: 10, own: ["request"]}],
  ],
}

// --- Function nodes in larger graphs -------------------------------------------------------

{
  name: "v2 two functions merge at the output",
  graph: {
    nodes: [
      {function: "left", source: """export const handler = async (input) => ({ left: input.v, shared: 'left' });"""},
      {function: "right", source: """export const handler = async (input) => ({ right: input.v, shared: 'right' });"""},
    ],
    edges: ["input -> left -> output", "input -> right -> output"],
  },
  cases: [
    [{v: 1}, {left: 1, right: 1, shared: "left"}, "question: incoming outputs merge in reverse edge order, so the first-listed edge wins a shared key"],
    [{v: "x"}, {left: "x", right: "x", shared: "left"}, "question: incoming outputs merge in reverse edge order, so the first-listed edge wins a shared key"],
    [{v: null}, {shared: "left"}, "question: incoming outputs merge in reverse edge order, so the first-listed edge wins a shared key"],
  ],
}

{
  name: "v2 function feeding a decision table",
  graph: {
    nodes: [
      {function: "prep", source: """export const handler = async (input) => ({ age: new Date('2025-01-01').getUTCFullYear() - input.birthYear });"""},
      {table: "t", inputs: ["age"], outputs: ["group"], rules: [
        ["< 18", "'minor'"],
        ["[18..64]", "'adult'"],
        ["", "'senior'"],
      ]},
    ],
  },
  cases: [
    [{birthYear: 2010}, {group: "minor"}],
    [{birthYear: 1990}, {group: "adult"}],
    [{birthYear: 1950}, {group: "senior"}],
    [{birthYear: 2007}, {group: "adult"}],
  ],
}

{
  name: "v2 function after a pass-through expression",
  graph: {
    nodes: [
      {expression: "e", passThrough: true, fields: {total: "price * qty"}},
      {function: "f", source: """export const handler = async (input) => ({ summary: `${input.qty} x ${input.price} = ${input.total}` });"""},
    ],
  },
  cases: [
    [{price: 2, qty: 3}, {summary: "3 x 2 = 6"}],
    [{price: 1.5, qty: 2}, {summary: "2 x 1.5 = 3"}],
  ],
}

{
  name: "v2 function on one switch branch",
  graph: {
    nodes: [
      {switch: "route", when: ["useJs", ""]},
      {function: "js", source: """export const handler = async (input) => ({ via: 'js', v: input.v * 2 });"""},
      {expression: "expr", fields: {via: "'expr'", v: "v * 3"}},
    ],
    edges: ["input -> route", "route:0 -> js -> output", "route:1 -> expr -> output"],
  },
  cases: [
    [{useJs: true, v: 2}, {via: "js", v: 4}],
    [{useJs: false, v: 2}, {via: "expr", v: 6}],
    [{v: 1}, {via: "expr", v: 3}],
  ],
}

{
  name: "v2 a failing function on a branch that is not taken",
  graph: {
    nodes: [
      {switch: "route", when: ["safe", ""]},
      {expression: "ok", fields: {ok: "true"}},
      {function: "bad", source: """export const handler = async (input) => { throw new Error('should not run'); };"""},
    ],
    edges: ["input -> route", "route:0 -> ok -> output", "route:1 -> bad -> output"],
  },
  cases: [
    [{safe: true}, {ok: true}],
    [{safe: false}, "!error: should not run"],
  ],
}

{
  name: "v2 the same source in two nodes",
  graph: {
    nodes: [
      {function: "a", source: """export const handler = async (input) => ({ n: (input.n ?? 0) + 1 });"""},
      {function: "b", source: """export const handler = async (input) => ({ n: (input.n ?? 0) + 1 });"""},
    ],
  },
  cases: [
    [{n: 1}, {n: 3}],
    [{}, {n: 2}],
  ],
}

{
  name: "v2 module state starts fresh for every evaluation",
  graph: {
    nodes: [{function: "f", source: """let calls = 0;
export const handler = async (input) => { calls += 1; return { first: calls === 1 || input.ignore === true }; };"""}],
  },
  cases: [
    [{}, {first: true}],
    [{ignore: true}, {first: true}],
  ],
}

{
  name: "v2 globals defined by one evaluation are not seen by the next",
  graph: {
    nodes: [{function: "f", source: """export const handler = async (input) => {
  const before = typeof globalThis.__specLeak;
  globalThis.__specLeak = input.v;
  return { before };
};"""}],
  },
  cases: [
    [{v: 1}, {before: "undefined"}],
    [{v: 2}, {before: "undefined"}],
  ],
}

{
  name: "v2 zod is importable",
  graph: {
    nodes: [{function: "f", source: """import { z } from 'zod';
const Schema = z.object({ age: z.number().int().min(0) });
export const handler = async (input) => {
  const parsed = Schema.safeParse({ age: input.age });
  return { valid: parsed.success };
};"""}],
  },
  cases: [
    [{age: 3}, {valid: true}],
    [{age: -1}, {valid: false}],
    [{age: 1.5}, {valid: false}],
    [{age: "3"}, {valid: false}],
    [{}, {valid: false}],
  ],
}
