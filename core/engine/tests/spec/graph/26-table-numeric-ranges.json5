// --- Numbers that arrive as strings ----------------------------------------------------------

{
  name: "strings as numbers: numeric cells do not coerce string inputs",
  graph: {
    nodes: [
      {table: "t", hit: "collect", inputs: ["n"], outputs: ["r"], rules: [
        ["5", "'eq'"],
        ["> 1", "'gt'"],
        ["[1..10]", "'range'"],
        ["!= 5", "'ne'"],
        ["'5'", "'string five'"],
      ]},
    ],
  },
  cases: [
    [{n: 5}, [{r: "eq"}, {r: "gt"}, {r: "range"}]],
    [{n: "5"}, [{r: "ne"}, {r: "string five"}]],
    [{n: "5.0"}, [{r: "ne"}]],
    [{n: " 5"}, [{r: "ne"}]],
    [{n: "abc"}, [{r: "ne"}]],
  ],
}

{
  name: "strings as numbers: number() in the input field converts before matching",
  graph: {
    nodes: [
      {table: "t", inputs: ["number(n)"], outputs: ["r"], rules: [
        ["< 0", "'negative'"],
        ["[0..100]", "'percent'"],
        ["> 100", "'over'"],
        ["", "'not a number'"],
      ]},
    ],
  },
  cases: [
    [{n: "50"}, {r: "percent"}],
    [{n: "-1.5"}, {r: "negative"}],
    [{n: "100.0"}, {r: "percent"}],
    [{n: "100.01"}, {r: "over"}],
    [{n: 7}, {r: "percent"}],
    [{n: "x"}, {r: "not a number"}],
    [{n: null}, {r: "not a number"}],
  ],
}

{
  name: "strings as numbers: indexed point cells do not match numeric strings",
  graph: {
    nodes: [
      {table: "t", inputs: ["n"], outputs: ["r"], rules: [
        ["1", "'n1'"],
        ["2", "'n2'"],
        ["3", "'n3'"],
        ["4", "'n4'"],
        ["'1'", "'s1'"],
        ["'2'", "'s2'"],
        ["'3'", "'s3'"],
        ["'4'", "'s4'"],
        ["", "'none'"],
      ]},
    ],
  },
  cases: [
    [{n: 1}, {r: "n1"}],
    [{n: "1"}, {r: "s1"}],
    [{n: 4}, {r: "n4"}],
    [{n: "4"}, {r: "s4"}],
    [{n: "4.0"}, {r: "none"}],
    [{n: 4.0}, {r: "n4"}],
    [{n: true}, {r: "none"}],
  ],
}

// --- Wrong types, null and missing against numeric cells ----------------------------------

{
  name: "types: non-numeric values fall through numeric bands to the catch-all",
  graph: {
    nodes: [
      {table: "t", inputs: ["n"], outputs: ["r"], rules: [
        ["< 0", "'negative'"],
        ["[0..10]", "'small'"],
        ["> 10", "'large'"],
        ["", "'not a number'"],
      ]},
    ],
  },
  cases: [
    [{n: 3}, {r: "small"}],
    [{n: null}, {r: "not a number"}],
    [{}, {r: "not a number"}],
    [{n: true}, {r: "not a number"}],
    [{n: [3]}, {r: "not a number"}],
    [{n: {v: 3}}, {r: "not a number"}],
    [{n: "3"}, {r: "not a number"}],
  ],
}

{
  name: "types: a numeric band on a nested dotted field with missing parents",
  graph: {
    nodes: [
      {table: "t", inputs: ["order.totals.net"], outputs: ["tier"], rules: [
        ["[0..100)", "'small'"],
        ["[100..1000)", "'medium'"],
        [">= 1000", "'large'"],
      ]},
    ],
  },
  cases: [
    [{order: {totals: {net: 99.99}}}, {tier: "small"}],
    [{order: {totals: {net: 100}}}, {tier: "medium"}],
    [{order: {totals: {net: 1000}}}, {tier: "large"}],
    [{order: {totals: {}}}, {}],
    [{order: {}}, {}],
    [{}, {}],
  ],
}

// --- Interactions with other nodes ----------------------------------------------------------

{
  name: "with nodes: bands applied to a value computed upstream",
  graph: {
    nodes: [
      {expression: "bmi", passThrough: true, fields: {bmi: "round(weight / (height * height) * 10) / 10"}},
      {table: "class", passThrough: true, inputs: ["bmi"], outputs: ["category"], rules: [
        ["< 18.5", "'underweight'"],
        ["[18.5..25)", "'normal'"],
        ["[25..30)", "'overweight'"],
        [">= 30", "'obese'"],
      ]},
    ],
  },
  cases: [
    [{weight: 70, height: 1.75}, {weight: 70, height: 1.75, bmi: 22.9, category: "normal"}],
    [{weight: 50, height: 1.75}, {weight: 50, height: 1.75, bmi: 16.3, category: "underweight"}],
    [{weight: 92, height: 1.75}, {weight: 92, height: 1.75, bmi: 30, category: "obese"}],
    [{weight: 76.5625, height: 1.75}, {weight: 76.5625, height: 1.75, bmi: 25, category: "overweight"}],
  ],
}

{
  name: "with nodes: bands per element in loop mode",
  graph: {
    nodes: [
      {table: "t", executionMode: "loop", inputField: "items", outputPath: "grades", inputs: ["score"], outputs: ["grade"], rules: [
        [">= 90", "'A'"],
        ["[75..90)", "'B'"],
        ["", "'C'"],
      ]},
    ],
  },
  cases: [
    [{items: [{score: 95}, {score: 75}, {score: 74.99}]}, {grades: [{grade: "A"}, {grade: "B"}, {grade: "C"}]}],
    [{items: [{score: 90}, {}]}, {grades: [{grade: "A"}, {grade: "C"}]}],
    [{items: []}, {grades: []}],
  ],
}

{
  name: "with nodes: tiered tax brackets feed an expression",
  graph: {
    nodes: [
      {table: "bracket", passThrough: true, inputs: ["income"], outputs: ["rate", "base", "floor"], rules: [
        ["[0..10000]", "0", "0", "0"],
        ["(10000..40000]", "0.1", "0", "10000"],
        ["(40000..90000]", "0.2", "3000", "40000"],
        ["> 90000", "0.35", "13000", "90000"],
      ]},
      {expression: "tax", fields: {tax: "base + (income - floor) * rate"}},
    ],
  },
  cases: [
    [{income: 5000}, {tax: 0}],
    [{income: 10000}, {tax: 0}],
    [{income: 10001}, {tax: 0.1}],
    [{income: 40000}, {tax: 3000}],
    [{income: 90000}, {tax: 13000}],
    [{income: 100000}, {tax: 16500}],
  ],
}
