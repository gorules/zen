        ["3, 4", "< 5", "9"],
        ["3, 4", ">= 5", "20"],
        ["", "", "99"],
      ]},
    ],
  },
  cases: [
    [{zone: 1, weight: 0.5}, {price: 5}],
    [{zone: 1, weight: 1}, {price: 8}],
    [{zone: 1, weight: 10}, {price: 12}],
    [{zone: 2, weight: 9.99}, {price: 10}],
    [{zone: 2, weight: 10}, {price: 15}],
    [{zone: 3, weight: 4.999}, {price: 9}],
    [{zone: 4, weight: 5}, {price: 20}],
    [{zone: 5, weight: 1}, {price: 99}],
    [{zone: 1}, {price: 99}],
    [{zone: "1", weight: 1}, {price: 99}],
  ],
}

{
