{
  name: "interleaved: literal and expression cells mixed in one collect column",
  graph: {
    nodes: [
      {table: "t", hit: "collect", inputs: ["tier"], outputs: ["r"], rules: [
        ["'gold'", "'g1'"],
        ["startsWith($, 'go')", "'prefix'"],
        ["'gold'", "'g2'"],
        ["len($) == 6", "'six'"],
        ["'silver'", "'s1'"],
        ["$ == other", "'same-as-other'"],
        ["'bronze'", "'b1'"],
        ["contains(allowed, $)", "'allowed'"],
        ["'iron'", "'i1'"],
        ["", "'none'"],
      ]},
    ],
  },
  cases: [
    [{tier: "gold"}, [{r: "g1"}, {r: "prefix"}, {r: "g2"}, {r: "none"}]],
    [{tier: "goal"}, [{r: "prefix"}, {r: "none"}]],
    [{tier: "silver"}, [{r: "six"}, {r: "s1"}, {r: "none"}]],
    [{tier: "bronze", other: "bronze"}, [{r: "six"}, {r: "same-as-other"}, {r: "b1"}, {r: "none"}]],
    [{tier: "iron", allowed: ["iron", "tin"]}, [{r: "allowed"}, {r: "i1"}, {r: "none"}]],
    [{tier: "tin", allowed: ["iron", "tin"]}, [{r: "allowed"}, {r: "none"}]],
    [{tier: null, other: null}, [{r: "same-as-other"}, {r: "none"}]],
  ],
}

