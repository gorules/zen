    [{n: 7}, {r: "in-array"}],
    [{n: 8}, {r: "in-array"}],
    [{n: 9}, {r: "closed-point"}],
    [{n: -10}, {r: "negative"}],
    [{n: 10}, {r: "fallback"}],
    [{n: 11}, {r: "parenthesized"}],
    [{n: 12}, {r: "and-point"}],
    [{n: 13}, {r: "fallback"}],
    [{n: 14}, {r: "range"}],
    [{n: 15}, {r: "range"}],
    [{n: 15.5}, {r: "range"}],
    [{n: 16}, {r: "range"}],
    [{n: 1.5}, {r: "decimal"}],
    [{n: 17}, {r: "fallback"}],
    [{n: "1"}, {r: "fallback"}],
    [{n: null}, {r: "fallback"}],
  ],
}

{
  name: "index forms: boolean cells in a collect table",
  graph: {
    nodes: [
      {table: "t", hit: "collect", inputs: ["b"], outputs: ["r"], rules: [
        ["true", "'t1'"],
        ["false", "'f1'"],
        ["true, false", "'either'"],
        ["in [true]", "'t-in'"],
        ["$ == false", "'f-dollar'"],
        ["", "'x1'"],
        ["", "'x2'"],
        ["", "'x3'"],
      ]},
    ],
  },
  cases: [
    [{b: true}, [{r: "t1"}, {r: "either"}, {r: "t-in"}, {r: "x1"}, {r: "x2"}, {r: "x3"}]],
    [{b: false}, [{r: "f1"}, {r: "either"}, {r: "f-dollar"}, {r: "x1"}, {r: "x2"}, {r: "x3"}]],
    [{b: "true"}, [{r: "x1"}, {r: "x2"}, {r: "x3"}]],
    [{b: 1}, [{r: "x1"}, {r: "x2"}, {r: "x3"}]],
    [{b: null}, [{r: "x1"}, {r: "x2"}, {r: "x3"}]],
    [{}, [{r: "x1"}, {r: "x2"}, {r: "x3"}]],
  ],
}

