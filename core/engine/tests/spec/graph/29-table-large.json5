// --- Cell forms the index recognises -------------------------------------------------------
// Every recognised equality form must behave exactly like the same cell evaluated directly, and
// forms the index does not recognise must still be evaluated in their position.

{
  name: "index forms: string equality written every supported way",
  graph: {
    nodes: [
      {table: "t", inputs: ["s"], outputs: ["r"], rules: [
        ["'a'", "'plain'"],
        ["== 'b'", "'eq-op'"],
        ["$ == 'c'", "'dollar-left'"],
        ["'d' == $", "'dollar-right'"],
        ["'e', 'f'", "'list'"],
        ["in ['g', 'h']", "'in-array'"],
        ["$ in ['i']", "'dollar-in'"],
        ["\"j\"", "'double-quoted'"],
        ["('k')", "'parenthesized'"],
        ["$ == 'l' or $ == 'm'", "'or'"],
        ["not in ['a', 'b', 'c', 'd', 'e', 'f', 'g', 'h', 'i', 'j', 'k', 'l', 'm', 'z']", "'not-in'"],
        ["", "'fallback'"],
      ]},
    ],
  },
  cases: [
    [{s: "a"}, {r: "plain"}],
    [{s: "b"}, {r: "eq-op"}],
    [{s: "c"}, {r: "dollar-left"}],
    [{s: "d"}, {r: "dollar-right"}],
    [{s: "e"}, {r: "list"}],
    [{s: "f"}, {r: "list"}],
    [{s: "g"}, {r: "in-array"}],
    [{s: "h"}, {r: "in-array"}],
    [{s: "i"}, {r: "dollar-in"}],
    [{s: "j"}, {r: "double-quoted"}],
    [{s: "k"}, {r: "parenthesized"}],
    [{s: "l"}, {r: "or"}],
    [{s: "m"}, {r: "or"}],
    [{s: "n"}, {r: "not-in"}],
    [{s: "z"}, {r: "fallback"}],
    [{s: null}, {r: "not-in"}],
    [{}, {r: "not-in"}],
    [{s: 1}, {r: "not-in"}],
  ],
}

{
  name: "index forms: numeric equality, lists, point intervals and ranges",
  graph: {
    nodes: [
      {table: "t", inputs: ["n"], outputs: ["r"], rules: [
        ["1", "'plain'"],
        ["== 2", "'eq-op'"],
        ["$ == 3", "'dollar'"],
        ["4 == $", "'dollar-right'"],
        ["5, 6", "'list'"],
        ["in [7, 8]", "'in-array'"],
        ["[9..9]", "'closed-point'"],
        ["-10", "'negative'"],
        ["(11)", "'parenthesized'"],
        [">= 12 and <= 12", "'and-point'"],
        ["(13..13)", "'empty-open'"],
        ["[14..16]", "'range'"],
        ["1.50", "'decimal'"],
        ["", "'fallback'"],
      ]},
    ],
  },
  cases: [
    [{n: 1}, {r: "plain"}],
    [{n: 2}, {r: "eq-op"}],
