        ["< 25", "'urban'", "false", "base * 1.6 * 1.2 * 1", "'young/urban/false'"],
        ["< 25", "'rural'", "true", "base * 1.6 * 0.9 * 1.5", "'young/rural/true'"],
        ["< 25", "'rural'", "false", "base * 1.6 * 0.9 * 1", "'young/rural/false'"],
        ["[25..60)", "'urban'", "true", "base * 1 * 1.2 * 1.5", "'adult/urban/true'"],
        ["[25..60)", "'urban'", "false", "base * 1 * 1.2 * 1", "'adult/urban/false'"],
        ["[25..60)", "'rural'", "true", "base * 1 * 0.9 * 1.5", "'adult/rural/true'"],
        ["[25..60)", "'rural'", "false", "base * 1 * 0.9 * 1", "'adult/rural/false'"],
        [">= 60", "'urban'", "true", "base * 1.3 * 1.2 * 1.5", "'senior/urban/true'"],
        [">= 60", "'urban'", "false", "base * 1.3 * 1.2 * 1", "'senior/urban/false'"],
        [">= 60", "'rural'", "true", "base * 1.3 * 0.9 * 1.5", "'senior/rural/true'"],
        [">= 60", "'rural'", "false", "base * 1.3 * 0.9 * 1", "'senior/rural/false'"],
        ["", "", "", "null", "'unrated'"],
      ]},
    ],
  },
  cases: [
    [{age: 20, region: "urban", smoker: true, base: 100}, {premium: 288.000, rated: "young/urban/true"}],
    [{age: 30, region: "rural", smoker: false, base: 100}, {premium: 90.0, rated: "adult/rural/false"}],
    [{age: 60, region: "urban", smoker: false, base: 100}, {premium: 156.00, rated: "senior/urban/false"}],
    [{age: 59, region: "rural", smoker: true, base: 100}, {premium: 135.00, rated: "adult/rural/true"}],
    [{age: 24, region: "rural", smoker: false, base: 100}, {premium: 144.00, rated: "young/rural/false"}],
    [{age: 30, region: "suburb", smoker: false, base: 100}, {rated: "unrated"}],
