{
  name: "sub-decision with a table over 50 generated items, aggregated downstream",
  decisions: {
    band: {nodes: [{table: "t", inputs: ["n"], outputs: ["band"], rules: [
      ["< 10", "'low'"],
      ["[10..39]", "'mid'"],
      ["", "'high'"],
    ]}]},
  },
  graph: {
    nodes: [
      {decision: "bands", key: "band", inputField: "map([0..49], {n: #})", outputPath: "bands", executionMode: "loop"},
      {expression: "agg", fields: {
        n: "len(bands)",
        low: "len(filter(bands, #.band == 'low'))",
        mid: "len(filter(bands, #.band == 'mid'))",
        high: "len(filter(bands, #.band == 'high'))",
        last: "bands[49].band",
      }},
    ],
  },
  cases: [
    [{}, {n: 50, low: 10, mid: 30, high: 10, last: "high"}],
    [{n: 1000}, {n: 50, low: 10, mid: 30, high: 10, last: "high"}],
  ],
}
