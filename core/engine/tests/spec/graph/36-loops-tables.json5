      {table: "many", inputField: "payload", outputPath: "out", executionMode: "loop", inputs: ["v"], outputs: ["r"], rules: [["> 0", "'pos'"], ["", "'neg'"]]},
      {table: "one", inputField: "payload", outputPath: "out", inputs: ["v"], outputs: ["r"], rules: [["> 0", "'pos'"], ["", "'neg'"]]},
