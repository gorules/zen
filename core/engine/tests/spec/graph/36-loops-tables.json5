// Decision tables in loop mode: the table is evaluated once per item of the selected array. A
// first-hit table yields the matched row's outputs per item (null when nothing matches), a
// collect table yields an array of matched rows per item. Chapter 13 covers the basics; this
// chapter covers outputPath/passThrough combinations, non-matching and incomplete items, large
// arrays and tables reading `$root`/`$nodes` inside a loop.

// --- First hit: outputPath and passThrough ------------------------------------------------------
{
  name: "first-hit loop without outputPath outputs the bare array",
  graph: {
    nodes: [{table: "t", inputField: "items", executionMode: "loop", inputs: ["v"], outputs: ["size"], rules: [
      ["> 100", "'large'"],
      ["> 10", "'medium'"],
      ["", "'small'"],
    ]}],
  },
  cases: [
    [{items: [{v: 500}, {v: 50}, {v: 5}]}, [{size: "large"}, {size: "medium"}, {size: "small"}]],
    [{items: [{v: 11}]}, [{size: "medium"}]],
    [{items: []}, []],
    [{items: [{v: 100}, {v: 10}]}, [{size: "medium"}, {size: "small"}]],
  ],
}

{
  name: "first-hit loop with dotted outputs builds nested objects per item",
  graph: {
    nodes: [{table: "t", inputField: "items", outputPath: "out", executionMode: "loop", inputs: ["v"], outputs: ["r.size", "r.code", "flag"], rules: [
      ["> 10", "'big'", "2", "true"],
      ["", "'small'", "1", "false"],
    ]}],
  },
  cases: [
    [{items: [{v: 20}, {v: 1}]}, {out: [{r: {size: "big", code: 2}, flag: true}, {r: {size: "small", code: 1}, flag: false}]}],
    [{items: [{v: 10}]}, {out: [{r: {size: "small", code: 1}, flag: false}]}],
  ],
}

{
  name: "first-hit loop with passThrough and no outputPath",
  graph: {
    nodes: [{table: "t", inputField: "items", executionMode: "loop", passThrough: true, inputs: ["v"], outputs: ["size"], rules: [
      ["> 10", "'big'"],
      ["", "'small'"],
    ]}],
  },
  cases: [
    [{batch: 1, items: [{v: 20}, {v: 1}]}, [{v: 20, size: "big"}, {v: 1, size: "small"}], "question: the node input merged with the result array yields the array itself, the outer input is dropped (as for expression loops in chapter 13)"],
    [{items: []}, [], "question: the node input merged with the result array yields the array itself, the outer input is dropped (as for expression loops in chapter 13)"],
  ],
}

{
  name: "first-hit loop with passThrough writes back over the source array",
  graph: {
    nodes: [{table: "t", inputField: "order.lines", outputPath: "order.lines", executionMode: "loop", passThrough: true, inputs: ["kind"], outputs: ["vat"], rules: [
      ["'food'", "0.05"],
      ["", "0.2"],
    ]}],
  },
  cases: [
    [
      {order: {id: 9, lines: [{kind: "food", amt: 10}, {kind: "tv", amt: 100}]}},
      {order: {id: 9, lines: [{kind: "food", amt: 10, vat: 0.05}, {kind: "tv", amt: 100, vat: 0.2}]}},
    ],
    [{order: {id: 1, lines: []}}, {order: {id: 1, lines: []}}],
    [{order: {id: 2, lines: [{}]}, x: true}, {order: {id: 2, lines: [{vat: 0.2}]}, x: true}],
  ],
}

{
  name: "first-hit loop with passThrough to a sibling path keeps the source untouched",
  graph: {
    nodes: [{table: "t", inputField: "lines", outputPath: "rated", executionMode: "loop", passThrough: true, inputs: ["kind"], outputs: ["vat"], rules: [
      ["'food'", "0.05"],
      ["", "0.2"],
    ]}],
  },
  cases: [
    [{lines: [{kind: "food"}]}, {lines: [{kind: "food"}], rated: [{kind: "food", vat: 0.05}]}],
    [{lines: [{kind: "x", vat: 1}]}, {lines: [{kind: "x", vat: 1}], rated: [{kind: "x", vat: 0.2}]}],
    [{lines: [], rated: "old"}, {lines: [], rated: []}],
  ],
}

{
  name: "table result overrides item fields of the same name under passThrough",
  graph: {
    nodes: [{table: "t", inputField: "items", outputPath: "items", executionMode: "loop", passThrough: true, inputs: ["status"], outputs: ["status", "meta.mapped"], rules: [
      ["'a'", "'active'", "true"],
      ["", "status", "false"],
    ]}],
  },
  cases: [
    [{items: [{status: "a", meta: {id: 1}}, {status: "z"}]}, {items: [{status: "active", meta: {id: 1, mapped: true}}, {status: "z", meta: {mapped: false}}]}],
    [{items: [{status: "a"}]}, {items: [{status: "active", meta: {mapped: true}}]}],
  ],
}

// --- Items failing to match -----------------------------------------------------------------------
// A first-hit table that matches nothing outputs null for that item.
{
  name: "first-hit loop: non-matching items yield null without outputPath",
  graph: {
    nodes: [{table: "t", inputField: "items", executionMode: "loop", inputs: ["v"], outputs: ["ok"], rules: [
      ["> 0", "true"],
    ]}],
  },
  cases: [
    [{items: [{v: 1}, {v: -1}]}, [{ok: true}, null]],
    [{items: [{v: -1}, {v: -2}]}, [null, null]],
    [{items: [{v: 3}]}, [{ok: true}]],
  ],
}

{
  name: "first-hit loop with passThrough: a non-matching item stays as it was",
  graph: {
    nodes: [{table: "t", inputField: "items", outputPath: "items", executionMode: "loop", passThrough: true, inputs: ["v"], outputs: ["ok"], rules: [
      ["> 0", "true"],
    ]}],
  },
  cases: [
    [{items: [{v: 1}, {v: -1}]}, {items: [{v: 1, ok: true}, {v: -1}]}],
    [{items: [{v: -5, ok: false}]}, {items: [{v: -5, ok: false}]}],
    [{items: [{}]}, {items: [{}]}],
  ],
}

{
  name: "first-hit loop: all items failing yields an array of nulls under outputPath",
  graph: {
    nodes: [{table: "t", inputField: "items", outputPath: "out", executionMode: "loop", inputs: ["kind"], outputs: ["r"], rules: [
      ["'a'", "1"],
      ["'b'", "2"],
    ]}],
  },
  cases: [
    [{items: [{kind: "c"}, {kind: "d"}]}, {out: [null, null]}, "question: a non-matching first-hit table outputs null; in a loop the null lands in the result array (chapter 13)"],
    [{items: [{kind: "a"}, {kind: "c"}, {kind: "b"}]}, {out: [{r: 1}, null, {r: 2}]}, "question: a non-matching first-hit table outputs null; in a loop the null lands in the result array (chapter 13)"],
    [{items: [{kind: "b"}]}, {out: [{r: 2}]}],
  ],
}

{
  name: "downstream nodes count non-matching loop items",
  graph: {
    nodes: [
      {table: "t", inputField: "items", outputPath: "hits", executionMode: "loop", inputs: ["v"], outputs: ["v"], rules: [
        [">= 10", "v"],
      ]},
      {expression: "agg", fields: {matched: "len(filter(hits, # != null))", missed: "len(filter(hits, # == null))", total: "sum(map(filter(hits, # != null), #.v))"}},
    ],
  },
  cases: [
    [{items: [{v: 10}, {v: 1}, {v: 20}]}, {matched: 2, missed: 1, total: 30}],
    [{items: [{v: 1}]}, {matched: 0, missed: 1, total: 0}],
    [{items: []}, {matched: 0, missed: 0, total: 0}],
  ],
}

{
  name: "an output cell error skips the row for that item only",
  graph: {
    nodes: [{table: "t", inputField: "items", outputPath: "out", executionMode: "loop", inputs: [""], outputs: ["r"], rules: [
      ["", "a + 1"],
      ["", "'fallback'"],
    ]}],
  },
  cases: [
    [{items: [{a: 1}, {a: "x"}, {a: 2}]}, {out: [{r: 2}, {r: "fallback"}, {r: 3}]}],
    [{items: [{a: "y"}]}, {out: [{r: "fallback"}]}],
  ],
}

// --- Collect hit policy in loops ----------------------------------------------------------------
{
  name: "collect loop without outputPath outputs an array of arrays",
  graph: {
    nodes: [{table: "t", hit: "collect", inputField: "items", executionMode: "loop", inputs: ["v"], outputs: ["tag"], rules: [
      ["> 0", "'pos'"],
      ["> 100", "'huge'"],
      ["== 0", "'zero'"],
    ]}],
  },
  cases: [
    [{items: [{v: 500}, {v: 0}, {v: -1}]}, [[{tag: "pos"}, {tag: "huge"}], [{tag: "zero"}], []]],
    [{items: [{v: -1}, {v: -2}]}, [[], []]],
    [{items: []}, []],
  ],
}

{
  name: "collect loop with passThrough replaces each item by its rows",
  graph: {
    nodes: [{table: "t", hit: "collect", inputField: "items", outputPath: "items", executionMode: "loop", passThrough: true, inputs: ["v"], outputs: ["tag"], rules: [
      ["> 0", "'pos'"],
      ["> 10", "'big'"],
    ]}],
  },
  cases: [
    [{id: 1, items: [{v: 20}, {v: -1}]}, {id: 1, items: [[{tag: "pos"}, {tag: "big"}], []]}, "question: passThrough merges each item with an array, and a top-level array replaces the item, so the item fields are lost"],
    [{id: 2, items: []}, {id: 2, items: []}],
  ],
}

{
  name: "collect loop rows read item fields in output cells",
  graph: {
    nodes: [{table: "t", hit: "collect", inputField: "orders", outputPath: "alerts", executionMode: "loop", inputs: ["amount", "country"], outputs: ["code", "msg"], rules: [
      ["> 1000", "", "'AMT'", "'amount ' + string(amount)"],
      ["", "'XX'", "'CTY'", "'country ' + country"],
      ["> 1000", "'XX'", "'BOTH'", "id"],
    ]}],
  },
  cases: [
    [
      {orders: [{id: "o1", amount: 5000, country: "XX"}, {id: "o2", amount: 10, country: "DE"}, {id: "o3", amount: 2000, country: "DE"}]},
      {alerts: [
        [{code: "AMT", msg: "amount 5000"}, {code: "CTY", msg: "country XX"}, {code: "BOTH", msg: "o1"}],
        [],
        [{code: "AMT", msg: "amount 2000"}],
      ]},
    ],
    [{orders: [{id: "o4", amount: 1, country: "XX"}]}, {alerts: [[{code: "CTY", msg: "country XX"}]]}],
  ],
}

{
  name: "collect loop flattened downstream",
  graph: {
    nodes: [
      {table: "t", hit: "collect", inputField: "items", outputPath: "tags", executionMode: "loop", inputs: ["v"], outputs: ["tag"], rules: [
        ["> 0", "'pos'"],
        ["> 10", "'big'"],
        ["", "'seen'"],
      ]},
      {expression: "agg", fields: {all: "map(flatten(tags), #.tag)", perItem: "map(tags, len(#))"}},
    ],
  },
  cases: [
    [{items: [{v: 20}, {v: 1}, {v: -1}]}, {all: ["pos", "big", "seen", "pos", "seen", "seen"], perItem: [3, 2, 1]}],
    [{items: []}, {all: [], perItem: []}],
  ],
}

{
  name: "first-hit loop with per-column collect outputs",
  graph: {
    nodes: [{table: "t", inputField: "items", outputPath: "out", executionMode: "loop", inputs: ["v"], outputs: ["tier", "reasons[]"], rules: [
      ["> 100", "'gold'", "'over 100'"],
      ["> 10", "'silver'", "'over 10'"],
      ["> 0", "'bronze'", "'positive'"],
    ]}],
  },
  cases: [
    [{items: [{v: 500}, {v: 50}, {v: 5}]}, {out: [
      {tier: "gold", reasons: ["over 100", "over 10", "positive"]},
      {tier: "silver", reasons: ["over 10", "positive"]},
      {tier: "bronze", reasons: ["positive"]},
    ]}],
    [{items: [{v: 0}, {v: 1}]}, {out: [null, {tier: "bronze", reasons: ["positive"]}]}],
    [{items: []}, {out: []}],
  ],
}

{
  name: "per-column collect loop with passThrough keeps item fields",
  graph: {
    nodes: [{table: "t", inputField: "items", outputPath: "items", executionMode: "loop", passThrough: true, inputs: ["v"], outputs: ["flags[]"], rules: [
      ["> 0", "'pos'"],
      ["> 10", "'big'"],
    ]}],
  },
  cases: [
    [{items: [{id: 1, v: 20}, {id: 2, v: -1}]}, {items: [{id: 1, v: 20, flags: ["pos", "big"]}, {id: 2, v: -1}]}],
    [{items: [{id: 3, v: 5, flags: ["old"]}]}, {items: [{id: 3, v: 5, flags: ["pos"]}]}],
  ],
}

// --- Items with missing fields --------------------------------------------------------------------
// A missing input field reads as null; null fails comparisons and matches only empty cells,
// `null` cells or null-aware tests.
{
  name: "missing input fields fall through to the catch-all row",
  graph: {
    nodes: [{table: "t", inputField: "items", outputPath: "out", executionMode: "loop", inputs: ["age", "country"], outputs: ["r"], rules: [
      [">= 18", "'US'", "'us-adult'"],
      [">= 18", "", "'adult'"],
      ["", "'US'", "'us'"],
      ["", "", "'other'"],
    ]}],
  },
  cases: [
    [{items: [{age: 20, country: "US"}, {age: 20}, {country: "US"}, {}]}, {out: [{r: "us-adult"}, {r: "adult"}, {r: "us"}, {r: "other"}]}],
    [{items: [{age: null, country: null}]}, {out: [{r: "other"}]}],
    [{items: [{age: "20", country: "US"}]}, {out: [{r: "us"}]}],
  ],
}

{
  name: "null-aware cells match missing fields per item",
  graph: {
    nodes: [{table: "t", inputField: "items", outputPath: "out", executionMode: "loop", inputs: ["email"], outputs: ["state"], rules: [
      ["null", "'missing'"],
      ["$ == ''", "'empty'"],
      ["", "'present'"],
    ]}],
  },
  cases: [
    [{items: [{}, {email: null}, {email: ""}, {email: "a@b"}]}, {out: [{state: "missing"}, {state: "missing"}, {state: "empty"}, {state: "present"}]}],
    [{items: [{email: "x"}]}, {out: [{state: "present"}]}],
  ],
}

{
  name: "nested input fields missing on some items",
  graph: {
    nodes: [{table: "t", inputField: "items", outputPath: "out", executionMode: "loop", inputs: ["customer.address.country"], outputs: ["zone"], rules: [
      ["'NO', 'SE', 'DK'", "'nordic'"],
      ["", "'world'"],
    ]}],
  },
  cases: [
    [{items: [{customer: {address: {country: "NO"}}}, {customer: {address: {}}}, {customer: {}}, {}, {customer: null}]}, {out: [{zone: "nordic"}, {zone: "world"}, {zone: "world"}, {zone: "world"}, {zone: "world"}]}],
    [{items: [{customer: {address: {country: "SE"}}}]}, {out: [{zone: "nordic"}]}],
  ],
}

{
  name: "output cells reading missing fields produce null in the item result",
  graph: {
    nodes: [{table: "t", inputField: "items", outputPath: "out", executionMode: "loop", inputs: [""], outputs: ["name", "label"], rules: [
      ["", "name", "name ?? 'anon'"],
    ]}],
  },
  cases: [
    [{items: [{name: "a"}, {}]}, {out: [{name: "a", label: "a"}, {name: null, label: "anon"}]}],
    [{items: [{name: null}]}, {out: [{name: null, label: "anon"}]}],
  ],
}

{
  name: "items with wrong types fall through rather than erroring",
  graph: {
    nodes: [{table: "t", inputField: "items", outputPath: "out", executionMode: "loop", inputs: ["n"], outputs: ["r"], rules: [
      ["> 5", "'big'"],
      ["[1..5]", "'small'"],
      ["", "'unknown'"],
    ]}],
  },
  cases: [
    [{items: [{n: 10}, {n: 3}, {n: "10"}, {n: true}, {n: [1]}, {n: {}}]}, {out: [{r: "big"}, {r: "small"}, {r: "unknown"}, {r: "unknown"}, {r: "unknown"}, {r: "unknown"}]}],
    [{items: [{n: 5}, {n: 1}, {n: 0}]}, {out: [{r: "small"}, {r: "small"}, {r: "unknown"}]}],
  ],
}

{
  name: "scalar and null items against a field-reading table",
  graph: {
    nodes: [{table: "t", inputField: "items", outputPath: "out", executionMode: "loop", inputs: ["v"], outputs: ["r"], rules: [
      ["> 0", "'pos'"],
      ["", "'other'"],
    ]}],
  },
  cases: [
    [{items: [{v: 1}, null]}, {out: [{r: "pos"}, {r: "other"}]}],
    [{items: [{v: 1}, 5, "s"]}, {out: [{r: "pos"}, {r: "other"}, {r: "other"}]}],
  ],
}

// --- `$root` in table loops ----------------------------------------------------------------------
// In a loop the item is the table's whole environment, so `$root` is the item.
{
  name: "input column $root over string items",
  graph: {
    nodes: [{table: "t", inputField: "codes", outputPath: "out", executionMode: "loop", inputs: ["$root"], outputs: ["kind", "code"], rules: [
      ["startsWith($, 'A')", "'alpha'", "$root"],
      ["'Z9'", "'zed'", "$root"],
      ["", "'other'", "$root"],
    ]}],
  },
  cases: [
    [{codes: ["A1", "Z9", "B2"]}, {out: [{kind: "alpha", code: "A1"}, {kind: "zed", code: "Z9"}, {kind: "other", code: "B2"}]}],
    [{codes: [""]}, {out: [{kind: "other", code: ""}]}],
  ],
}

{
  name: "expression-only input column reads $root of object items",
  graph: {
    nodes: [{table: "t", inputField: "items", outputPath: "out", executionMode: "loop", inputs: [null], outputs: ["r"], rules: [
      ["$root.a > $root.b", "'a'"],
      ["$root.a < $root.b", "'b'"],
      ["", "'tie'"],
    ]}],
  },
  cases: [
    [{items: [{a: 2, b: 1}, {a: 1, b: 2}, {a: 1, b: 1}]}, {out: [{r: "a"}, {r: "b"}, {r: "tie"}]}],
    [{items: [{a: 1}]}, {out: [{r: "tie"}]}],
  ],
}

{
  name: "output cells copy the whole item through $root",
  graph: {
    nodes: [{table: "t", inputField: "items", outputPath: "out", executionMode: "loop", inputs: ["keep"], outputs: ["item"], rules: [
      ["true", "$root"],
      ["", "null"],
    ]}],
  },
  cases: [
    {input: {items: [{keep: true, x: 1}, {keep: false, x: 2}]}, output: {out: [{item: {keep: true, x: 1}}, {item: null}]}, note: "bug: the input column's `$` reference is stored on the item environment, so $root read in an output cell carries a stray `$` key", engines: "the walker leaks the `$` reference into $root; the compiled engine gives the intended result"},
    {input: {items: [{keep: true}]}, output: {out: [{item: {keep: true}}]}, note: "bug: the input column's `$` reference is stored on the item environment, so $root read in an output cell carries a stray `$` key", engines: "the walker leaks the `$` reference into $root; the compiled engine gives the intended result"},
  ],
}

{
  name: "single-mode sibling: output cells copy the node input through $root",
  graph: {
    nodes: [{table: "t", inputField: "item", outputPath: "out", inputs: ["keep"], outputs: ["item"], rules: [
      ["true", "$root"],
      ["", "null"],
    ]}],
  },
  cases: [
    {input: {item: {keep: true, x: 1}}, output: {out: {item: {keep: true, x: 1}}}, note: "bug: the input column's `$` reference is stored on the environment, so $root read in an output cell carries a stray `$` key (not loop-specific)", engines: "the walker leaks the `$` reference into $root; the compiled engine gives the intended result"},
    [{item: {keep: false}}, {out: {item: null}}],
  ],
}

{
  name: "table loop over arrays of arrays reads rows via $root",
  graph: {
    nodes: [{table: "t", inputField: "rows", outputPath: "out", executionMode: "loop", inputs: ["len($root)"], outputs: ["shape", "head"], rules: [
      ["0", "'empty'", "null"],
      ["1", "'single'", "$root[0]"],
      ["", "'many'", "$root[0]"],
    ]}],
  },
  cases: [
    [{rows: [[], [7], [1, 2, 3]]}, {out: [{shape: "empty", head: null}, {shape: "single", head: 7}, {shape: "many", head: 1}]}],
    [{rows: [["a", "b"]]}, {out: [{shape: "many", head: "a"}]}],
  ],
}

// --- `$nodes` in table loops ---------------------------------------------------------------------
// The outer input and earlier nodes stay reachable through `$nodes` from every item.
{
  name: "input column compares item fields with an outer threshold",
  graph: {
    nodes: [{table: "t", inputField: "items", outputPath: "out", executionMode: "loop", inputs: ["v"], outputs: ["over"], rules: [
      ["> $nodes.input.limit", "true"],
      ["", "false"],
    ]}],
  },
  cases: [
    [{limit: 10, items: [{v: 5}, {v: 15}, {v: 10}]}, {out: [{over: false}, {over: true}, {over: false}]}],
    [{limit: 0, items: [{v: 1}]}, {out: [{over: true}]}],
    [{items: [{v: 1}]}, {out: [{over: false}]}],
  ],
}

{
  name: "input column field is a $nodes path",
  graph: {
    nodes: [{table: "t", inputField: "items", outputPath: "out", executionMode: "loop", inputs: ["$nodes.input.mode", "v"], outputs: ["r"], rules: [
      ["'strict'", "> 0", "'ok'"],
      ["'strict'", "", "'reject'"],
      ["", "", "'lenient'"],
    ]}],
  },
  cases: [
    [{mode: "strict", items: [{v: 1}, {v: 0}]}, {out: [{r: "ok"}, {r: "reject"}]}],
    [{mode: "loose", items: [{v: 1}, {v: 0}]}, {out: [{r: "lenient"}, {r: "lenient"}]}],
    [{items: [{v: 1}]}, {out: [{r: "lenient"}]}],
  ],
}

{
  name: "output cells combine the item with an earlier node",
  graph: {
    nodes: [
      {expression: "cfg", fields: {rate: "rate ?? 0.1", currency: "currency ?? 'EUR'"}},
      {table: "t", inputField: "$nodes.input.items", outputPath: "out", executionMode: "loop", inputs: ["taxable"], outputs: ["tax", "currency"], rules: [
        ["true", "amount * $nodes.cfg.rate", "$nodes.cfg.currency"],
        ["", "0", "$nodes.cfg.currency"],
      ]},
    ],
  },
  cases: [
    [{rate: 0.2, items: [{taxable: true, amount: 100}, {taxable: false, amount: 50}]}, {out: [{tax: 20, currency: "EUR"}, {tax: 0, currency: "EUR"}]}],
    [{currency: "NOK", items: [{taxable: true, amount: 10}]}, {out: [{tax: 1, currency: "NOK"}]}],
    [{items: []}, {out: []}],
  ],
}

{
  name: "collect loop with $nodes conditions",
  graph: {
    nodes: [{table: "t", hit: "collect", inputField: "items", outputPath: "out", executionMode: "loop", inputs: ["tags"], outputs: ["hit"], rules: [
      ["contains($, $nodes.input.watch[0])", "$nodes.input.watch[0]"],
      ["contains($, $nodes.input.watch[1])", "$nodes.input.watch[1]"],
    ]}],
  },
  cases: [
    [{watch: ["a", "b"], items: [{tags: ["a", "b"]}, {tags: ["b"]}, {tags: []}]}, {out: [[{hit: "a"}, {hit: "b"}], [{hit: "b"}], []]}],
    [{watch: ["x", "y"], items: [{tags: ["a"]}]}, {out: [[]]}],
  ],
}

{
  name: "table loop reads the previous loop's results through $nodes",
  graph: {
    nodes: [
      {expression: "scores", inputField: "items", outputPath: "scores", executionMode: "loop", fields: {s: "a + b"}},
      {table: "t", inputField: "$nodes.scores.scores", outputPath: "grades", executionMode: "loop", inputs: ["s"], outputs: ["g"], rules: [
        [">= 10", "'high'"],
        ["", "'low'"],
      ]},
    ],
  },
  cases: [
    [{items: [{a: 5, b: 5}, {a: 1, b: 1}]}, {grades: [{g: "high"}, {g: "low"}]}],
    [{items: []}, {grades: []}],
  ],
}

// --- Tables in loops combined with other nodes ----------------------------------------------------
{
  name: "an expression loop enriches items before a table loop",
  graph: {
    nodes: [
      {expression: "prep", inputField: "items", outputPath: "items", executionMode: "loop", passThrough: true, fields: {total: "price * qty"}},
      {table: "t", inputField: "items", outputPath: "items", executionMode: "loop", passThrough: true, inputs: ["total"], outputs: ["discount"], rules: [
        [">= 100", "0.1"],
        ["", "0"],
      ]},
    ],
  },
  cases: [
