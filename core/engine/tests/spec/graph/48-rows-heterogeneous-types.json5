{
  name: "lists of booleans with empty and missing rows",
  graph: {
    nodes: [{expression: "e", fields: {any: "some(flags ?? [], #)", n: "count(flags ?? [], #)", first: "(flags ?? [])[0]"}}],
  },
  cases: [
    [{flags: [true, false]}, {any: true, n: 1, first: true}],
    [{flags: [false, false]}, {any: false, n: 0, first: false}],
    [{flags: []}, {any: false, n: 0}],
    [{}, {any: false, n: 0}],
    [{flags: [false, false, true, true, true]}, {any: true, n: 3, first: false}],
    [{flags: [true]}, {any: true, n: 1, first: true}],
  ],
}

{
  name: "a list column copied out unchanged, next to a scalar column",
  graph: {
    nodes: [{expression: "e", passThrough: true, fields: {n: "len(xs)"}}],
  },
  cases: [
    [{xs: [1, 2], k: "a"}, {xs: [1, 2], k: "a", n: 2}],
    [{xs: [], k: "b"}, {xs: [], k: "b", n: 0}],
    [{xs: [0.5]}, {xs: [0.5], n: 1}],
    [{xs: [3, 3, 3], k: ""}, {xs: [3, 3, 3], k: "", n: 3}],
  ],
}

{
  name: "a list field that holds numbers in some rows and strings in others",
  graph: {
    nodes: [{expression: "e", fields: {t: "map(xs, type(#))", n: "len(xs)"}}],
  },
  cases: [
    [{xs: [1, 2]}, {t: ["number", "number"], n: 2}],
    [{xs: ["a"]}, {t: ["string"], n: 1}],
    [{xs: []}, {t: [], n: 0}],
    [{xs: [true]}, {t: ["bool"], n: 1}],
    [{xs: [1, "a"]}, {t: ["number", "string"], n: 2}],
  ],
}
