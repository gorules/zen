    [{v: -79228162514264337593543950335}, {zero: false, pos: false, s: -79228162514264337593543950335}],
    [{v: 1.5}, {zero: false, pos: true, s: 1.5}],
  ],
}

{
  name: "an output column whose type differs per rule, collected",
  graph: {
