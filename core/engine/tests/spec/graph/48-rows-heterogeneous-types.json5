{
  name: "string ordering mixed with number ordering in one field",
  graph: {
    nodes: [
      {table: "t", inputs: ["v"], outputs: ["r"], rules: [
        ["$ == 'm'", "'m'"],
        ["type($) == 'string' and $ < 'm'", "'before m'"],
        ["type($) == 'string' and $ > 'm'", "'after m'"],
        ["type($) == 'number' and $ < 0", "'negative'"],
        ["", "'rest'"],
      ]},
    ],
  },
  cases: [
    [{v: "a"}, {r: "rest"}, "question: strings have no ordering in the expression language, so the cell errors and the rule falls through"],
    [{v: "m"}, {r: "m"}],
    [{v: "z"}, {r: "rest"}, "question: strings have no ordering in the expression language, so the cell errors and the rule falls through"],
    [{v: "M"}, {r: "rest"}, "question: strings have no ordering in the expression language, so the cell errors and the rule falls through"],
    [{v: -1}, {r: "negative"}],
    [{v: 1}, {r: "rest"}],
    [{v: "ma"}, {r: "rest"}, "question: strings have no ordering in the expression language, so the cell errors and the rule falls through"],
    [{}, {r: "rest"}],
  ],
}

{
  name: "negative zero, tiny and huge decimals in one column",
