// --- Date strings in a text column --------------------------------------------------------

{
  name: "date comparisons on a text column with unparseable and absent rows",
  graph: {
    nodes: [
      {table: "t", inputs: ["since"], outputs: ["r"], rules: [
        ["d($) < d('2024-01-01')", "'old'"],
        ["d($) >= d('2024-01-01')", "'new'"],
        ["", "'unknown'"],
      ]},
    ],
  },
  cases: [
    [{since: "2023-06-01"}, {r: "old"}],
    [{since: "2024-01-01"}, {r: "new"}],
    [{since: "2025-03-20T10:00:00Z"}, {r: "new"}],
    [{since: "garbage"}, {r: "old"}, "question: an invalid or null date orders before every valid date instead of erroring (see the expression spec), so the cell matches"],
    [{since: ""}, {r: "old"}, "question: an invalid or null date orders before every valid date instead of erroring (see the expression spec), so the cell matches"],
    [{}, {r: "old"}, "question: an invalid or null date orders before every valid date instead of erroring (see the expression spec), so the cell matches"],
    [{since: "2023-12-31T23:59:59Z"}, {r: "old"}],
    [{since: 1700000000}, {r: "old"}],
  ],
}

// --- $nodes across rows that ran different nodes -------------------------------------------

{
  name: "$nodes of a branch that ran for some rows and not for others",
  graph: {
    nodes: [
      {switch: "s", when: ["n > 0", ""]},
      {expression: "pos", fields: {v: "n * 2"}},
      {expression: "neg", fields: {v: "'neg'"}},
      {expression: "join", fields: {fromPos: "$nodes.pos.v", fromNeg: "$nodes.neg.v", t: "type($nodes.pos)"}},
    ],
    edges: ["input -> s", "s:0 -> pos -> join", "s:1 -> neg -> join", "join -> output"],
  },
  cases: [
    [{n: 1}, {fromPos: 2, t: "object"}],
    [{n: -1}, {fromNeg: "neg", t: "null"}],
    [{n: 2.5}, {fromPos: 5, t: "object"}],
    [{}, {fromNeg: "neg", t: "null"}],
    [{n: 0}, {fromNeg: "neg", t: "null"}],
    [{n: "x"}, {fromNeg: "neg", t: "null"}],
    [{n: 100}, {fromPos: 200, t: "object"}],
  ],
}

{
  name: "collect switch: one key written with a different type by each taken branch",
  graph: {
    nodes: [
      {switch: "s", hit: "collect", when: ["a == true", "b == true"]},
      {expression: "ea", fields: {v: "1", fromA: "true"}},
      {expression: "eb", fields: {v: "'one'", fromB: "true"}},
    ],
    edges: ["input -> s", "s:0 -> ea -> output", "s:1 -> eb -> output"],
  },
  cases: [
    [{a: true}, {v: 1, fromA: true}],
    [{b: true}, {v: "one", fromB: true}],
    [{a: true, b: true}, {v: 1, fromA: true, fromB: true}],
    [{}, {}],
    [{a: false, b: true}, {v: "one", fromB: true}],
    [{a: true, b: false}, {v: 1, fromA: true}],
  ],
}

{
  name: "an expression field referencing earlier fields of varying type through $",
  graph: {
    nodes: [{expression: "e", fields: [
      ["k", "type(v) == 'number' ? v : len(string(v))"],
      ["d", "$.k * 2"],
      ["s", "string($.d) + ':' + type(v)"],
    ]}],
  },
  cases: [
    [{v: 3}, {k: 3, d: 6, s: "6:number"}],
    [{v: "abcd"}, {k: 4, d: 8, s: "8:string"}],
    [{v: true}, {k: 4, d: 8, s: "8:bool"}],
    [{}, {k: 4, d: 8, s: "8:null"}],
    [{v: 0.5}, {k: 0.5, d: 1, s: "1.0:number"}],
    [{v: ""}, {k: 0, d: 0, s: "0:string"}],
  ],
}

// --- Arrays of one element type with empty and missing rows --------------------------------
// When every present cell of a field is an array of strings, numbers or booleans, the list
// layout stores the elements in one shared child buffer with per-row offsets.

{
  name: "lists of strings: indexing, slicing and membership per row",
  graph: {
    nodes: [{expression: "e", fields: {
      first: "tags[0]",
      last: "len(tags) > 0 ? tags[len(tags) - 1] : null",
      rest: "tags[1:]",
      vip: "'vip' in tags",
      n: "len(tags)",
    }}],
  },
  cases: [
    [{tags: ["vip", "new"]}, {first: "vip", last: "new", rest: ["new"], vip: true, n: 2}],
    [{tags: ["a"]}, {first: "a", last: "a", rest: [], vip: false, n: 1}],
    [{tags: []}, {rest: [], vip: false, n: 0}, "bug: an open-ended slice of an empty array errors (implicit end len-1 is -1), as in the expression spec"],
    [{tags: ["", "vip", ""]}, {first: "", last: "", rest: ["vip", ""], vip: true, n: 3}],
    [{tags: ["żółw", "日本"]}, {first: "żółw", last: "日本", rest: ["日本"], vip: false, n: 2}],
    [{tags: ["x", "y", "z", "vip", "w"]}, {first: "x", last: "w", rest: ["y", "z", "vip", "w"], vip: true, n: 5}],
  ],
}

{
  name: "lists of strings, missing in some rows, through a collect table",
  graph: {
    nodes: [
      {table: "t", hit: "collect", inputs: ["tags"], outputs: ["r"], rules: [
        ["'vip' in $", "'vip'"],
        ["len($) == 0", "'empty'"],
        ["some($, startsWith(#, 'x'))", "'x-tag'"],
        ["", "'any'"],
      ]},
    ],
  },
  cases: [
    [{tags: ["vip"]}, [{r: "vip"}, {r: "any"}]],
    [{tags: []}, [{r: "empty"}, {r: "any"}]],
    [{tags: ["xa", "vip"]}, [{r: "vip"}, {r: "x-tag"}, {r: "any"}]],
    [{tags: ["b"]}, [{r: "any"}]],
    [{}, [{r: "any"}]],
    [{tags: ["x"]}, [{r: "x-tag"}, {r: "any"}]],
  ],
}

