    [{a: {k: "a"}, b: {k: "b"}, c: {k: "c"}, x: 0}, {k: "c"}],
    [{a: {k: "a"}, b: [1], c: {z: 1}, x: 0}, {z: 1}, "question: an array from a middle parent replaces the keys merged before it, so an object parent is lost even though the final winner is an object"],
    [{a: {k: "a"}, b: {z: 1}, c: [1], x: 0}, [1]],
