  },
  cases: [
    [{a: 1, b: 2, c: 3, x: 0}, {has: true, t: "number", v: 1}],
    [{a: null, b: 2, c: 3, x: 0}, {has: false, t: "null"}],
    [{b: 2, c: 3, x: 0}, {has: true, t: "number", v: 2}],
    [{b: null, c: 3, x: 0}, {has: false, t: "null"}],
    [{c: null, x: 0}, {has: true, t: "null"}],
    [{a: {p: 1}, b: {q: 2}, c: {r: 3}, x: 0}, {has: true, t: "object", v: {p: 1, q: 2, r: 3}}],
    [{a: {p: 1}, b: 5, c: {r: 3}, x: 0}, {has: true, t: "object", v: {p: 1}}],
    [{a: {p: null}, b: {p: 1, q: 2}, c: {r: 3}, x: 0}, {has: true, t: "object", v: {q: 2, r: 3}}],
    [{a: [1], b: {q: 2}, c: null, x: 0}, {has: true, t: "array", v: [1]}],
  ],
}

// --- passThrough at the join ----------------------------------------------------------------------
// A passThrough node merges its own output over its (already merged) input with the same rules.
// Without passThrough the node returns only its own fields.
{
  name: "passThrough join node over two parents",
  graph: {
    nodes: [
      {function: "a", source: """export const handler = async (input) => input.a;"""},
      {function: "b", source: """export const handler = async (input) => input.b;"""},
      {expression: "j", passThrough: true, fields: {tag: "'j'"}},
    ],
    edges: ["input -> a -> j", "input -> b -> j", "j -> output"],
  },
  cases: [
    [{a: {k: "a"}, b: {k: "b", y: 1}, x: 0}, {k: "a", tag: "j", y: 1}],
    [{a: {k: "a"}, b: [1], x: 0}, {k: "a", tag: "j"}],
    [{a: [1], b: {k: "b"}, x: 0}, {tag: "j"}, "question: passThrough over a merged input that is an array drops the array; only the node fields remain"],
    [{a: [1], b: [2], x: 0}, {tag: "j"}, "question: passThrough over a merged input that is an array drops the array; only the node fields remain"],
    [{a: 5, b: {k: "b"}, x: 0}, {k: "b", tag: "j"}],
    [{a: null, b: null, x: 0}, {tag: "j"}],
    [{b: {y: 1}, x: 0}, {tag: "j", y: 1}],
    [{a: {tag: "a"}, b: {tag: "b"}, x: 0}, {tag: "j"}],
    [{a: {k: null}, b: {k: "b"}, x: 0}, {tag: "j"}],
  ],
}

{
  name: "join node without passThrough over the same parents",
  graph: {
    nodes: [
      {function: "a", source: """export const handler = async (input) => input.a;"""},
      {function: "b", source: """export const handler = async (input) => input.b;"""},
      {expression: "j", fields: {tag: "'j'"}},
    ],
    edges: ["input -> a -> j", "input -> b -> j", "j -> output"],
  },
  cases: [
    [{a: {k: "a"}, b: {k: "b", y: 1}, x: 0}, {tag: "j"}],
    [{a: {k: "a"}, b: [1], x: 0}, {tag: "j"}],
    [{a: [1], b: {k: "b"}, x: 0}, {tag: "j"}],
    [{a: [1], b: [2], x: 0}, {tag: "j"}],
    [{a: 5, b: {k: "b"}, x: 0}, {tag: "j"}],
  ],
}

// Parents with passThrough: each parent carries the request, so the request keys meet
// themselves at the join and the parents' own keys conflict on top.
{
  name: "two passThrough parents at the output",
  graph: {
    nodes: [
      {expression: "a", passThrough: true, fields: {k: "a", fromA: "true"}},
      {expression: "b", passThrough: true, fields: {k: "b", fromB: "true"}},
    ],
    edges: ["input -> a -> output", "input -> b -> output"],
  },
  cases: [
    [{a: 1, b: 2, x: 0}, {a: 1, b: 2, fromA: true, fromB: true, k: 1, x: 0}],
    [{a: null, b: 2, x: 0}, {b: 2, fromA: true, fromB: true, k: 2, x: 0}],
    [{a: 1, b: null, x: 0}, {a: 1, fromA: true, fromB: true, k: 1, x: 0}],
    [{b: 2, k: "req", x: 0}, {b: 2, fromA: true, fromB: true, k: 2, x: 0}],
    [{k: "req", x: 0}, {fromA: true, fromB: true, x: 0}],
    [{a: {p: 1}, b: {q: 2}, x: 0}, {a: {p: 1}, b: {q: 2}, fromA: true, fromB: true, k: {p: 1, q: 2}, x: 0}],
    [{a: [1], b: {q: 2}, x: 0}, {a: [1], b: {q: 2}, fromA: true, fromB: true, k: [1], x: 0}],
  ],
}

{
  name: "a passThrough parent and a plain parent, plain edge first",
  graph: {
    nodes: [
      {expression: "a", passThrough: true, fields: {k: "a", fromA: "true"}},
      {expression: "b", fields: {k: "b", fromB: "true"}},
    ],
    edges: ["input -> b -> output", "input -> a -> output"],
  },
  cases: [
    [{a: 1, b: 2, x: 0}, {a: 1, b: 2, fromA: true, fromB: true, k: 2, x: 0}],
    [{a: null, b: 2, x: 0}, {b: 2, fromA: true, fromB: true, k: 2, x: 0}],
    [{a: 1, b: null, x: 0}, {a: 1, fromA: true, fromB: true, x: 0}],
    [{b: 2, k: "req", x: 0}, {b: 2, fromA: true, fromB: true, k: 2, x: 0}],
    [{k: "req", x: 0}, {fromA: true, fromB: true, x: 0}],
  ],
}

{
  name: "a passThrough parent and a plain parent, passThrough edge first",
  graph: {
    nodes: [
      {expression: "a", passThrough: true, fields: {k: "a", fromA: "true"}},
      {expression: "b", fields: {k: "b", fromB: "true"}},
    ],
    edges: ["input -> a -> output", "input -> b -> output"],
  },
  cases: [
    [{a: 1, b: 2, x: 0}, {a: 1, b: 2, fromA: true, fromB: true, k: 1, x: 0}],
    [{a: null, b: 2, x: 0}, {b: 2, fromA: true, fromB: true, k: 2, x: 0}],
    [{a: 1, b: null, x: 0}, {a: 1, fromA: true, fromB: true, k: 1, x: 0}],
    [{b: 2, k: "req", x: 0}, {b: 2, fromA: true, fromB: true, k: 2, x: 0}],
    [{k: "req", x: 0}, {fromA: true, fromB: true, x: 0}],
  ],
}

// The input node itself as a parent next to a function returning every kind.
{
  name: "the input and a function parent, input edge first",
  graph: {
    nodes: [
      {function: "a", source: """export const handler = async (input) => input.a;"""},
    ],
    edges: ["input -> output", "input -> a -> output"],
  },
  cases: [
    [{a: {k: "a"}, k: "req"}, {a: {k: "a"}, k: "req"}],
    [{a: [1], k: "req"}, {a: [1], k: "req"}],
    [{a: 5, k: "req"}, {a: 5, k: "req"}],
    [{a: null, k: "req"}, {k: "req"}],
    [{k: "req"}, {k: "req"}],
    [{a: {k: null}, k: "req"}, {a: {k: null}, k: "req"}],
  ],
}

{
  name: "the input and a function parent, function edge first",
  graph: {
    nodes: [
      {function: "a", source: """export const handler = async (input) => input.a;"""},
    ],
    edges: ["input -> a -> output", "input -> output"],
  },
  cases: [
    [{a: {k: "a"}, k: "req"}, {a: {k: "a"}, k: "a"}],
    [{a: [1], k: "req"}, [1]],
    [{a: 5, k: "req"}, {a: 5, k: "req"}],
    [{a: null, k: "req"}, {k: "req"}],
    [{k: "req"}, {k: "req"}],
    [{a: {k: null}, k: "req"}, {a: {k: null}}],
  ],
}

// --- Natural producers ------------------------------------------------------------------------------
// The same rules with the node kinds that produce each kind in practice: an expression object, a
// collect table array, a first-hit table null when no rule matches, and a branch a switch did
// not take (missing: the parent never ran and is skipped by the join).
{
  name: "expression and first-hit table, table edge first",
  graph: {
    nodes: [
      {expression: "e", fields: {k: "'expr'", e: "true"}},
      {table: "t", inputs: ["n"], outputs: ["k"], rules: [["> 0", "'table'"]]},
    ],
    edges: ["input -> t -> output", "input -> e -> output"],
  },
  cases: [
    [{n: 1}, {e: true, k: "table"}],
    [{n: 0}, {e: true, k: "expr"}],
    [{n: null}, {e: true, k: "expr"}],
    [{}, {e: true, k: "expr"}],
  ],
}

{
  name: "expression and collect table, table edge first",
  graph: {
    nodes: [
      {expression: "e", fields: {k: "'expr'", e: "true"}},
      {table: "c", hit: "collect", inputs: ["n"], outputs: ["k"], rules: [["> 0", "'pos'"], ["> 10", "'big'"]]},
    ],
    edges: ["input -> c -> output", "input -> e -> output"],
  },
  cases: [
    [{n: 1}, [{k: "pos"}]],
    [{n: 20}, [{k: "pos"}, {k: "big"}]],
    [{n: 0}, []],
    [{}, []],
  ],
}

{
  name: "expression and collect table, expression edge first",
  graph: {
    nodes: [
      {expression: "e", fields: {k: "'expr'", e: "true"}},
      {table: "c", hit: "collect", inputs: ["n"], outputs: ["k"], rules: [["> 0", "'pos'"], ["> 10", "'big'"]]},
    ],
    edges: ["input -> e -> output", "input -> c -> output"],
  },
  cases: [
    [{n: 1}, {e: true, k: "expr"}],
    [{n: 20}, {e: true, k: "expr"}],
    [{n: 0}, {e: true, k: "expr"}],
  ],
}

{
  name: "first-hit table and collect table at one join",
  graph: {
    nodes: [
      {table: "t", inputs: ["n"], outputs: ["k"], rules: [["> 0", "'table'"]]},
      {table: "c", hit: "collect", inputs: ["n"], outputs: ["k"], rules: [["> 0", "'pos'"], ["> 10", "'big'"]]},
    ],
    edges: ["input -> t -> output", "input -> c -> output"],
  },
  cases: [
    [{n: 1}, {k: "table"}],
    [{n: 20}, {k: "table"}],
    [{n: 0}, []],
    [{}, []],
  ],
}

{
  name: "a switch decides which parents exist at the join",
  graph: {
    nodes: [
      {switch: "s", hit: "collect", when: ["l", "r"]},
      {expression: "left", fields: {k: "'left'", l: "true"}},
      {expression: "right", fields: {k: "'right'", r: "true"}},
      {expression: "j", fields: {k: "k", l: "l ?? false", r: "r ?? false"}},
    ],
    edges: ["input -> s", "s:0 -> left -> j", "s:1 -> right -> j", "j -> output"],
  },
  cases: [
    [{l: true, r: true}, {k: "left", l: true, r: true}],
    [{l: true, r: false}, {k: "left", l: true, r: false}],
    [{l: false, r: true}, {k: "right", l: false, r: true}],
    [{l: false, r: false}, {}],
  ],
}

{
  name: "a loop result (top-level array) meeting an expression object",
  graph: {
    nodes: [
      {expression: "loop", inputField: "items", executionMode: "loop", fields: {v: "x"}},
      {expression: "e", fields: {k: "'expr'", e: "true"}},
    ],
    edges: ["input -> loop -> output", "input -> e -> output"],
  },
  cases: [
    [{items: [{x: 1}]}, [{v: 1}]],
    [{items: []}, []],
    [{items: [{x: 1}, {x: null}]}, [{v: 1}, {v: null}]],
  ],
}

{
  name: "an expression object meeting a loop result",
  graph: {
    nodes: [
      {expression: "loop", inputField: "items", executionMode: "loop", fields: {v: "x"}},
      {expression: "e", fields: {k: "'expr'", e: "true"}},
    ],
    edges: ["input -> e -> output", "input -> loop -> output"],
  },
  cases: [
    [{items: [{x: 1}]}, {e: true, k: "expr"}],
    [{items: []}, {e: true, k: "expr"}],
  ],
}

