// Merge matrix: every kind of value meeting at a join, for two and three parents, in both
// edge orders, with and without passThrough. Kinds are object, array, scalar (number, string,
// boolean), null and missing.
//
// The rules pinned here (chapter 10 introduces them with hand-written graphs):
// - A join merges its parents' outputs in reverse edge order: the parent whose edge into the
//   join was declared first is merged last and wins conflicts.
// - The first parent merged (the last declared) becomes the head when it is an object or an
//   array; any other value starts the merge from an empty object.
// - A later object patch deep-merges into an object, and replaces an array or a scalar.
// - A later array patch replaces whatever was merged so far, objects included.
// - A later scalar or null patch at the top level is ignored: a node producing nothing
//   object-like does not erase its siblings.
// - Below the top level, values are merge-patched: objects deep-merge, everything else
//   replaces, a null deletes the key.
// - The graph result is the merge of the ending nodes into an empty object, which drops
//   top-level nulls; a downstream node still sees a null that survived the join.
//
// Parents are mostly v2 function nodes returning `input.a`, so one graph produces every kind
// from the request. A function returning a missing property returns undefined, which the
// engine treats like null. Natural producers (tables, switches, loops) close the chapter.

// --- Top-level kinds, two parents, observed in the graph result ---------------------------------
// The edge from `a` is declared first, so `a` wins. Each suite fixes the kind `a` returns and runs
// `b` through every kind.
{
  name: "top level: the winner is an object, the loser every kind",
  graph: {
    nodes: [
      {function: "a", source: """export const handler = async (input) => input.a;"""},
      {function: "b", source: """export const handler = async (input) => input.b;"""},
    ],
    edges: ["input -> a -> output", "input -> b -> output"],
  },
  cases: [
    [{a: {k: "a", z: 1}, b: {y: 2}, x: 0}, {k: "a", y: 2, z: 1}],
    [{a: {k: "a", z: 1}, b: {k: "b"}, x: 0}, {k: "a", z: 1}],
    [{a: {k: "a", z: 1}, b: {}, x: 0}, {k: "a", z: 1}],
    [{a: {k: "a", z: 1}, b: [1, 2], x: 0}, {k: "a", z: 1}],
    [{a: {k: "a", z: 1}, b: [], x: 0}, {k: "a", z: 1}],
    [{a: {k: "a", z: 1}, b: 7, x: 0}, {k: "a", z: 1}],
    [{a: {k: "a", z: 1}, b: "s", x: 0}, {k: "a", z: 1}],
    [{a: {k: "a", z: 1}, b: true, x: 0}, {k: "a", z: 1}],
    [{a: {k: "a", z: 1}, b: null, x: 0}, {k: "a", z: 1}],
    [{a: {k: "a", z: 1}, x: 0}, {k: "a", z: 1}],
  ],
}

{
  name: "top level: the winner is an array, the loser every kind",
  graph: {
    nodes: [
      {function: "a", source: """export const handler = async (input) => input.a;"""},
      {function: "b", source: """export const handler = async (input) => input.b;"""},
    ],
    edges: ["input -> a -> output", "input -> b -> output"],
  },
  cases: [
    [{a: ["a"], b: {y: 2}, x: 0}, ["a"]],
    [{a: [{k: "a"}], b: {k: "b"}, x: 0}, [{k: "a"}]],
    [{a: ["a"], b: {}, x: 0}, ["a"]],
    [{a: [{k: "a"}], b: [1, 2], x: 0}, [{k: "a"}]],
    [{a: ["a"], b: [], x: 0}, ["a"]],
    [{a: [{k: "a"}], b: 7, x: 0}, [{k: "a"}]],
    [{a: ["a"], b: "s", x: 0}, ["a"]],
    [{a: [{k: "a"}], b: true, x: 0}, [{k: "a"}]],
    [{a: ["a"], b: null, x: 0}, ["a"]],
    [{a: [{k: "a"}], x: 0}, [{k: "a"}]],
  ],
}

{
  name: "top level: the winner is a scalar, the loser every kind",
  graph: {
    nodes: [
      {function: "a", source: """export const handler = async (input) => input.a;"""},
      {function: "b", source: """export const handler = async (input) => input.b;"""},
    ],
    edges: ["input -> a -> output", "input -> b -> output"],
  },
  cases: [
    [{a: 5, b: {y: 2}, x: 0}, {y: 2}],
    [{a: "a", b: {k: "b"}, x: 0}, {k: "b"}],
    [{a: false, b: {}, x: 0}, {}],
    [{a: 5, b: [1, 2], x: 0}, [1, 2]],
    [{a: "a", b: [], x: 0}, []],
    [{a: false, b: 7, x: 0}, {}],
    [{a: 5, b: "s", x: 0}, {}],
    [{a: "a", b: true, x: 0}, {}],
    [{a: false, b: null, x: 0}, {}],
    [{a: 5, x: 0}, {}],
  ],
}

{
  name: "top level: the winner is null, the loser every kind",
  graph: {
    nodes: [
      {function: "a", source: """export const handler = async (input) => input.a;"""},
      {function: "b", source: """export const handler = async (input) => input.b;"""},
    ],
    edges: ["input -> a -> output", "input -> b -> output"],
  },
  cases: [
    [{a: null, b: {y: 2}, x: 0}, {y: 2}],
    [{a: null, b: {k: "b"}, x: 0}, {k: "b"}],
    [{a: null, b: {}, x: 0}, {}],
    [{a: null, b: [1, 2], x: 0}, [1, 2]],
    [{a: null, b: [], x: 0}, []],
    [{a: null, b: 7, x: 0}, {}],
    [{a: null, b: "s", x: 0}, {}],
    [{a: null, b: true, x: 0}, {}],
    [{a: null, b: null, x: 0}, {}],
    [{a: null, x: 0}, {}],
  ],
}

{
  name: "top level: the winner is missing, the loser every kind",
  graph: {
    nodes: [
      {function: "a", source: """export const handler = async (input) => input.a;"""},
      {function: "b", source: """export const handler = async (input) => input.b;"""},
    ],
    edges: ["input -> a -> output", "input -> b -> output"],
  },
  cases: [
    [{b: {y: 2}, x: 0}, {y: 2}],
    [{b: {k: "b"}, x: 0}, {k: "b"}],
    [{b: {}, x: 0}, {}],
    [{b: [1, 2], x: 0}, [1, 2]],
    [{b: [], x: 0}, []],
    [{b: 7, x: 0}, {}],
    [{b: "s", x: 0}, {}],
    [{b: true, x: 0}, {}],
    [{b: null, x: 0}, {}],
    [{x: 0}, {}],
  ],
}

// The same pairs with the edges declared in the other order: the roles of `a` and `b` swap
// although the node list is unchanged.
{
  name: "top level: edges declared b first, b wins",
  graph: {
    nodes: [
      {function: "a", source: """export const handler = async (input) => input.a;"""},
      {function: "b", source: """export const handler = async (input) => input.b;"""},
    ],
    edges: ["input -> b -> output", "input -> a -> output"],
  },
  cases: [
    [{a: {k: "a"}, b: {k: "b"}, x: 0}, {k: "b"}],
    [{a: {k: "a"}, b: [1], x: 0}, [1]],
    [{a: [1], b: {k: "b"}, x: 0}, {k: "b"}],
    [{a: {k: "a"}, b: 5, x: 0}, {k: "a"}],
    [{a: 5, b: {k: "b"}, x: 0}, {k: "b"}],
    [{a: [1], b: [2, 3], x: 0}, [2, 3]],
    [{a: [1], b: null, x: 0}, [1]],
    [{a: null, b: [1], x: 0}, [1]],
    [{a: "s", b: "t", x: 0}, {}],
    [{b: {k: "b"}, x: 0}, {k: "b"}],
  ],
}

// --- Top-level kinds observed by a node after the join -------------------------------------------
// The join node reports what it received: its type and the value itself under `seen`.
{
  name: "join node: what a node after a two-parent join receives",
  graph: {
    nodes: [
      {function: "a", source: """export const handler = async (input) => input.a;"""},
      {function: "b", source: """export const handler = async (input) => input.b;"""},
      {function: "j", source: """export const handler = async (input) => ({ t: Array.isArray(input) ? "array" : typeof input, seen: input });"""},
    ],
    edges: ["input -> a -> j", "input -> b -> j", "j -> output"],
  },
  cases: [
    [{a: {k: "a"}, b: {k: "b", y: 1}, x: 0}, {seen: {k: "a", y: 1}, t: "object"}],
    [{a: {k: "a"}, b: [1], x: 0}, {seen: {k: "a"}, t: "object"}],
    [{a: [1], b: {k: "b"}, x: 0}, {seen: [1], t: "array"}],
    [{a: [1], b: [2], x: 0}, {seen: [1], t: "array"}],
    [{a: [], b: {k: "b"}, x: 0}, {seen: [], t: "array"}],
    [{a: {}, b: [1], x: 0}, {seen: {}, t: "object"}],
    [{a: 7, b: {k: "b"}, x: 0}, {seen: {k: "b"}, t: "object"}],
    [{a: {k: "a"}, b: 7, x: 0}, {seen: {k: "a"}, t: "object"}],
    [{a: 7, b: [1], x: 0}, {seen: [1], t: "array"}],
    [{a: null, b: null, x: 0}, {seen: {}, t: "object"}],
    [{x: 0}, {seen: {}, t: "object"}],
    [{a: "s", b: true, x: 0}, {seen: {}, t: "object"}],
  ],
}

// --- Key-level kinds: both parents return an object holding `k` (or not) -------------------------
// Below the top level a scalar or null is a value like any other: a scalar replaces, a null
// deletes, missing leaves the loser alone. The node after the join reports what it sees at `k`.
{
  name: "key level at a join: the winner's k is an object",
  graph: {
    nodes: [
      {function: "a", source: """export const handler = async (input) => ('a' in input ? { k: input.a } : {});"""},
      {function: "b", source: """export const handler = async (input) => ('b' in input ? { k: input.b } : {});"""},
      {expression: "j", fields: {t: "type(k)", has: "'k' in keys($root)", v: "k"}},
    ],
    edges: ["input -> a -> j", "input -> b -> j", "j -> output"],
  },
  cases: [
    [{a: {q: 2}, b: {p: 1}, x: 0}, {has: true, t: "object", v: {p: 1, q: 2}}],
    [{a: {q: 2}, b: [1], x: 0}, {has: true, t: "object", v: {q: 2}}],
    [{a: {q: 2}, b: 2, x: 0}, {has: true, t: "object", v: {q: 2}}],
    [{a: {q: 2}, b: "s", x: 0}, {has: true, t: "object", v: {q: 2}}],
    [{a: {q: 2}, b: null, x: 0}, {has: true, t: "object", v: {q: 2}}],
    [{a: {q: 2}, x: 0}, {has: true, t: "object", v: {q: 2}}],
  ],
}

