    [{a: null, x: 0}, {}],
    [{b: "s", x: 0}, {k: "s"}],
  ],
}

// Deep merge below the top level: nested objects merge key by key at every depth, nested nulls
// from the winner delete, nested nulls from the loser survive.
{
  name: "key level: nested objects under k",
  graph: {
    nodes: [
      {function: "a", source: """export const handler = async (input) => ('a' in input ? { k: input.a } : {});"""},
      {function: "b", source: """export const handler = async (input) => ('b' in input ? { k: input.b } : {});"""},
    ],
    edges: ["input -> a -> output", "input -> b -> output"],
  },
  cases: [
    [{a: {m: {x: 1}}, b: {m: {y: 2}}, x: 0}, {k: {m: {x: 1, y: 2}}}],
    [{a: {m: {x: 1}}, b: {m: {x: 2, y: 2}}, x: 0}, {k: {m: {x: 1, y: 2}}}],
    [{a: {m: {x: null}}, b: {m: {x: 2, y: 2}}, x: 0}, {k: {m: {y: 2}}}],
    [{a: {m: {x: 1}}, b: {m: {x: null}}, x: 0}, {k: {m: {x: 1}}}],
    [{a: {m: [1]}, b: {m: {x: 2}}, x: 0}, {k: {m: [1]}}],
    [{a: {m: {x: 1}}, b: {m: [2]}, x: 0}, {k: {m: {x: 1}}}],
    [{a: {m: {}}, b: {m: {x: 2}}, x: 0}, {k: {m: {x: 2}}}],
    [{a: {m: 1}, b: {m: {x: 2}}, x: 0}, {k: {m: 1}}],
  ],
}

// --- Three parents ---------------------------------------------------------------------------------
// Edges into the join are declared a, b, c: `c` is the head, then `b`, then `a` is merged last.
// A top-level array anywhere replaces what was merged before it, and an object after an array
// replaces the array, so a parent before the array is lost.
{
  name: "three parents at the output: top-level kinds",
  graph: {
    nodes: [
      {function: "a", source: """export const handler = async (input) => input.a;"""},
      {function: "b", source: """export const handler = async (input) => input.b;"""},
      {function: "c", source: """export const handler = async (input) => input.c;"""},
    ],
    edges: ["input -> a -> output", "input -> b -> output", "input -> c -> output"],
  },
  cases: [
    [{a: {k: "a"}, b: {k: "b"}, c: {k: "c"}, x: 0}, {k: "a"}],
    [{a: {x1: 1}, b: {x2: 2}, c: {x3: 3}, x: 0}, {x1: 1, x2: 2, x3: 3}],
    [{a: {k: "a"}, b: [1], c: {z: 1}, x: 0}, {k: "a"}, "question: an array from a middle parent replaces the keys merged before it, so an object parent is lost even though the final winner is an object"],
    [{a: [1], b: {k: "b"}, c: {z: 1}, x: 0}, [1]],
    [{a: {k: "a"}, b: {z: 1}, c: [1], x: 0}, {k: "a", z: 1}],
    [{a: [1], b: [2], c: [3], x: 0}, [1]],
    [{a: 5, b: {k: "b"}, c: {z: 1}, x: 0}, {k: "b", z: 1}],
    [{a: {k: "a"}, b: 5, c: {z: 1}, x: 0}, {k: "a", z: 1}],
    [{a: {k: "a"}, b: {z: 1}, c: 5, x: 0}, {k: "a", z: 1}],
    [{a: null, b: null, c: {z: 1}, x: 0}, {z: 1}],
    [{b: [1], c: null, x: 0}, [1]],
    [{a: 5, b: "s", c: true, x: 0}, {}],
  ],
}

{
  name: "three parents at the output: edges declared c, b, a",
  graph: {
    nodes: [
      {function: "a", source: """export const handler = async (input) => input.a;"""},
      {function: "b", source: """export const handler = async (input) => input.b;"""},
      {function: "c", source: """export const handler = async (input) => input.c;"""},
    ],
    edges: ["input -> c -> output", "input -> b -> output", "input -> a -> output"],
