// Output assembly: how the graph result is built from the nodes that end the walk.
//
// The walk stops as soon as the first output node runs. The result is then the merge of every
// visited node without outgoing edges ("ending nodes"), folded into an empty object in node
// declaration order (not edge order), so on a key conflict the later declared ending node wins.
// The fold is a merge-patch: a top-level null from a later ending node deletes the key, an array
// replaces everything merged so far, and a scalar is ignored. `$nodes` keys are stripped from the
// result at every depth. Chapters 01 and 10 introduce output nodes, dead ends and leaves; this
// chapter covers several outputs, leaf merge order, outputPath collisions, deep paths, arrays of
// objects, reserved keys and very wide results.

// --- Several output nodes --------------------------------------------------------------------------
// Only the first output node reached contributes; which one is reached depends on the branch taken.
{
  name: "outputs: a switch routes to one of two output nodes",
  graph: {
    nodes: [
      {switch: "s", when: ["n > 0", ""]},
      {expression: "pos", fields: {sign: "'pos'", n: "n"}},
      {expression: "neg", fields: {sign: "'neg'", abs: "abs(n ?? 0)"}},
      {output: "outPos"},
      {output: "outNeg"},
    ],
    edges: ["input -> s", "s:0 -> pos -> outPos", "s:1 -> neg -> outNeg"],
  },
  cases: [
    [{n: 2}, {n: 2, sign: "pos"}],
    [{n: -3}, {abs: 3, sign: "neg"}],
    [{n: 0}, {abs: 0, sign: "neg"}],
    [{}, {abs: 0, sign: "neg"}],
  ],
}

{
  name: "outputs: a collect switch taking both branches stops at the first output reached",
  graph: {
    nodes: [
      {switch: "s", hit: "collect", when: ["a", "b"]},
      {expression: "A", fields: {fromA: "true"}},
      {expression: "B", fields: {fromB: "true"}},
      {output: "outA"},
      {output: "outB"},
    ],
    edges: ["input -> s", "s:0 -> A -> outA", "s:1 -> B -> outB"],
  },
  cases: [
    [{a: true, b: true}, {fromA: true}],
    [{a: true, b: false}, {fromA: true}],
    [{a: false, b: true}, {fromB: true}],
  ],
}

{
  name: "outputs: two output nodes behind the same join",
  graph: {
    nodes: [
      {expression: "a", fields: {k: "'a'", x: "1"}},
      {expression: "b", fields: {k: "'b'", y: "2"}},
      {output: "out1"},
      {output: "out2"},
    ],
    edges: ["input -> a -> out1", "input -> b -> out1", "a -> out2", "b -> out2"],
  },
  cases: [
    [{}, {k: "a", x: 1, y: 2}],
    [{k: "req"}, {k: "a", x: 1, y: 2}],
  ],
}

{
  name: "outputs: an output node with an outgoing edge",
  graph: {
    nodes: [
      {expression: "a", fields: {k: "n + 1"}},
      {output: "mid"},
      {expression: "after", fields: {after: "k * 10"}},
    ],
    edges: ["input -> a -> mid -> after"],
  },
  cases: [
    [{n: 1}, {}, "question: the walk stops at the output node, but an output node with an outgoing edge is not an ending node, so nothing is merged and the result is empty"],
    [{n: 0}, {}, "question: the walk stops at the output node, but an output node with an outgoing edge is not an ending node, so nothing is merged and the result is empty"],
  ],
}

{
  name: "outputs: an output node directly after the input next to a longer branch",
  graph: {
    nodes: [
      {expression: "calc", fields: {k: "'calc'"}},
      {output: "out"},
    ],
    edges: ["input -> calc -> out", "input -> out"],
  },
  cases: [
    [{k: "req", n: 1}, {k: "calc", n: 1}],
    [{n: 1}, {k: "calc", n: 1}],
    [{k: null, n: 1}, {k: "calc", n: 1}],
  ],
}

{
  name: "outputs: an output schema checks only the output reached",
  graph: {
    nodes: [
      {switch: "s", when: ["strict", ""]},
      {expression: "A", fields: {v: "v"}},
      {expression: "B", fields: {v: "v"}},
      {output: "checked", schema: {type: "object", required: ["v"], properties: {v: {type: "number"}}}},
      {output: "unchecked"},
    ],
    edges: ["input -> s", "s:0 -> A -> checked", "s:1 -> B -> unchecked"],
  },
  cases: [
    [{strict: true, v: 1}, {v: 1}],
    [{strict: true, v: "x"}, "!error"],
    [{strict: false, v: "x"}, {v: "x"}],
    [{strict: false}, {}],
  ],
}

// --- Leaves without an output node -------------------------------------------------------------------
// Every visited leaf is merged, in node declaration order: the later declared leaf wins conflicts,
// whatever the edge order.
{
  name: "leaves: two leaves writing the same key, b declared last",
  graph: {
    nodes: [
      {input: "request"},
      {expression: "a", fields: {k: "'a'", onlyA: "1"}},
      {expression: "b", fields: {k: "'b'", onlyB: "2"}},
    ],
    edges: ["request -> a", "request -> b"],
  },
  cases: [
    [{}, {k: "b", onlyA: 1, onlyB: 2}],
    [{k: "req"}, {k: "b", onlyA: 1, onlyB: 2}],
  ],
}

{
  name: "leaves: the same leaves with the node list reversed",
  graph: {
    nodes: [
      {input: "request"},
      {expression: "b", fields: {k: "'b'", onlyB: "2"}},
      {expression: "a", fields: {k: "'a'", onlyA: "1"}},
    ],
    edges: ["request -> a", "request -> b"],
  },
  cases: [
    [{}, {k: "a", onlyA: 1, onlyB: 2}],
    [{k: "req"}, {k: "a", onlyA: 1, onlyB: 2}],
  ],
}

{
  name: "leaves: the same leaves with the edges reversed",
  graph: {
    nodes: [
      {input: "request"},
      {expression: "a", fields: {k: "'a'", onlyA: "1"}},
      {expression: "b", fields: {k: "'b'", onlyB: "2"}},
    ],
    edges: ["request -> b", "request -> a"],
  },
  cases: [
    [{}, {k: "b", onlyA: 1, onlyB: 2}],
  ],
}

{
  name: "leaves: a null in a later leaf deletes an earlier leaf's key",
  graph: {
    nodes: [
      {input: "request"},
      {expression: "a", fields: {k: "'a'", nested: "{x: 1, y: 1}"}},
      {expression: "b", fields: {k: "v", nested: "{x: v}"}},
    ],
    edges: ["request -> a", "request -> b"],
  },
  cases: [
    [{v: 2}, {k: 2, nested: {x: 2, y: 1}}],
    [{v: null}, {nested: {y: 1}}],
    [{}, {nested: {y: 1}}],
  ],
}

{
  name: "leaves: a null in an earlier leaf does not delete a later leaf's key",
  graph: {
    nodes: [
      {input: "request"},
      {expression: "b", fields: {k: "v", nested: "{x: v}"}},
      {expression: "a", fields: {k: "'a'", nested: "{x: 1, y: 1}"}},
    ],
    edges: ["request -> a", "request -> b"],
  },
  cases: [
    [{v: 2}, {k: "a", nested: {x: 1, y: 1}}],
    [{v: null}, {k: "a", nested: {x: 1, y: 1}}],
  ],
}

{
  name: "leaves: tables, functions and loops as leaves of every result kind",
  graph: {
    nodes: [
      {input: "request"},
      {expression: "e", fields: {e: "true"}},
      {table: "first", inputs: ["n"], outputs: ["first"], rules: [["> 0", "'hit'"]]},
      {function: "f", source: """export const handler = async (input) => input.fn;"""},
    ],
    edges: ["request -> e", "request -> first", "request -> f"],
  },
  cases: [
    [{n: 1}, {e: true, first: "hit"}],
    [{n: 0}, {e: true}],
    [{n: 1, fn: {f: 1}}, {e: true, f: 1, first: "hit"}],
    [{n: 1, fn: {e: false}}, {e: false, first: "hit"}],
    [{n: 1, fn: 5}, {e: true, first: "hit"}],
    [{n: 1, fn: null}, {e: true, first: "hit"}],
    [{n: 1, fn: [1, 2]}, [1, 2]],
  ],
}

{
  name: "leaves: an array leaf declared before an object leaf",
  graph: {
    nodes: [
      {input: "request"},
      {table: "rows", hit: "collect", inputs: ["n"], outputs: ["r"], rules: [["> 0", "'pos'"], ["", "'any'"]]},
      {expression: "e", fields: {e: "true"}},
    ],
    edges: ["request -> rows", "request -> e"],
  },
  cases: [
    [{n: 1}, {e: true}, "question: a collect table leaf is discarded when an object leaf is declared after it; the result depends on node declaration order"],
    [{n: 0}, {e: true}, "question: a collect table leaf is discarded when an object leaf is declared after it; the result depends on node declaration order"],
  ],
}

{
  name: "leaves: an object leaf declared before an array leaf",
  graph: {
    nodes: [
      {input: "request"},
      {expression: "e", fields: {e: "true"}},
      {table: "rows", hit: "collect", inputs: ["n"], outputs: ["r"], rules: [["> 0", "'pos'"], ["", "'any'"]]},
    ],
    edges: ["request -> rows", "request -> e"],
  },
  cases: [
    [{n: 1}, [{r: "pos"}, {r: "any"}]],
    [{n: 0}, [{r: "any"}]],
  ],
}

{
  name: "leaves: deep objects from three leaves merge key by key",
  graph: {
    nodes: [
      {input: "request"},
      {expression: "a", fields: {"r.x.a": "1", "r.shared": "'a'"}},
      {expression: "b", fields: {"r.x.b": "2", "r.shared": "'b'"}},
      {expression: "c", fields: {"r.y": "[3]", "r.shared": "v"}},
    ],
    edges: ["request -> a", "request -> b", "request -> c"],
  },
  cases: [
    [{v: "c"}, {r: {shared: "c", x: {a: 1, b: 2}, y: [3]}}],
    [{v: null}, {r: {x: {a: 1, b: 2}, y: [3]}}],
    [{}, {r: {x: {a: 1, b: 2}, y: [3]}}],
  ],
}

{
  name: "leaves: a chain and a single node as two leaves",
  graph: {
    nodes: [
      {input: "request"},
      {expression: "a1", fields: {k: "n + 1"}},
      {expression: "a2", fields: {k: "k * 10", chain: "true"}},
      {expression: "b", fields: {single: "true", k: "0"}},
    ],
    edges: ["request -> a1 -> a2", "request -> b"],
  },
  cases: [
    [{n: 1}, {chain: true, k: 0, single: true}],
    [{n: 5}, {chain: true, k: 0, single: true}],
  ],
}

{
  name: "leaves: a leaf behind a switch branch not taken contributes nothing",
  graph: {
    nodes: [
      {input: "request"},
      {switch: "s", when: ["go", ""]},
      {expression: "yes", fields: {k: "'yes'"}},
      {expression: "no", fields: {k: "'no'"}},
      {expression: "always", fields: {always: "true"}},
    ],
    edges: ["request -> s", "s:0 -> yes", "s:1 -> no", "request -> always"],
  },
  cases: [
    [{go: true}, {always: true, k: "yes"}],
    [{go: false}, {always: true, k: "no"}],
  ],
}

// --- outputPath collisions -----------------------------------------------------------------------------
// Several nodes writing to the same or overlapping output paths: the merge rules decide.
{
  name: "outputPath: two branches with the same path deep-merge",
  graph: {
    nodes: [
      {expression: "a", outputPath: "res", fields: {k: "'a'", x: "1"}},
      {expression: "b", outputPath: "res", fields: {k: "'b'", y: "2"}},
    ],
    edges: ["input -> a -> output", "input -> b -> output"],
  },
  cases: [
    [{}, {res: {k: "a", x: 1, y: 2}}],
    [{res: {z: 0}}, {res: {k: "a", x: 1, y: 2}}],
  ],
}

{
  name: "outputPath: a parent path and a child path from two branches",
  graph: {
    nodes: [
      {expression: "a", outputPath: "res", fields: {k: "'a'", "sub.x": "1"}},
      {expression: "b", outputPath: "res.sub", fields: {y: "2", x: "'b'"}},
    ],
    edges: ["input -> a -> output", "input -> b -> output"],
  },
  cases: [
    [{}, {res: {k: "a", sub: {x: 1, y: 2}}}],
  ],
}

{
  name: "outputPath: the child path declared first wins inside the parent's object",
  graph: {
    nodes: [
      {expression: "a", outputPath: "res", fields: {k: "'a'", "sub.x": "1"}},
      {expression: "b", outputPath: "res.sub", fields: {y: "2", x: "'b'"}},
    ],
    edges: ["input -> b -> output", "input -> a -> output"],
  },
  cases: [
    [{}, {res: {k: "a", sub: {x: "b", y: 2}}}],
  ],
}

{
  name: "outputPath: a scalar at the parent path against an object below it",
  graph: {
    nodes: [
      {expression: "a", fields: {res: "v"}},
      {expression: "b", outputPath: "res.sub", fields: {y: "2"}},
    ],
    edges: ["input -> a -> output", "input -> b -> output"],
  },
  cases: [
    [{v: 5}, {res: 5}],
    [{v: null}, {}],
    [{v: [1]}, {res: [1]}],
    [{v: {other: 1}}, {res: {other: 1, sub: {y: 2}}}],
  ],
}

{
  name: "outputPath: the object below declared first against a scalar at the parent path",
  graph: {
    nodes: [
      {expression: "a", fields: {res: "v"}},
      {expression: "b", outputPath: "res.sub", fields: {y: "2"}},
    ],
    edges: ["input -> b -> output", "input -> a -> output"],
  },
  cases: [
    [{v: 5}, {res: {sub: {y: 2}}}],
    [{v: null}, {res: {sub: {y: 2}}}],
    [{v: [1]}, {res: {sub: {y: 2}}}],
  ],
}

{
  name: "outputPath: a table and a collect table writing the same path",
  graph: {
    nodes: [
      {table: "t", outputPath: "res", inputs: ["n"], outputs: ["k"], rules: [["> 0", "'first'"]]},
      {table: "c", hit: "collect", outputPath: "res", inputs: ["n"], outputs: ["k"], rules: [["> 0", "'row'"], ["", "'any'"]]},
    ],
    edges: ["input -> t -> output", "input -> c -> output"],
  },
  cases: [
    [{n: 1}, {res: {k: "first"}}],
    [{n: 0}, {}, "question: an unmatched table under an outputPath writes null at the path, which erases the other branch value there; without outputPath an unmatched table is ignored at a join"],
  ],
}

{
  name: "outputPath: chained nodes writing the same path with and without passThrough",
  graph: {
    nodes: [
      {expression: "a", outputPath: "res", fields: {k: "'a'", x: "1"}},
      {expression: "b", outputPath: "res", passThrough: true, fields: {k: "'b'"}},
      {expression: "c", outputPath: "res", passThrough: true, fields: {y: "res.x + 1"}},
    ],
  },
  cases: [
    [{}, {res: {k: "b", x: 1, y: 2}}],
    [{res: 1}, {res: {k: "b", x: 1, y: 2}}],
  ],
}

{
  name: "outputPath: a path equal to a request key, without passThrough",
  graph: {
    nodes: [
      {expression: "a", outputPath: "n", fields: {doubled: "n * 2"}},
    ],
    edges: ["input -> a -> output", "input -> output"],
  },
  cases: [
    [{n: 2}, {n: {doubled: 4}}],
    [{n: 0, other: true}, {n: {doubled: 0}, other: true}],
  ],
}

// --- Deep paths ----------------------------------------------------------------------------------------
{
  name: "deep: an eight-segment outputPath",
  graph: {
    nodes: [{expression: "a", outputPath: "l1.l2.l3.l4.l5.l6.l7.l8", fields: {v: "n", "w.x": "[n]"}}],
  },
  cases: [
    [{n: 1}, {l1: {l2: {l3: {l4: {l5: {l6: {l7: {l8: {v: 1, w: {x: [1]}}}}}}}}}}],
    [{n: null}, {l1: {l2: {l3: {l4: {l5: {l6: {l7: {l8: {v: null, w: {x: [null]}}}}}}}}}}],
  ],
}

{
  name: "deep: two deep paths sharing a long prefix",
  graph: {
    nodes: [
      {expression: "a", outputPath: "p.q.r.s.left", fields: {v: "1"}},
      {expression: "b", outputPath: "p.q.r.s.right", fields: {v: "2"}},
      {expression: "c", outputPath: "p.q.other", fields: {v: "3"}},
    ],
    edges: ["input -> a -> output", "input -> b -> output", "input -> c -> output"],
  },
  cases: [
    [{}, {p: {q: {other: {v: 3}, r: {s: {left: {v: 1}, right: {v: 2}}}}}}],
    [{p: {q: {keep: true}}}, {p: {q: {other: {v: 3}, r: {s: {left: {v: 1}, right: {v: 2}}}}}}],
  ],
}

{
  name: "deep: a deep outputPath with passThrough over a request holding part of the spine",
  graph: {
    nodes: [{expression: "a", outputPath: "p.q.r", passThrough: true, fields: {v: "1"}}],
  },
  cases: [
    [{}, {p: {q: {r: {v: 1}}}}],
    [{p: {keep: 1}}, {p: {keep: 1, q: {r: {v: 1}}}}],
    [{p: {q: {r: {old: 1}}}}, {p: {q: {r: {old: 1, v: 1}}}}],
    [{p: {q: 5}}, {p: {q: {r: {v: 1}}}}],
    [{p: null}, {p: {q: {r: {v: 1}}}}],
  ],
}

{
  name: "deep: a table writing deep output fields under a deep outputPath",
  graph: {
    nodes: [
      {table: "t", outputPath: "a.b", inputs: ["n"], outputs: ["c.d.e", "c.d.f", "g"], rules: [
        ["> 0", "n", "'pos'", "[n]"],
        ["", "0", "null", "[]"],
      ]},
    ],
  },
  cases: [
    [{n: 1}, {a: {b: {c: {d: {e: 1, f: "pos"}}, g: [1]}}}],
    [{n: -1}, {a: {b: {c: {d: {e: 0, f: null}}, g: []}}}],
  ],
}

{
  name: "deep: a loop under a deep outputPath",
  graph: {
    nodes: [{expression: "each", inputField: "items", outputPath: "x.y.z", executionMode: "loop", fields: {"a.b": "v"}}],
  },
  cases: [
    [{items: [{v: 1}, {v: 2}]}, {x: {y: {z: [{a: {b: 1}}, {a: {b: 2}}]}}}],
    [{items: []}, {x: {y: {z: []}}}],
  ],
}

{
  name: "deep: sub-decision result placed under a deep path",
  decisions: {
    child: {nodes: [{expression: "c", fields: {"inner.k": "v", top: "1"}}]},
  },
  graph: {
    nodes: [{decision: "d", key: "child", outputPath: "a.b.c"}],
  },
  cases: [
    [{v: 1}, {a: {b: {c: {inner: {k: 1}, top: 1}}}}],
    [{v: null}, {a: {b: {c: {inner: {k: null}, top: 1}}}}],
  ],
}

// --- Arrays of objects -----------------------------------------------------------------------------------
{
  name: "arrays: collect table rows with dotted outputs are nested objects",
  graph: {
    nodes: [
      {table: "t", hit: "collect", outputPath: "rows", inputs: ["n"], outputs: ["id", "meta.kind", "meta.n"], rules: [
        ["> 0", "1", "'pos'", "n"],
        ["> 10", "2", "'big'", "n * 2"],
        ["", "3", "'any'", "null"],
      ]},
    ],
  },
  cases: [
    [{n: 20}, {rows: [{id: 1, meta: {kind: "pos", n: 20}}, {id: 2, meta: {kind: "big", n: 40}}, {id: 3, meta: {kind: "any", n: null}}]}],
    [{n: 5}, {rows: [{id: 1, meta: {kind: "pos", n: 5}}, {id: 3, meta: {kind: "any", n: null}}]}],
    [{n: 0}, {rows: [{id: 3, meta: {kind: "any", n: null}}]}],
  ],
}

{
  name: "arrays: a loop result next to the source array",
  graph: {
    nodes: [{expression: "each", inputField: "orders", outputPath: "summary", executionMode: "loop", fields: {id: "id", "total.net": "qty * price", "total.items": "qty"}}],
    edges: ["input -> each -> output", "input -> output"],
  },
  cases: [
    [{orders: [{id: "a", qty: 2, price: 3}, {id: "b", qty: 1, price: 10}]}, {orders: [{id: "a", price: 3, qty: 2}, {id: "b", price: 10, qty: 1}], summary: [{id: "a", total: {items: 2, net: 6}}, {id: "b", total: {items: 1, net: 10}}]}],
    [{orders: []}, {orders: [], summary: []}],
  ],
}

{
  name: "arrays: two branches writing an array of objects at the same key",
  graph: {
    nodes: [
      {expression: "a", fields: {list: "[{id: 1, a: true}, {id: 2, a: true}]"}},
      {expression: "b", fields: {list: "[{id: 1, b: true}]"}},
    ],
    edges: ["input -> a -> output", "input -> b -> output"],
  },
  cases: [
    [{}, {list: [{a: true, id: 1}, {a: true, id: 2}]}],
  ],
}

{
  name: "arrays: a passThrough loop writing back into an array of nested objects",
  graph: {
    nodes: [{expression: "each", inputField: "people", outputPath: "people", executionMode: "loop", passThrough: true, fields: {"address.full": "address.city + ', ' + address.zip", adult: "age >= 18"}}],
  },
  cases: [
    [{people: [{age: 20, address: {city: "x", zip: "1"}}, {age: 3, address: {city: "y", zip: "2"}}]}, {people: [{address: {city: "x", full: "x, 1", zip: "1"}, adult: true, age: 20}, {address: {city: "y", full: "y, 2", zip: "2"}, adult: false, age: 3}]}],
    [{people: [], other: 1}, {other: 1, people: []}],
  ],
}

{
  name: "arrays: array of arrays and mixed items survive assembly",
  graph: {
    nodes: [{expression: "a", fields: {m: "[[1, 2], [], [{x: null}], null, 'x']"}}],
  },
  cases: [
    [{}, {m: [[1, 2], [], [{x: null}], null, "x"]}],
  ],
}

// --- Reserved keys -----------------------------------------------------------------------------------------
// `$nodes` is stripped from the result at every depth; `$` is an ordinary key.
{
  name: "reserved: an outputPath named $nodes",
  graph: {
    nodes: [{expression: "a", outputPath: "$nodes", fields: {k: "1"}}],
    edges: ["input -> a -> output", "input -> output"],
  },
  cases: [
    [{x: 1}, {x: 1}],
  ],
}

{
  name: "reserved: a nested $nodes key written by an expression",
  graph: {
    nodes: [{expression: "a", fields: {"res.$nodes": "1", "res.k": "2"}}],
  },
  cases: [
    [{}, {res: {k: 2}}],
  ],
}

{
  name: "reserved: a function returning $nodes and $ keys",
  graph: {
    nodes: [{function: "f", source: """export const handler = async () => ({ $nodes: 1, $: 2, deep: { $nodes: 3, $: 4 } });"""}],
  },
  cases: [
    [{}, {$: 2, deep: {$: 4}}],
  ],
}

{
  name: "reserved: a request with $nodes and $ keys passed straight through",
  graph: {},
  cases: [
    [{"$nodes": {a: 1}, "$": 1, deep: {"$nodes": 2}}, {$: 1, deep: {}}, "question: the result cleaner deletes user data under a `$nodes` key at any depth, not only the engine map"],
  ],
}

{
  name: "reserved: a table output column named $ and $nodes",
  graph: {
    nodes: [{table: "t", inputs: [""], outputs: ["$", "$nodes", "ok"], rules: [["", "1", "2", "3"]]}],
  },
  cases: [
    [{}, {$: 1, ok: 3}],
  ],
}

{
  name: "reserved: an outputPath named $",
  graph: {
    nodes: [{expression: "a", outputPath: "$", fields: {k: "1"}}],
