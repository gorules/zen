// ---------------------------------------------------------------------------------------------
// The clock: `d()`, `date('now')` and the now-relative helpers read one fixed instant
// (2025-03-20T10:15:30Z), mixed with per-row dates.
{
  name: "now: d() and date('now') beside per-row dates",
  graph: {nodes: [{expression: "calc", fields: {
    now: "d()",
    legacy: "date('now')",
    days: "d(s).diff(d(), 'd')",
    past: "d(s) < d()",
    sod: "d().startOf('day')",
    inAWeek: "d().add(n ?? 7, 'd')",
  }}]},
  cases: [
    [{s: "2025-03-21"}, {now: "2025-03-20T10:15:30Z", legacy: 1742465730, days: 0, past: false, sod: "2025-03-20T00:00:00Z", inAWeek: "2025-03-27T10:15:30Z"}],
    [{s: "2025-03-22", n: 1}, {now: "2025-03-20T10:15:30Z", legacy: 1742465730, days: 1, past: false, sod: "2025-03-20T00:00:00Z", inAWeek: "2025-03-21T10:15:30Z"}],
    [{s: "2025-03-21"}, {now: "2025-03-20T10:15:30Z", legacy: 1742465730, days: 0, past: false, sod: "2025-03-20T00:00:00Z", inAWeek: "2025-03-27T10:15:30Z"}],
    [{s: "2025-03-19", n: 0}, {now: "2025-03-20T10:15:30Z", legacy: 1742465730, days: -1, past: true, sod: "2025-03-20T00:00:00Z", inAWeek: "2025-03-20T10:15:30Z"}],
    [{s: "2025-03-20T10:15:30Z"}, {now: "2025-03-20T10:15:30Z", legacy: 1742465730, days: 0, past: false, sod: "2025-03-20T00:00:00Z", inAWeek: "2025-03-27T10:15:30Z"}],
    [{s: "2024-03-20", n: -1}, {now: "2025-03-20T10:15:30Z", legacy: 1742465730, days: -365, past: true, sod: "2025-03-20T00:00:00Z", inAWeek: "2025-03-19T10:15:30Z"}],
    [{s: "2025-03-21"}, {now: "2025-03-20T10:15:30Z", legacy: 1742465730, days: 0, past: false, sod: "2025-03-20T00:00:00Z", inAWeek: "2025-03-27T10:15:30Z"}],
  ],
}

