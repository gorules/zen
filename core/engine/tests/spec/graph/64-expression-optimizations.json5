// ---------------------------------------------------------------------------------------------
// Optimizations meeting each other across nodes: a folded constant, a keyed category, a copy and a
// coalesced default flowing through a table and back into an expression.
{
  name: "combined: keyed categories, coalesced defaults and copies through a table",
  graph: {nodes: [
    {expression: "prep", passThrough: true, fields: {segment: "segment ?? 'retail'", original: "order", qty: "order.qty ?? 1"}},
    {table: "rates", passThrough: true, inputs: ["segment"], outputs: ["rate"], rules: [
      ["'retail'", "0.10"],
      ["'wholesale'", "0.25"],
      ["", "0"],
    ]},
    {expression: "final", fields: {
      "order.total": "order.price * qty * (1 - rate)",
      "order.qty": "qty",
      original: "original",
      tag: "upper(segment) + '/' + string(rate)",
    }},
  ]},
  cases: [
    [{order: {price: 10, qty: 2}}, {order: {total: 18, qty: 2}, original: {price: 10, qty: 2}, tag: "RETAIL/0.10"}],
    [{order: {price: 10}, segment: "wholesale"}, {order: {total: 7.5, qty: 1}, original: {price: 10}, tag: "WHOLESALE/0.25"}],
    [{order: {price: 10, qty: 2}}, {order: {total: 18, qty: 2}, original: {price: 10, qty: 2}, tag: "RETAIL/0.10"}],
    [{order: {price: 4, qty: 1}, segment: "vip"}, {order: {total: 4, qty: 1}, original: {price: 4, qty: 1}, tag: "VIP/0"}],
    [{order: {price: 10}, segment: "wholesale"}, {order: {total: 7.5, qty: 1}, original: {price: 10}, tag: "WHOLESALE/0.25"}],
    [{order: {price: 10, qty: 2}, segment: null}, {order: {total: 18, qty: 2}, original: {price: 10, qty: 2}, tag: "RETAIL/0.10"}],
    [{order: {price: 0.99, qty: 3}}, {order: {total: 2.673, qty: 3}, original: {price: 0.99, qty: 3}, tag: "RETAIL/0.10"}],
    [{order: {price: 10, qty: 2}, segment: "wholesale"}, {order: {total: 15, qty: 2}, original: {price: 10, qty: 2}, tag: "WHOLESALE/0.25"}],
    [{order: {price: 10, qty: 2}}, {order: {total: 18, qty: 2}, original: {price: 10, qty: 2}, tag: "RETAIL/0.10"}],
    [{order: {price: 4, qty: 1}, segment: "vip"}, {order: {total: 4, qty: 1}, original: {price: 4, qty: 1}, tag: "VIP/0"}],
    [{order: {qty: 1}}, "!error"],
    [{order: {price: 10}, segment: "wholesale"}, {order: {total: 7.5, qty: 1}, original: {price: 10}, tag: "WHOLESALE/0.25"}],
  ],
}

{
  name: "combined: a loop over repeated items with folded constants and per-item coalescing",
  graph: {nodes: [
    {expression: "line", inputField: "items", outputPath: "lines", executionMode: "loop", fields: {
      sku: "upper(sku ?? 'n/a')",
      net: "(price ?? 0) * (qty ?? 1)",
      vat: "(price ?? 0) * (qty ?? 1) * 0.2",
      kind: "'line'",
    }},
  ]},
  cases: [
    [{items: [{sku: "a", price: 10}, {sku: "a", price: 10}, {sku: "b", price: 5, qty: 2}]}, {lines: [
      {sku: "A", net: 10, vat: 2, kind: "line"},
      {sku: "A", net: 10, vat: 2, kind: "line"},
      {sku: "B", net: 10, vat: 2, kind: "line"},
    ]}],
    [{items: [{}, {sku: "a"}]}, {lines: [
      {sku: "N/A", net: 0, vat: 0, kind: "line"},
      {sku: "A", net: 0, vat: 0, kind: "line"},
    ]}],
    [{items: []}, {lines: []}],
    [{items: [{sku: "a", price: 10}, {sku: "a", price: 10}, {sku: "b", price: 5, qty: 2}]}, {lines: [
      {sku: "A", net: 10, vat: 2, kind: "line"},
      {sku: "A", net: 10, vat: 2, kind: "line"},
