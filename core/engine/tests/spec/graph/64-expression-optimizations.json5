    [{n: 1, s: "2024-01-02"}, {base: "2024-01-01T00:00:00Z", shifted: "2024-01-02T00:00:00Z", gap: 1, after: true, legacy: 1704067200}],
    [{n: 31, s: "2023-12-31"}, {base: "2024-01-01T00:00:00Z", shifted: "2024-02-01T00:00:00Z", gap: -1, after: false, legacy: 1704067200}],
    [{n: 0, s: "2024-01-01"}, {base: "2024-01-01T00:00:00Z", shifted: "2024-01-01T00:00:00Z", gap: 0, after: false, legacy: 1704067200}],
    [{n: -1, s: "2025-01-01"}, {base: "2024-01-01T00:00:00Z", shifted: "2023-12-31T00:00:00Z", gap: 366, after: true, legacy: 1704067200}],
    [{n: 1, s: "2024-01-02"}, {base: "2024-01-01T00:00:00Z", shifted: "2024-01-02T00:00:00Z", gap: 1, after: true, legacy: 1704067200}],
    [{n: 366, s: "2024-03-01"}, {base: "2024-01-01T00:00:00Z", shifted: "2025-01-01T00:00:00Z", gap: 60, after: true, legacy: 1704067200}],
    [{n: 0, s: "2024-01-01"}, {base: "2024-01-01T00:00:00Z", shifted: "2024-01-01T00:00:00Z", gap: 0, after: false, legacy: 1704067200}],
  ],
}

{
  name: "builtins: a constant date result chained by a per-row method is not mutated",
  graph: {nodes: [{expression: "calc", fields: [
    ["start", "d('2024-03-15')"],
    ["moved", "$.start.add(n, 'month')"],
    ["again", "$.start"],
    ["som", "$.start.startOf(unit)"],
  ]}]},
  cases: [
    [{n: 1, unit: "month"}, {start: "2024-03-15T00:00:00Z", moved: "2024-04-15T00:00:00Z", again: "2024-03-15T00:00:00Z", som: "2024-03-01T00:00:00Z"}],
    [{n: 2, unit: "year"}, {start: "2024-03-15T00:00:00Z", moved: "2024-05-15T00:00:00Z", again: "2024-03-15T00:00:00Z", som: "2024-01-01T00:00:00Z"}],
    [{n: 1, unit: "month"}, {start: "2024-03-15T00:00:00Z", moved: "2024-04-15T00:00:00Z", again: "2024-03-15T00:00:00Z", som: "2024-03-01T00:00:00Z"}],
    [{n: -3, unit: "week"}, {start: "2024-03-15T00:00:00Z", moved: "2023-12-15T00:00:00Z", again: "2024-03-15T00:00:00Z", som: "2024-03-11T00:00:00Z"}],
    [{n: 0, unit: "day"}, {start: "2024-03-15T00:00:00Z", moved: "2024-03-15T00:00:00Z", again: "2024-03-15T00:00:00Z", som: "2024-03-15T00:00:00Z"}],
    [{n: 1, unit: "month"}, {start: "2024-03-15T00:00:00Z", moved: "2024-04-15T00:00:00Z", again: "2024-03-15T00:00:00Z", som: "2024-03-01T00:00:00Z"}],
  ],
}

{
  name: "builtins: constant math and list functions beside per-row arguments",
  graph: {nodes: [{expression: "calc", fields: {
