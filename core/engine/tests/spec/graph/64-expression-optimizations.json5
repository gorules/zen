    ]}],
    [{items: [{sku: "a", price: 1.5, qty: 3}]}, {lines: [{sku: "A", net: 4.5, vat: 0.9, kind: "line"}]}],
  ],
}

{
  name: "combined: a sub-decision called with repeated inputs returns per-row results",
