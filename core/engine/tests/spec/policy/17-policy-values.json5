// --- Realistic: insurance premium -----------------------------------------------------------------

{
  name: "insurance premium from a driver profile",
  policy: {
    models: {
      driver: {dob: "date", licensed: "date", claims: "claim[]", vehicle: "vehicle"},
      claim: {date: "date", amount: "number"},
      vehicle: {value: "number", kind: "string(car|van|bike)"},
    },
    blocks: [
      {expression: "driver.age", value: "d().diff(driver.dob, 'year')"},
      {expression: "driver.experience", value: "d().diff(driver.licensed, 'year')"},
      {expression: "driver.recentClaims", value: "count(driver.claims, d().diff(#.date, 'year') < 3)"},
      {table: "base", inputs: ["driver.vehicle.kind"], outputs: ["driver.baseRate"], rules: [["'car'", "0.03"], ["'van'", "0.04"], ["'bike'", "0.05"]]},
      {match: "driver.ageFactor", arms: [["driver.age < 25", "1.5"], ["driver.age >= 70", "1.3"], ["", "1"]]},
      {match: "driver.claimFactor", arms: [["driver.recentClaims == 0", "0.9"], ["driver.recentClaims == 1", "1.2"], ["", "1.6"]]},
      {expression: "driver.premium", value: "round(driver.vehicle.value * driver.baseRate * driver.ageFactor * driver.claimFactor * (driver.experience < 2 ? 1.25 : 1), 2)"},
    ],
  },
  cases: [
    [
      {driver: {dob: "1980-01-01", licensed: "2000-01-01", claims: [], vehicle: {value: 20000, kind: "car"}}},
      {driver: {dob: "1980-01-01", licensed: "2000-01-01", claims: [], vehicle: {value: 20000, kind: "car"}, age: 45, experience: 25, recentClaims: 0, baseRate: 0.03, ageFactor: 1, claimFactor: 0.9, premium: 540}},
    ],
    [
      {driver: {dob: "2003-06-01", licensed: "2024-01-01", claims: [{date: "2024-12-01", amount: 500}], vehicle: {value: 10000, kind: "bike"}}},
      {driver: {dob: "2003-06-01", licensed: "2024-01-01", claims: [{date: "2024-12-01", amount: 500}], vehicle: {value: 10000, kind: "bike"}, age: 21, experience: 1, recentClaims: 1, baseRate: 0.05, ageFactor: 1.5, claimFactor: 1.2, premium: 1125}},
    ],
    [
      {driver: {dob: "1950-01-01", licensed: "1970-01-01", claims: [{date: "2020-01-01", amount: 1}, {date: "2023-01-01", amount: 2}, {date: "2024-01-01", amount: 3}], vehicle: {value: 30000, kind: "van"}}},
      {driver: {dob: "1950-01-01", licensed: "1970-01-01", claims: [{date: "2020-01-01", amount: 1}, {date: "2023-01-01", amount: 2}, {date: "2024-01-01", amount: 3}], vehicle: {value: 30000, kind: "van"}, age: 75, experience: 55, recentClaims: 2, baseRate: 0.04, ageFactor: 1.3, claimFactor: 1.6, premium: 2496}},
    ],
    [{driver: {dob: "1980-01-01", licensed: "2000-01-01", claims: [], vehicle: {value: 1, kind: "truck"}}}, "!error: InputValidationFailed"],
    [{driver: {dob: "1980-01-01", licensed: "2000-01-01", claims: []}}, "!error: MissingRequiredInputs"],
  ],
}

// --- Realistic: subscription billing with globals ------------------------------------------------

{
  name: "subscription billing with global settings",
  policy: {
    globals: {platform: {vatRate: "number", trialDays: "number"}},
    models: {sub: {started: "date", seats: "number", plan: "string(basic|pro|enterprise)", annual: "boolean"}},
    blocks: [
      {expression: "sub.inTrial", value: "d().diff(sub.started, 'day') < trialDays"},
      {table: "prices", inputs: ["sub.plan"], outputs: ["sub.seatPrice"], rules: [["'basic'", "5"], ["'pro'", "12"], ["'enterprise'", "30"]]},
      {expression: "sub.monthly", value: "sub.inTrial ? 0 : sub.seats * sub.seatPrice * (sub.annual ? 0.8 : 1)"},
      {expression: "sub.vat", value: "round(sub.monthly * vatRate, 2)"},
      {expression: "sub.invoice", value: "sub.monthly + sub.vat"},
    ],
  },
  cases: [
    [
      {vatRate: 0.25, trialDays: 14, sub: {started: "2025-03-10", seats: 10, plan: "pro", annual: false}},
      {vatRate: 0.25, trialDays: 14, sub: {started: "2025-03-10", seats: 10, plan: "pro", annual: false, inTrial: true, seatPrice: 12, monthly: 0, vat: 0, invoice: 0}},
    ],
    [
      {vatRate: 0.25, trialDays: 14, sub: {started: "2025-01-01", seats: 10, plan: "pro", annual: false}},
      {vatRate: 0.25, trialDays: 14, sub: {started: "2025-01-01", seats: 10, plan: "pro", annual: false, inTrial: false, seatPrice: 12, monthly: 120, vat: 30, invoice: 150}},
    ],
    [
      {vatRate: 0.19, trialDays: 0, sub: {started: "2025-03-20", seats: 3, plan: "enterprise", annual: true}},
      {vatRate: 0.19, trialDays: 0, sub: {started: "2025-03-20", seats: 3, plan: "enterprise", annual: true, inTrial: false, seatPrice: 30, monthly: 72, vat: 13.68, invoice: 85.68}},
    ],
    [
      {vatRate: 0, trialDays: 30, sub: {started: "2024-01-01", seats: 1, plan: "basic", annual: true}},
      {vatRate: 0, trialDays: 30, sub: {started: "2024-01-01", seats: 1, plan: "basic", annual: true, inTrial: false, seatPrice: 5, monthly: 4, vat: 0, invoice: 4}},
    ],
    [{trialDays: 30, sub: {started: "2024-01-01", seats: 1, plan: "basic", annual: true}}, "!error: MissingRequiredInputs"],
  ],
}
