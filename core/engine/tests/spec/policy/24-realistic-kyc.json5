      {business: {name: "Pp", country: "SE", incorporated: "2001-01-01", structure: "simple", owners: [
        {name: "A", share: 90, pep: false, country: "SE", verified: true, ubo: true, pending: false},
        {name: "B", share: 10, pep: true, country: "SE", verified: false, ubo: false, pending: false},
      ], ubos: ["A"], declared: 100, yearsActive: 24, foreignUbo: false, pendingUbos: 0, reasons: [], decision: "approved"}},
