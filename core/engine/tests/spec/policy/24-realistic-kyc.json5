// Realistic know-your-customer policies: document checks, individual risk scoring, sanctions and
// PEP screening, business ownership (KYB), country profiles by reference, transaction monitoring,
// goals and dictionaries. Each suite combines several block kinds over related entities and runs
// valid, boundary, missing and invalid data. Evaluation time is fixed at 2025-03-20T10:15:30Z.

// --- Identity documents ------------------------------------------------------------------------
// Per-document computeds (expiry, identity kind, usability assertion) feed customer aggregates and
// a status match. A document without an expiry never expires; a member missing `verified` reads
// null and the assertion counts it as false.

{
  name: "kyc document checks",
  policy: {
    models: {
      customer: {country: "string", documents: "document[]"},
      document: {kind: "string(passport|idcard|license|utility)", expires: "date?", verified: "boolean", issuer: "string"},
    },
    blocks: [
      {expression: "document.expired", value: "(document.expires ?? d('9999-12-31')) < d()"},
      {expression: "document.identity", value: "document.kind != 'utility'"},
      {assertion: "document.usable", conditions: ["document.verified", "not document.expired"]},
      {expression: "customer.validIds", value: "count(customer.documents, #.usable and #.identity)"},
      {expression: "customer.addressProof", value: "some(customer.documents, #.kind == 'utility' and #.usable)"},
      {expression: "customer.foreignDocs", value: "count(customer.documents, #.issuer != customer.country)"},
      {match: "customer.docStatus", arms: [
        ["len(customer.documents) == 0", "'none'"],
        ["customer.validIds > 0 and customer.addressProof", "'complete'"],
        ["customer.validIds > 0", "'address-missing'"],
        ["", "'id-missing'"],
      ]},
    ],
  },
  cases: [
    [
      {customer: {country: "NO", documents: [{kind: "passport", expires: "2030-01-01", verified: true, issuer: "NO"}, {kind: "utility", verified: true, issuer: "NO"}]}},
      {customer: {country: "NO", validIds: 1, addressProof: true, foreignDocs: 0, docStatus: "complete", documents: [
        {kind: "passport", expires: "2030-01-01", verified: true, issuer: "NO", expired: false, identity: true, usable: true},
        {kind: "utility", verified: true, issuer: "NO", expired: false, identity: false, usable: true},
      ]}},
    ],
    [
      {customer: {country: "NO", documents: [{kind: "passport", expires: "2025-03-19", verified: true, issuer: "NO"}]}},
      {customer: {country: "NO", validIds: 0, addressProof: false, foreignDocs: 0, docStatus: "id-missing", documents: [
        {kind: "passport", expires: "2025-03-19", verified: true, issuer: "NO", expired: true, identity: true, usable: false},
      ]}},
    ],
    // Expiry boundary: a date-only expiry is midnight, so today's date is already expired.
    [
      {customer: {country: "NO", documents: [{kind: "idcard", expires: "2025-03-20", verified: true, issuer: "NO"}, {kind: "license", expires: "2025-03-21", verified: true, issuer: "SE"}]}},
      {customer: {country: "NO", validIds: 1, addressProof: false, foreignDocs: 1, docStatus: "address-missing", documents: [
        {kind: "idcard", expires: "2025-03-20", verified: true, issuer: "NO", expired: true, identity: true, usable: false},
        {kind: "license", expires: "2025-03-21", verified: true, issuer: "SE", expired: false, identity: true, usable: true},
      ]}},
    ],
    [
      {customer: {country: "NO", documents: [{kind: "passport", expires: "2025-03-20T10:15:31Z", verified: true, issuer: "NO"}]}},
      {customer: {country: "NO", validIds: 1, addressProof: false, foreignDocs: 0, docStatus: "address-missing", documents: [
        {kind: "passport", expires: "2025-03-20T10:15:31Z", verified: true, issuer: "NO", expired: false, identity: true, usable: true},
      ]}},
    ],
    [{customer: {country: "SE", documents: []}}, {customer: {country: "SE", documents: [], validIds: 0, addressProof: false, foreignDocs: 0, docStatus: "none"}}],
    [
      {customer: {country: "DE", documents: [{kind: "passport", expires: "2031-01-01", verified: false, issuer: "DE"}, {kind: "utility", verified: true, issuer: "DE"}]}},
      {customer: {country: "DE", validIds: 0, addressProof: true, foreignDocs: 0, docStatus: "id-missing", documents: [
        {kind: "passport", expires: "2031-01-01", verified: false, issuer: "DE", expired: false, identity: true, usable: false},
        {kind: "utility", verified: true, issuer: "DE", expired: false, identity: false, usable: true},
      ]}},
    ],
    [
      {customer: {country: "DE", documents: [{kind: "passport", expires: null, verified: true, issuer: "FR"}]}},
      {customer: {country: "DE", validIds: 1, addressProof: false, foreignDocs: 1, docStatus: "address-missing", documents: [
        {kind: "passport", expires: null, verified: true, issuer: "FR", expired: false, identity: true, usable: true},
      ]}},
    ],
    [
      {customer: {country: "NO", documents: [
        {kind: "passport", expires: "2029-01-01", verified: true, issuer: "NO"},
        {kind: "passport", expires: "2028-01-01", verified: true, issuer: "GB"},
        {kind: "utility", expires: "2025-01-01", verified: true, issuer: "NO"},
      ]}},
      {customer: {country: "NO", validIds: 2, addressProof: false, foreignDocs: 1, docStatus: "address-missing", documents: [
        {kind: "passport", expires: "2029-01-01", verified: true, issuer: "NO", expired: false, identity: true, usable: true},
        {kind: "passport", expires: "2028-01-01", verified: true, issuer: "GB", expired: false, identity: true, usable: true},
        {kind: "utility", expires: "2025-01-01", verified: true, issuer: "NO", expired: true, identity: false, usable: false},
      ]}},
    ],
    [
      {customer: {country: "NO", documents: [{kind: "passport", expires: "2030-01-01", issuer: "NO"}]}},
      {customer: {country: "NO", validIds: 0, addressProof: false, foreignDocs: 0, docStatus: "id-missing", documents: [
        {kind: "passport", expires: "2030-01-01", issuer: "NO", expired: false, identity: true, usable: false},
      ]}},
    ],
    [{customer: {country: "NO", documents: [{kind: "selfie", verified: true, issuer: "NO"}]}}, "!error: InputValidationFailed"],
    [{customer: {country: "NO", documents: [{kind: "passport", expires: "31/12/2030", verified: true, issuer: "NO"}]}}, "!error: InputValidationFailed"],
    [{customer: {country: "NO", documents: [{kind: "passport", verified: "yes", issuer: "NO"}]}}, "!error: InputValidationFailed"],
    [{customer: {country: "NO"}}, "!error: MissingRequiredInputs"],
    [{customer: {documents: []}}, "!error: MissingRequiredInputs"],
  ],
}

// The natural guard `expires != null and expires < d()` is rejected by the type checker: the
// `!= null` test does not narrow the optional date for the right operand. The workspace path
// still evaluates it correctly.
{
  name: "null-guarded optional expiry",
  diagnostics: ["TYPE_MISMATCH"],
  policy: {
    models: {customer: {documents: "document[]"}, document: {expires: "date?"}},
    blocks: [
      {expression: "document.expired", value: "document.expires != null and document.expires < d()"},
      {expression: "customer.anyExpired", value: "some(customer.documents, #.expired)"},
    ],
  },
  cases: [
    {
      input: {customer: {documents: [{expires: "2020-01-01"}, {expires: null}, {}]}},
      output: {customer: {anyExpired: true, documents: [{expires: "2020-01-01", expired: true}, {expires: null, expired: false}, {expired: false}]}},
      note: "question: `x != null and x < d()` is a TYPE_MISMATCH error, so DecisionEngine refuses the policy; the left operand guards the right one, so narrowing looks intended",
    },
    [{customer: {documents: [{expires: "2030-01-01"}]}}, {customer: {anyExpired: false, documents: [{expires: "2030-01-01", expired: false}]}}],
    [{customer: {documents: []}}, {customer: {anyExpired: false, documents: []}}],
  ],
}

// --- Individual risk scoring ---------------------------------------------------------------------
// Country risk from a table with list cells, occupation risk from a match, volume points from a
// nested conditional, an optional cash share defaulted with `??`, then a tier match, a review
// table with two scalar outputs and an onboarding assertion.

{
  name: "individual risk scoring",
  policy: {
    models: {
      customer: {dob: "date", country: "string", pep: "boolean", occupation: "string(salaried|self|student|retired|cash)", monthlyVolume: "number", cashShare: "number?"},
    },
    blocks: [
      {expression: "customer.age", value: "d().diff(customer.dob, 'year')"},
      {table: "countryRisk", inputs: ["customer.country"], outputs: ["customer.countryRisk"], rules: [
        ["'NO', 'SE', 'DK', 'FI'", "1"],
        ["'DE', 'FR', 'NL', 'GB'", "2"],
        ["'IR', 'KP', 'SY'", "10"],
        ["", "5"],
      ]},
      {match: "customer.occupationRisk", arms: [
        ["customer.occupation == 'cash'", "4"],
        ["customer.occupation == 'self'", "2"],
        ["customer.occupation == 'student'", "1"],
        ["", "0"],
      ]},
      {expression: "customer.volumePoints", value: "customer.monthlyVolume > 50000 ? 15 : customer.monthlyVolume > 10000 ? 5 : 0"},
      {expression: "customer.score", value: "customer.countryRisk * 5 + customer.occupationRisk * 5 + (customer.pep ? 30 : 0) + customer.volumePoints + ((customer.cashShare ?? 0) > 0.5 ? 10 : 0) + (customer.age < 21 ? 5 : 0)"},
      {match: "customer.riskTier", arms: [
        ["customer.countryRisk >= 10", "'prohibited'"],
        ["customer.score >= 50", "'high'"],
        ["customer.score >= 25", "'medium'"],
        ["", "'low'"],
      ]},
      {table: "review", inputs: ["customer.riskTier"], outputs: ["customer.reviewMonths", "customer.edd"], rules: [
        ["'prohibited'", "0", "true"],
        ["'high'", "12", "true"],
        ["'medium'", "24", "false"],
        ["'low'", "36", "false"],
      ]},
      {assertion: "customer.onboard", conditions: ["customer.age >= 18", "customer.riskTier != 'prohibited'"]},
    ],
  },
  cases: [
    [
      {customer: {dob: "1985-06-15", country: "NO", pep: false, occupation: "salaried", monthlyVolume: 3000}},
      {customer: {dob: "1985-06-15", country: "NO", pep: false, occupation: "salaried", monthlyVolume: 3000, age: 39, countryRisk: 1, occupationRisk: 0, volumePoints: 0, score: 5, riskTier: "low", reviewMonths: 36, edd: false, onboard: true}},
    ],
    [
      {customer: {dob: "2005-01-01", country: "SE", pep: false, occupation: "student", monthlyVolume: 12000, cashShare: 0.2}},
      {customer: {dob: "2005-01-01", country: "SE", pep: false, occupation: "student", monthlyVolume: 12000, cashShare: 0.2, age: 20, countryRisk: 1, occupationRisk: 1, volumePoints: 5, score: 20, riskTier: "low", reviewMonths: 36, edd: false, onboard: true}},
    ],
    [
      {customer: {dob: "1970-03-20", country: "DE", pep: true, occupation: "self", monthlyVolume: 60000, cashShare: 0.6}},
      {customer: {dob: "1970-03-20", country: "DE", pep: true, occupation: "self", monthlyVolume: 60000, cashShare: 0.6, age: 55, countryRisk: 2, occupationRisk: 2, volumePoints: 15, score: 75, riskTier: "high", reviewMonths: 12, edd: true, onboard: true}},
    ],
    [
      {customer: {dob: "1990-01-01", country: "IR", pep: false, occupation: "salaried", monthlyVolume: 100}},
      {customer: {dob: "1990-01-01", country: "IR", pep: false, occupation: "salaried", monthlyVolume: 100, age: 35, countryRisk: 10, occupationRisk: 0, volumePoints: 0, score: 50, riskTier: "prohibited", reviewMonths: 0, edd: true, onboard: false}},
    ],
    [
      {customer: {dob: "2008-01-01", country: "NO", pep: false, occupation: "salaried", monthlyVolume: 0}},
      {customer: {dob: "2008-01-01", country: "NO", pep: false, occupation: "salaried", monthlyVolume: 0, age: 17, countryRisk: 1, occupationRisk: 0, volumePoints: 0, score: 10, riskTier: "low", reviewMonths: 36, edd: false, onboard: false}},
    ],
    [
      {customer: {dob: "1980-01-01", country: "US", pep: false, occupation: "cash", monthlyVolume: 20000, cashShare: null}},
      {customer: {dob: "1980-01-01", country: "US", pep: false, occupation: "cash", monthlyVolume: 20000, cashShare: null, age: 45, countryRisk: 5, occupationRisk: 4, volumePoints: 5, score: 50, riskTier: "high", reviewMonths: 12, edd: true, onboard: true}},
    ],
    // Strict thresholds: 10000 earns no volume points and a cash share of exactly 0.5 none either.
    [
      {customer: {dob: "1980-01-01", country: "BR", pep: false, occupation: "salaried", monthlyVolume: 10000, cashShare: 0.5}},
      {customer: {dob: "1980-01-01", country: "BR", pep: false, occupation: "salaried", monthlyVolume: 10000, cashShare: 0.5, age: 45, countryRisk: 5, occupationRisk: 0, volumePoints: 0, score: 25, riskTier: "medium", reviewMonths: 24, edd: false, onboard: true}},
    ],
    [
      {customer: {dob: "1960-01-01", country: "FR", pep: true, occupation: "retired", monthlyVolume: 50000}},
      {customer: {dob: "1960-01-01", country: "FR", pep: true, occupation: "retired", monthlyVolume: 50000, age: 65, countryRisk: 2, occupationRisk: 0, volumePoints: 5, score: 45, riskTier: "medium", reviewMonths: 24, edd: false, onboard: true}},
    ],
    // Country codes are case-sensitive: `kp` falls to the default row.
    [
      {customer: {dob: "1999-03-21", country: "kp", pep: false, occupation: "salaried", monthlyVolume: -5}},
      {customer: {dob: "1999-03-21", country: "kp", pep: false, occupation: "salaried", monthlyVolume: -5, age: 25, countryRisk: 5, occupationRisk: 0, volumePoints: 0, score: 25, riskTier: "medium", reviewMonths: 24, edd: false, onboard: true}},
    ],
    [
      {customer: {dob: "2004-03-21", country: "SE", pep: false, occupation: "salaried", monthlyVolume: 0}},
      {customer: {dob: "2004-03-21", country: "SE", pep: false, occupation: "salaried", monthlyVolume: 0, age: 20, countryRisk: 1, occupationRisk: 0, volumePoints: 0, score: 10, riskTier: "low", reviewMonths: 36, edd: false, onboard: true}},
    ],
    [{customer: {dob: "1980-01-01", country: "NO", pep: false, occupation: "banker", monthlyVolume: 0}}, "!error: InputValidationFailed"],
    [{customer: {dob: "1980-01-01", country: "NO", occupation: "salaried", monthlyVolume: 0}}, "!error: MissingRequiredInputs"],
    [{customer: {dob: "1980-01-01", country: "NO", pep: false, occupation: "salaried", monthlyVolume: 0, cashShare: "high"}}, "!error: InputValidationFailed"],
    [{customer: {dob: "1980-01-01", country: "NO", pep: null, occupation: "salaried", monthlyVolume: 0}}, "!error: MissingRequiredInputs"],
  ],
}

// --- Sanctions and PEP screening -----------------------------------------------------------------
// Screening hits are members: a per-hit match grades the hit (an optional date-of-birth match
// lifts a near-certain hit to exact), a per-hit flag marks relevant ones, customer aggregates
// count them, a first-hit table with a `[]` column collects every applicable flag, and a final
// match routes the case.

{
  name: "sanctions and pep screening",
  policy: {
    models: {
      customer: {name: "string", pep: "boolean", hits: "hit[]"},
      hit: {list: "string(OFAC|EU|UN|PEP|MEDIA)", score: "number", dobMatch: "boolean?"},
    },
    blocks: [
      {match: "hit.strength", arms: [
        ["hit.score >= 0.95 and (hit.dobMatch ?? false)", "'exact'"],
        ["hit.score >= 0.85", "'strong'"],
        ["hit.score >= 0.7", "'weak'"],
        ["", "'noise'"],
      ]},
      {expression: "hit.relevant", value: "hit.strength in ['exact', 'strong']"},
      {expression: "customer.sanctionHits", value: "count(customer.hits, #.relevant and #.list in ['OFAC', 'EU', 'UN'])"},
      {expression: "customer.pepConfirmed", value: "customer.pep or some(customer.hits, #.list == 'PEP' and #.relevant)"},
      {expression: "customer.adverseMedia", value: "count(customer.hits, #.list == 'MEDIA' and #.strength != 'noise')"},
      {expression: "customer.weakHits", value: "count(customer.hits, #.strength == 'weak')"},
      {table: "flags", inputs: ["customer.sanctionHits", "customer.pepConfirmed", "customer.adverseMedia"], outputs: ["customer.flags[]"], rules: [
        ["> 0", "", "", "'sanctions'"],
        ["", "true", "", "'pep'"],
        ["", "", "> 0", "'adverse-media'"],
      ]},
      {match: "customer.screening", arms: [
        ["customer.sanctionHits > 0", "'blocked'"],
        ["customer.pepConfirmed or customer.adverseMedia > 0", "'edd'"],
        ["customer.weakHits > 0", "'review'"],
        ["", "'clear'"],
      ]},
    ],
  },
  cases: [
    [
      {customer: {name: "Kari", pep: false, hits: []}},
      {customer: {name: "Kari", pep: false, hits: [], sanctionHits: 0, pepConfirmed: false, adverseMedia: 0, weakHits: 0, flags: [], screening: "clear"}},
    ],
    [
      {customer: {name: "Ivan", pep: false, hits: [{list: "OFAC", score: 0.97, dobMatch: true}]}},
      {customer: {name: "Ivan", pep: false, hits: [{list: "OFAC", score: 0.97, dobMatch: true, strength: "exact", relevant: true}], sanctionHits: 1, pepConfirmed: false, adverseMedia: 0, weakHits: 0, flags: ["sanctions"], screening: "blocked"}},
    ],
    [
      {customer: {name: "Ivan", pep: false, hits: [{list: "OFAC", score: 0.97, dobMatch: false}]}},
      {customer: {name: "Ivan", pep: false, hits: [{list: "OFAC", score: 0.97, dobMatch: false, strength: "strong", relevant: true}], sanctionHits: 1, pepConfirmed: false, adverseMedia: 0, weakHits: 0, flags: ["sanctions"], screening: "blocked"}},
    ],
    [
      {customer: {name: "Eva", pep: false, hits: [{list: "EU", score: 0.8}]}},
      {customer: {name: "Eva", pep: false, hits: [{list: "EU", score: 0.8, strength: "weak", relevant: false}], sanctionHits: 0, pepConfirmed: false, adverseMedia: 0, weakHits: 1, flags: [], screening: "review"}},
    ],
    [
      {customer: {name: "Per", pep: false, hits: [{list: "PEP", score: 0.9}]}},
      {customer: {name: "Per", pep: false, hits: [{list: "PEP", score: 0.9, strength: "strong", relevant: true}], sanctionHits: 0, pepConfirmed: true, adverseMedia: 0, weakHits: 0, flags: ["pep"], screening: "edd"}},
    ],
    [
      {customer: {name: "Min", pep: true, hits: []}},
      {customer: {name: "Min", pep: true, hits: [], sanctionHits: 0, pepConfirmed: true, adverseMedia: 0, weakHits: 0, flags: ["pep"], screening: "edd"}},
    ],
    [
      {customer: {name: "Ola", pep: false, hits: [{list: "MEDIA", score: 0.72}, {list: "UN", score: 0.5}]}},
      {customer: {name: "Ola", pep: false, hits: [{list: "MEDIA", score: 0.72, strength: "weak", relevant: false}, {list: "UN", score: 0.5, strength: "noise", relevant: false}], sanctionHits: 0, pepConfirmed: false, adverseMedia: 1, weakHits: 1, flags: ["adverse-media"], screening: "edd"}},
    ],
    // A null date-of-birth match defaults to false: 0.95 is only strong. Every flag is collected.
    [
      {customer: {name: "Ana", pep: false, hits: [{list: "OFAC", score: 0.95, dobMatch: null}, {list: "PEP", score: 0.99, dobMatch: true}, {list: "MEDIA", score: 0.69}, {list: "MEDIA", score: 1}]}},
      {customer: {name: "Ana", pep: false, hits: [
        {list: "OFAC", score: 0.95, dobMatch: null, strength: "strong", relevant: true},
        {list: "PEP", score: 0.99, dobMatch: true, strength: "exact", relevant: true},
        {list: "MEDIA", score: 0.69, strength: "noise", relevant: false},
        {list: "MEDIA", score: 1, strength: "strong", relevant: true},
      ], sanctionHits: 1, pepConfirmed: true, adverseMedia: 1, weakHits: 0, flags: ["sanctions", "pep", "adverse-media"], screening: "blocked"}},
    ],
    [
      {customer: {name: "Bo", pep: false, hits: [{list: "UN", score: 0.85}, {list: "EU", score: 0.8499}]}},
      {customer: {name: "Bo", pep: false, hits: [{list: "UN", score: 0.85, strength: "strong", relevant: true}, {list: "EU", score: 0.8499, strength: "weak", relevant: false}], sanctionHits: 1, pepConfirmed: false, adverseMedia: 0, weakHits: 1, flags: ["sanctions"], screening: "blocked"}},
    ],
    [
      {customer: {name: "Bo", pep: false, hits: [{list: "EU", score: 0.7}, {list: "PEP", score: 0.6999}]}},
      {customer: {name: "Bo", pep: false, hits: [{list: "EU", score: 0.7, strength: "weak", relevant: false}, {list: "PEP", score: 0.6999, strength: "noise", relevant: false}], sanctionHits: 0, pepConfirmed: false, adverseMedia: 0, weakHits: 1, flags: [], screening: "review"}},
    ],
    [{customer: {name: "X", pep: false, hits: [{list: "INTERPOL", score: 0.99}]}}, "!error: InputValidationFailed"],
    [{customer: {name: "X", pep: false, hits: [{list: "EU", score: "0.9"}]}}, "!error: InputValidationFailed"],
    [{customer: {name: "X", pep: false, hits: [{list: "EU"}]}}, "!error: ExpressionFailed"],
    [{customer: {name: "X", pep: false}}, "!error: MissingRequiredInputs"],
    [{customer: {name: "X", hits: []}}, "!error: MissingRequiredInputs"],
  ],
}

// --- Business ownership (KYB) --------------------------------------------------------------------
// Owners are members: per-owner UBO and pending flags, business aggregates over computed member
// properties, a reasons table collecting across three inputs (list cell over an enum), and a
// decision match whose arms read member computeds through closures.

{
  name: "business kyb with beneficial owners",
  policy: {
    models: {
      business: {name: "string", country: "string", incorporated: "date", structure: "string(simple|layered|trust)", owners: "owner[]"},
      owner: {name: "string", share: "number", pep: "boolean", country: "string", verified: "boolean"},
    },
    blocks: [
      {expression: "owner.ubo", value: "owner.share >= 25"},
      {expression: "owner.pending", value: "owner.ubo and not owner.verified"},
      {expression: "business.ubos", value: "map(filter(business.owners, #.ubo), #.name)"},
      {expression: "business.declared", value: "sum(map(business.owners, #.share))"},
      {expression: "business.yearsActive", value: "d().diff(business.incorporated, 'year')"},
      {expression: "business.foreignUbo", value: "some(business.owners, #.ubo and #.country != business.country)"},
      {expression: "business.pendingUbos", value: "count(business.owners, #.pending)"},
      {table: "reasons", inputs: ["business.declared", "business.structure", "business.yearsActive"], outputs: ["business.reasons[]"], rules: [
        ["< 75", "", "", "'ownership-incomplete'"],
        ["> 100", "", "", "'ownership-overstated'"],
        ["", "'trust', 'layered'", "", "'complex-structure'"],
        ["", "", "< 2", "'newly-incorporated'"],
      ]},
      {match: "business.decision", arms: [
        ["some(business.owners, #.pep and #.ubo)", "'edd'"],
        ["business.pendingUbos > 0", "'awaiting-documents'"],
        ["len(business.reasons) > 0", "'manual-review'"],
        ["", "'approved'"],
      ]},
    ],
  },
  cases: [
    [
      {business: {name: "Acme", country: "NO", incorporated: "2010-05-01", structure: "simple", owners: [
        {name: "A", share: 60, pep: false, country: "NO", verified: true},
        {name: "B", share: 40, pep: false, country: "NO", verified: true},
      ]}},
      {business: {name: "Acme", country: "NO", incorporated: "2010-05-01", structure: "simple", owners: [
        {name: "A", share: 60, pep: false, country: "NO", verified: true, ubo: true, pending: false},
        {name: "B", share: 40, pep: false, country: "NO", verified: true, ubo: true, pending: false},
      ], ubos: ["A", "B"], declared: 100, yearsActive: 14, foreignUbo: false, pendingUbos: 0, reasons: [], decision: "approved"}},
    ],
    [
      {business: {name: "Acme", country: "NO", incorporated: "2010-05-01", structure: "simple", owners: [
        {name: "A", share: 60, pep: false, country: "NO", verified: true},
        {name: "B", share: 40, pep: false, country: "NO", verified: false},
      ]}},
      {business: {name: "Acme", country: "NO", incorporated: "2010-05-01", structure: "simple", owners: [
        {name: "A", share: 60, pep: false, country: "NO", verified: true, ubo: true, pending: false},
        {name: "B", share: 40, pep: false, country: "NO", verified: false, ubo: true, pending: true},
      ], ubos: ["A", "B"], declared: 100, yearsActive: 14, foreignUbo: false, pendingUbos: 1, reasons: [], decision: "awaiting-documents"}},
