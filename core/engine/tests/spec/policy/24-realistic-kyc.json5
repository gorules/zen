      {business: {name: "Fan", country: "NO", incorporated: "2015-01-01", structure: "layered", owners: [
        {name: "A", share: 20, pep: false, country: "NO", verified: true},
        {name: "B", share: 20, pep: false, country: "NO", verified: true},
        {name: "C", share: 20, pep: false, country: "NO", verified: false},
        {name: "D", share: 20, pep: false, country: "NO", verified: true},
        {name: "E", share: 20, pep: false, country: "NO", verified: true},
