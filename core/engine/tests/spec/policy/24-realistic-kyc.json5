    ],
    // A PEP below the UBO threshold does not trigger enhanced due diligence.
    [
      {business: {name: "Pp", country: "SE", incorporated: "2001-01-01", structure: "simple", owners: [
        {name: "A", share: 90, pep: false, country: "SE", verified: true},
        {name: "B", share: 10, pep: true, country: "SE", verified: false},
