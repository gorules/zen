      {business: {name: "New", country: "NO", incorporated: "2023-03-21", structure: "simple", owners: [{name: "A", share: 100, pep: false, country: "NO", verified: true}]}},
      {business: {name: "New", country: "NO", incorporated: "2023-03-21", structure: "simple", owners: [
        {name: "A", share: 100, pep: false, country: "NO", verified: true, ubo: true, pending: false},
      ], ubos: ["A"], declared: 100, yearsActive: 1, foreignUbo: false, pendingUbos: 0, reasons: ["newly-incorporated"], decision: "manual-review"}},
    ],
    [{business: {name: "X", country: "NO", incorporated: "2000-01-01", structure: "partnership", owners: []}}, "!error: InputValidationFailed"],
    [{business: {name: "X", country: "NO", incorporated: "2000-01-01", structure: "simple", owners: [{name: "A", share: "50%", pep: false, country: "NO", verified: true}]}}, "!error: InputValidationFailed"],
    [{business: {name: "X", country: "NO", incorporated: "2000-01-01", structure: "simple", owners: [{name: "A", pep: false, country: "NO", verified: true}]}}, "!error: ExpressionFailed"],
    [{business: {name: "X", country: "NO", incorporated: "2000-01-01", structure: "simple"}}, "!error: MissingRequiredInputs"],
    [{business: {name: "X", country: "NO", structure: "simple", owners: []}}, "!error: MissingRequiredInputs"],
  ],
}

// --- Country profiles by reference ---------------------------------------------------------------
// Nationality and residence are references into a `country` pool; a global sets the enhanced due
// diligence threshold. The assertion is `score >= threshold or fatfExposure`.

{
  name: "geographic risk from referenced country profiles",
  policy: {
    globals: {settings: {eddScore: "number"}},
    models: {
      customer: {name: "string", nationality: "&country", residence: "&country"},
      country: {id: "string", risk: "number", fatf: "boolean"},
    },
    blocks: [
      {expression: "customer.geoRisk", value: "max([customer.nationality.risk, customer.residence.risk])"},
      {expression: "customer.fatfExposure", value: "customer.nationality.fatf or customer.residence.fatf"},
      {expression: "customer.crossBorder", value: "customer.nationality.id != customer.residence.id"},
      {expression: "customer.score", value: "customer.geoRisk * 10 + (customer.fatfExposure ? 25 : 0) + (customer.crossBorder ? 5 : 0)"},
      {assertion: "customer.edd", conditions: [["or", "customer.score >= eddScore", 0], "customer.fatfExposure"]},
    ],
  },
  cases: [
    [
      {eddScore: 40, customer: {name: "a", nationality: "NO", residence: "NO"}, country: [{id: "NO", risk: 1, fatf: false}, {id: "IR", risk: 9, fatf: true}, {id: "AE", risk: 4, fatf: false}]},
      {eddScore: 40, customer: {name: "a", nationality: {id: "NO", risk: 1, fatf: false}, residence: {id: "NO", risk: 1, fatf: false}, geoRisk: 1, fatfExposure: false, crossBorder: false, score: 10, edd: false}, country: [{id: "NO", risk: 1, fatf: false}, {id: "IR", risk: 9, fatf: true}, {id: "AE", risk: 4, fatf: false}]},
    ],
    [
      {eddScore: 40, customer: {name: "b", nationality: "NO", residence: "AE"}, country: [{id: "NO", risk: 1, fatf: false}, {id: "AE", risk: 4, fatf: false}]},
      {eddScore: 40, customer: {name: "b", nationality: {id: "NO", risk: 1, fatf: false}, residence: {id: "AE", risk: 4, fatf: false}, geoRisk: 4, fatfExposure: false, crossBorder: true, score: 45, edd: true}, country: [{id: "NO", risk: 1, fatf: false}, {id: "AE", risk: 4, fatf: false}]},
    ],
    [
      {eddScore: 40, customer: {name: "c", nationality: "IR", residence: "NO"}, country: [{id: "NO", risk: 1, fatf: false}, {id: "IR", risk: 9, fatf: true}]},
      {eddScore: 40, customer: {name: "c", nationality: {id: "IR", risk: 9, fatf: true}, residence: {id: "NO", risk: 1, fatf: false}, geoRisk: 9, fatfExposure: true, crossBorder: true, score: 120, edd: true}, country: [{id: "NO", risk: 1, fatf: false}, {id: "IR", risk: 9, fatf: true}]},
    ],
    // FATF exposure alone triggers EDD even when the score is under the threshold.
    [
      {eddScore: 200, customer: {name: "d", nationality: "IR", residence: "IR"}, country: [{id: "IR", risk: 9, fatf: true}]},
      {eddScore: 200, customer: {name: "d", nationality: {id: "IR", risk: 9, fatf: true}, residence: {id: "IR", risk: 9, fatf: true}, geoRisk: 9, fatfExposure: true, crossBorder: false, score: 115, edd: true}, country: [{id: "IR", risk: 9, fatf: true}]},
    ],
    [
      {eddScore: 40, customer: {name: "e", nationality: "AE", residence: "AE"}, country: [{id: "AE", risk: 4, fatf: false}]},
      {eddScore: 40, customer: {name: "e", nationality: {id: "AE", risk: 4, fatf: false}, residence: {id: "AE", risk: 4, fatf: false}, geoRisk: 4, fatfExposure: false, crossBorder: false, score: 40, edd: true}, country: [{id: "AE", risk: 4, fatf: false}]},
    ],
    [
      {eddScore: 40.5, customer: {name: "f", nationality: "AE", residence: "AE"}, country: [{id: "AE", risk: 4.05, fatf: false}]},
      {eddScore: 40.5, customer: {name: "f", nationality: {id: "AE", risk: 4.05, fatf: false}, residence: {id: "AE", risk: 4.05, fatf: false}, geoRisk: 4.05, fatfExposure: false, crossBorder: false, score: 40.5, edd: true}, country: [{id: "AE", risk: 4.05, fatf: false}]},
    ],
    [{eddScore: 40, customer: {name: "g", nationality: "XX", residence: "NO"}, country: [{id: "NO", risk: 1, fatf: false}]}, "!error: InputValidationFailed"],
    [{eddScore: 40, customer: {name: "g", nationality: 5, residence: "NO"}, country: [{id: "NO", risk: 1, fatf: false}]}, "!error: InputValidationFailed"],
    [{eddScore: 40, customer: {name: "g", nationality: "NO", residence: "NO"}, country: [{id: "NO", risk: "low", fatf: false}]}, "!error: InputValidationFailed"],
    [{eddScore: 40, customer: {name: "g", nationality: "NO"}, country: [{id: "NO", risk: 1, fatf: false}]}, "!error: MissingRequiredInputs"],
    [{customer: {name: "g", nationality: "NO", residence: "NO"}, country: [{id: "NO", risk: 1, fatf: false}]}, "!error: MissingRequiredInputs"],
    [{eddScore: 40, customer: {name: "g", nationality: "NO", residence: "NO"}}, "!error: InputValidationFailed"],
  ],
}

// --- Transaction monitoring ----------------------------------------------------------------------
// Per-transaction recency, near-threshold cash and corridor flags; account aggregates over recent
// inflows; a hit-policy `collect` table of alerts read by an action match.

{
  name: "transaction monitoring alerts",
  policy: {
    models: {
      account: {holder: "string", declaredMonthly: "number", txns: "txn[]"},
      txn: {amount: "number", at: "date", channel: "string(cash|wire|card)", direction: "string(in|out)", counterpartyCountry: "string?"},
    },
    blocks: [
      {expression: "txn.recent", value: "d().diff(txn.at, 'day') < 30"},
      {expression: "txn.nearThreshold", value: "txn.channel == 'cash' and txn.amount >= 9000 and txn.amount < 10000"},
      {expression: "txn.highRiskCorridor", value: "(txn.counterpartyCountry ?? '') in ['IR', 'KP', 'SY']"},
      {expression: "account.inflow30", value: "sum(map(filter(account.txns, #.recent and #.direction == 'in'), #.amount))"},
      {expression: "account.structuring", value: "count(account.txns, #.recent and #.nearThreshold) >= 3"},
      {expression: "account.volumeRatio", value: "account.declaredMonthly > 0 ? round(account.inflow30 / account.declaredMonthly, 2) : 0"},
      {expression: "account.corridors", value: "count(account.txns, #.highRiskCorridor)"},
      {table: "alerts", hit: "collect", inputs: ["account.structuring", "account.volumeRatio", "account.corridors"], outputs: ["account.alerts"], rules: [
        ["true", "", "", "'structuring'"],
        ["", "> 3", "", "'volume-spike'"],
        ["", "", "> 0", "'high-risk-corridor'"],
      ]},
      {match: "account.action", arms: [
        ["'structuring' in account.alerts or 'high-risk-corridor' in account.alerts", "'file-sar'"],
        ["len(account.alerts) > 0", "'investigate'"],
        ["", "'none'"],
      ]},
    ],
  },
  cases: [
    [
      {account: {holder: "a", declaredMonthly: 5000, txns: []}},
      {account: {holder: "a", declaredMonthly: 5000, txns: [], inflow30: 0, structuring: false, volumeRatio: 0, corridors: 0, alerts: [], action: "none"}},
    ],
    [
      {account: {holder: "b", declaredMonthly: 10000, txns: [
        {amount: 9500, at: "2025-03-10", channel: "cash", direction: "in"},
        {amount: 9500, at: "2025-03-12", channel: "cash", direction: "in"},
        {amount: 9500, at: "2025-03-15", channel: "cash", direction: "in"},
      ]}},
      {account: {holder: "b", declaredMonthly: 10000, txns: [
        {amount: 9500, at: "2025-03-10", channel: "cash", direction: "in", recent: true, nearThreshold: true, highRiskCorridor: false},
        {amount: 9500, at: "2025-03-12", channel: "cash", direction: "in", recent: true, nearThreshold: true, highRiskCorridor: false},
        {amount: 9500, at: "2025-03-15", channel: "cash", direction: "in", recent: true, nearThreshold: true, highRiskCorridor: false},
      ], inflow30: 28500, structuring: true, volumeRatio: 2.85, corridors: 0, alerts: ["structuring"], action: "file-sar"}},
    ],
    [
      {account: {holder: "c", declaredMonthly: 5000, txns: [
        {amount: 9500, at: "2025-03-10", channel: "cash", direction: "in"},
        {amount: 9500, at: "2025-03-12", channel: "cash", direction: "in"},
        {amount: 9500, at: "2025-01-01", channel: "cash", direction: "in"},
      ]}},
      {account: {holder: "c", declaredMonthly: 5000, txns: [
        {amount: 9500, at: "2025-03-10", channel: "cash", direction: "in", recent: true, nearThreshold: true, highRiskCorridor: false},
        {amount: 9500, at: "2025-03-12", channel: "cash", direction: "in", recent: true, nearThreshold: true, highRiskCorridor: false},
        {amount: 9500, at: "2025-01-01", channel: "cash", direction: "in", recent: false, nearThreshold: true, highRiskCorridor: false},
      ], inflow30: 19000, structuring: false, volumeRatio: 3.8, corridors: 0, alerts: ["volume-spike"], action: "investigate"}},
    ],
    [
      {account: {holder: "d", declaredMonthly: 1000, txns: [{amount: 50000, at: "2025-03-01", channel: "wire", direction: "out", counterpartyCountry: "IR"}]}},
      {account: {holder: "d", declaredMonthly: 1000, txns: [
        {amount: 50000, at: "2025-03-01", channel: "wire", direction: "out", counterpartyCountry: "IR", recent: true, nearThreshold: false, highRiskCorridor: true},
      ], inflow30: 0, structuring: false, volumeRatio: 0, corridors: 1, alerts: ["high-risk-corridor"], action: "file-sar"}},
    ],
    [
      {account: {holder: "e", declaredMonthly: 0, txns: [{amount: 100, at: "2025-03-19", channel: "card", direction: "in", counterpartyCountry: null}]}},
      {account: {holder: "e", declaredMonthly: 0, txns: [
        {amount: 100, at: "2025-03-19", channel: "card", direction: "in", counterpartyCountry: null, recent: true, nearThreshold: false, highRiskCorridor: false},
      ], inflow30: 100, structuring: false, volumeRatio: 0, corridors: 0, alerts: [], action: "none"}},
    ],
    // Near-threshold is [9000, 10000); a ratio that rounds to exactly 3 is not a spike.
    [
      {account: {holder: "f", declaredMonthly: 9667, txns: [
        {amount: 9000, at: "2025-03-18", channel: "cash", direction: "in"},
        {amount: 9999.99, at: "2025-03-18", channel: "cash", direction: "in"},
        {amount: 10000, at: "2025-03-18", channel: "cash", direction: "in"},
      ]}},
      {account: {holder: "f", declaredMonthly: 9667, txns: [
        {amount: 9000, at: "2025-03-18", channel: "cash", direction: "in", recent: true, nearThreshold: true, highRiskCorridor: false},
        {amount: 9999.99, at: "2025-03-18", channel: "cash", direction: "in", recent: true, nearThreshold: true, highRiskCorridor: false},
        {amount: 10000, at: "2025-03-18", channel: "cash", direction: "in", recent: true, nearThreshold: false, highRiskCorridor: false},
      ], inflow30: 28999.99, structuring: false, volumeRatio: 3, corridors: 0, alerts: [], action: "none"}},
    ],
    // Exactly 30 days ago is no longer recent; one second later still is.
    [
      {account: {holder: "g", declaredMonthly: 100, txns: [
        {amount: 100, at: "2025-02-18T10:15:30Z", channel: "card", direction: "in"},
        {amount: 100, at: "2025-02-18T10:15:31Z", channel: "card", direction: "in", counterpartyCountry: "SY"},
      ]}},
      {account: {holder: "g", declaredMonthly: 100, txns: [
        {amount: 100, at: "2025-02-18T10:15:30Z", channel: "card", direction: "in", recent: false, nearThreshold: false, highRiskCorridor: false},
        {amount: 100, at: "2025-02-18T10:15:31Z", channel: "card", direction: "in", counterpartyCountry: "SY", recent: true, nearThreshold: false, highRiskCorridor: true},
      ], inflow30: 100, structuring: false, volumeRatio: 1, corridors: 1, alerts: ["high-risk-corridor"], action: "file-sar"}},
    ],
    [
      {account: {holder: "h", declaredMonthly: 1000, txns: [
        {amount: 9100, at: "2025-03-01", channel: "cash", direction: "in"},
        {amount: 9200, at: "2025-03-02", channel: "cash", direction: "in"},
        {amount: 9300, at: "2025-03-03", channel: "cash", direction: "out"},
        {amount: 50, at: "2025-03-25", channel: "card", direction: "in", counterpartyCountry: "KP"},
      ]}},
      {account: {holder: "h", declaredMonthly: 1000, txns: [
        {amount: 9100, at: "2025-03-01", channel: "cash", direction: "in", recent: true, nearThreshold: true, highRiskCorridor: false},
        {amount: 9200, at: "2025-03-02", channel: "cash", direction: "in", recent: true, nearThreshold: true, highRiskCorridor: false},
        {amount: 9300, at: "2025-03-03", channel: "cash", direction: "out", recent: true, nearThreshold: true, highRiskCorridor: false},
        {amount: 50, at: "2025-03-25", channel: "card", direction: "in", counterpartyCountry: "KP", recent: true, nearThreshold: false, highRiskCorridor: true},
      ], inflow30: 18350, structuring: true, volumeRatio: 18.35, corridors: 1, alerts: ["structuring", "volume-spike", "high-risk-corridor"], action: "file-sar"}},
    ],
    [{account: {holder: "x", declaredMonthly: 1, txns: [{amount: 1, at: "2025-03-01", channel: "crypto", direction: "in"}]}}, "!error: InputValidationFailed"],
    [{account: {holder: "x", declaredMonthly: 1, txns: [{amount: 1, at: "2025-03-01", channel: "cash", direction: "sideways"}]}}, "!error: InputValidationFailed"],
    [{account: {holder: "x", declaredMonthly: 1, txns: [{at: "2025-03-01", channel: "cash", direction: "in"}]}}, "!error: ExpressionFailed"],
    [{account: {holder: "x", txns: []}}, "!error: MissingRequiredInputs"],
  ],
}

// --- Goals over a due-diligence summary ----------------------------------------------------------
// A goal evaluates only its cone: required inputs outside it may be missing.

{
  name: "cdd summary with goals",
  policy: {
    models: {customer: {age: "number", pep: "boolean", sanctioned: "boolean", docsValid: "boolean", country: "string"}},
    blocks: [
      {assertion: "customer.identityOk", conditions: ["customer.docsValid", "customer.age >= 18"]},
      {match: "customer.risk", arms: [
        ["customer.sanctioned", "'prohibited'"],
        ["customer.pep", "'high'"],
        ["customer.country in ['NO', 'SE']", "'low'"],
        ["", "'medium'"],
      ]},
      {table: "outcome", inputs: ["customer.identityOk", "customer.risk"], outputs: ["customer.outcome", "customer.reasons[]"], rules: [
        ["false", "", "'reject'", "'identity'"],
        ["", "'prohibited'", "'reject'", "'sanctions'"],
        ["", "'high'", "'refer'", "'pep'"],
        ["", "", "'accept'", ""],
      ]},
    ],
  },
  cases: [
    {input: {customer: {age: 17, docsValid: true}}, goals: ["customer.identityOk"], output: {customer: {age: 17, docsValid: true, identityOk: false}}},
    {input: {customer: {age: 40, docsValid: true}}, goals: ["customer.identityOk"], output: {customer: {age: 40, docsValid: true, identityOk: true}}},
    {input: {customer: {sanctioned: false, pep: false, country: "SE"}}, goals: ["customer.risk"], output: {customer: {sanctioned: false, pep: false, country: "SE", risk: "low"}}},
    {input: {customer: {sanctioned: true, pep: false, country: "US"}}, goals: ["customer.risk"], output: {customer: {sanctioned: true, pep: false, country: "US", risk: "prohibited"}}},
    {input: {customer: {age: 30}}, goals: ["customer.risk"], output: "!error: MissingRequiredInputs"},
    {
      input: {customer: {age: 30, docsValid: true, sanctioned: false, pep: true, country: "NO"}},
      goals: ["customer.outcome"],
      output: {customer: {age: 30, docsValid: true, sanctioned: false, pep: true, country: "NO", identityOk: true, risk: "high", outcome: "refer", reasons: ["pep"]}},
    },
    {
      input: {customer: {age: 16, docsValid: false, sanctioned: true, pep: true, country: "NO"}},
      output: {customer: {age: 16, docsValid: false, sanctioned: true, pep: true, country: "NO", identityOk: false, risk: "prohibited", outcome: "reject", reasons: ["identity", "sanctions"]}},
    },
    {
      input: {customer: {age: 50, docsValid: true, sanctioned: false, pep: false, country: "DE"}},
      output: {customer: {age: 50, docsValid: true, sanctioned: false, pep: false, country: "DE", identityOk: true, risk: "medium", outcome: "accept", reasons: []}},
    },
    {input: {customer: {age: 50, docsValid: true, sanctioned: false, pep: false}}, output: "!error: MissingRequiredInputs"},
  ],
}

// --- Dictionaries for country and document codes -------------------------------------------------
// Dictionary-typed codes are validated on input and behave as plain strings in blocks.

{
  name: "kyc codes from dictionaries",
  policy: {
    dictionaries: {
      isoCountry: ["NO", "SE", "DE", "IR", ["GB", "United Kingdom"]],
      docType: [["P", "Passport"], ["ID", "National id"], ["DL", "Driving licence"]],
    },
    models: {applicant: {nationality: "isoCountry", residence: "isoCountry", docType: "docType", secondDoc: "docType?"}},
    blocks: [
      {expression: "applicant.highRisk", value: "applicant.nationality == 'IR' or applicant.residence == 'IR'"},
      {match: "applicant.docWeight", arms: [["applicant.docType == 'P'", "3"], ["applicant.docType == 'ID'", "2"], ["", "1"]]},
      {expression: "applicant.evidence", value: "applicant.docWeight + (applicant.secondDoc == null ? 0 : 1)"},
      {assertion: "applicant.simplified", conditions: ["not applicant.highRisk", "applicant.evidence >= 3", "applicant.nationality == applicant.residence"]},
    ],
  },
