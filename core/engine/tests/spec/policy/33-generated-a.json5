{
  name: "a 48: account/loans: 1 assertion, 2 expression, 1 match, 4 table; 2 root, 9 per-member, 2 top-level computed",
  policy: {
    models: {account: {weight: "number", tier: "string(gold|silver|bronze)", kind: "string(retail|corporate)", days: "number", active: "boolean", region: "string", loans: "loan[]"}, loan: {score: "number?", country: "string"}},
    blocks: [
      {assertion: "health", conditions: [["and", "account.weight == account.weight", 1]]},
      {table: "t2", inputs: ["account.active"], outputs: ["loan.rank"], rules: [
        ["", "account.days"],
        ["true", "18"],
        ["false", "account.weight"],
        ["false", "account.days"],
        ["false", ""],
      ]},
      {table: "t3", inputs: ["account.active"], outputs: ["loan.review[]", "loan.capped"], rules: [
        ["", "(loan.rank ?? 0)", "loan.rank == null"],
        ["true", "(loan.rank ?? 0)", "health"],
        ["true", "max([account.weight, account.days])", "(health or health)"],
        ["", "account.weight", "health"],
        ["", "(loan.score ?? 0)", "some(account.loans, #.country in ['x', 'retail'])"],
      ]},
      {expression: "account.bucket", value: "account.days"},
      {expression: "points", value: "account.kind in ['corporate', 'retail']"},
      {match: "account.margin", arms: [["not (account.active)", "account.region"], ["18 > account.weight", "account.region"], ["none(account.loans, 10 <= (#.rank ?? 0))", "((points ? account.region : account.region) + '-' + account.region)"], ["", "account.region"]]},
      {table: "t7", hit: "collect", inputs: ["account.margin"], outputs: ["loan.share", "loan.band", "loan.level"], rules: [
        ["", "account.margin", "(loan.rank ?? 0)", "loan.country"],
        ["'A1', 'a'", "'none'", "18", "((loan.capped ?? false) ? 'VIP' : 'retail')"],
        ["", "account.region", "(loan.rank ?? 0)", "loan.country"],
        ["startsWith($, 'low')", "(loan.country + '-' + account.margin)", "(loan.score ?? 0)", "'retail'"],
        ["startsWith($, 'Oslo')", "(account.margin + '-' + 'Oslo')", "1.5", "account.region"],
      ]},
      {table: "t8", inputs: ["account.weight", "account.margin", "(account.weight + account.days)"], outputs: ["loan.summary", "loan.quota", "loan.net"], rules: [
        ["", "", "", "account.days", "", "(loan.score ?? 0) >= (loan.rank ?? 0)"],
        ["!= 1000", "", "!= 18", "50", "", "account.active"],
        ["", "'US', 'A1'", "!= 1000", "(loan.score ?? 0)", "18", "some(account.loans, contains(#.country, 'none'))"],
        ["[0..175]", "", "100", "account.days", "account.weight", "points"],
        ["<= 1.5", "", "250", "(loan.score ?? 0)", "", "health"],
        ["", "'ok'", "", "account.bucket", "(loan.rank ?? 0)", "len(loan.country) > 1"],
        ["", "", "", "account.weight", "round(account.weight, 2)", "points"],
      ]},
    ],
  },
