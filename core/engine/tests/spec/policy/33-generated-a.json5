  policy: {
    models: {account: {days: "number", label: "string?", income: "number", members: "member[]"}, member: {rate: "number", amount: "number", kind: "string(retail|corporate)?"}},
    globals: {settings: {baseRate: "number"}},
    blocks: [
      {match: "member.summary", arms: [["not (account.income >= account.days)", "not ((18 == 0.5 or account.days <= 10))"], ["10 > member.amount", "baseRate in [2..100]"], ["(member.kind ?? '') in ['retail', 'corporate']", "account.income in [16..207]"], ["(member.kind ?? '') != 'corporate'", "member.rate > 0.5"], ["", "member.rate > 250"]]},
      {expression: "account.level", value: "(account.label ?? '') != 'US'"},
      {expression: "member.weighted", value: "baseRate >= baseRate"},
      {table: "t4", inputs: ["account.days", null], outputs: ["account.points", "account.decision"], rules: [
