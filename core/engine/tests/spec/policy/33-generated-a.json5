{
  name: "a 50: customer/vehicles: 1 assertion, 2 expression, 2 table; 2 root, 5 per-member, 1 top-level computed",
  policy: {
    models: {customer: {amount: "number", name: "string", weight: "number", status: "string(open|closed|pending)?", vehicles: "vehicle[]"}, vehicle: {price: "number", qty: "number", verified: "boolean?", weight: "number"}},
    blocks: [
      {assertion: "customer.quota", conditions: [["and", "not (customer.segment > 50)", 1], ["and", "(1 <= 1000 or customer.segment <= 0.5)", 1], ["or", "((customer.amount > 50 or customer.weight > 1000) and customer.status == null)", 1]]},
      {table: "t1", inputs: ["vehicle.weight", "customer.amount"], outputs: ["vehicle.risk", "vehicle.surcharge"], rules: [
        ["", "", "customer.amount", "customer.amount"],
        ["", "!= 100", "len(customer.name)", "customer.weight"],
        ["", "", "max([vehicle.price, vehicle.weight])", "(vehicle.weight) / (abs(customer.amount) + 1)"],
        ["< 18", "!= 10", "vehicle.weight", "vehicle.weight"],
        ["[10..408]", "[0.25..289.25]", "(vehicle.price + vehicle.weight)", "(customer.amount) / (abs(customer.weight) + 1)"],
        ["100, 0.25", "", "(max(map(customer.vehicles, 0.25)) ?? 0)", "vehicle.price"],
        ["250", "> 0", "0.5", ""],
      ]},
      {expression: "customer.segment", value: "(len(customer.vehicles) + len(customer.name))"},
      {table: "t2", inputs: ["customer.amount", "vehicle.weight"], outputs: ["vehicle.total", "vehicle.band", "vehicle.margin"], rules: [
        ["1, 2", "", "(vehicle.verified ?? false)", "", "customer.name"],
        [">= 100", "", "customer.amount <= (vehicle.risk ?? 0)", "(vehicle.verified ?? false)", "customer.name"],
        ["50, 5", "[3..476]", "(vehicle.verified ?? false)", "(vehicle.verified ?? false)", "'A1'"],
        ["", "0", "(vehicle.verified ?? false)", "", "'US'"],
        ["[1000..1412]", ">= 50", "(vehicle.verified ?? false)", "(vehicle.risk ?? 0) == vehicle.price", "'ok'"],
        ["> 0", "< 2", "(vehicle.verified ?? false)", "", "customer.name"],
      ]},
      {expression: "grade", value: "((customer.quota ? customer.amount : customer.amount) * (customer.quota ? customer.segment : customer.segment))"},
    ],
  },
