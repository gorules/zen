      {assertion: "flag", conditions: [["or", "some(account.members, not (#.summary))", 0], ["or", "not (account.level)", 0], ["and", "health == null", 0], ["or", "(health ?? 0) in [13..104]", 2], ["or", "len((account.level ? (account.label ?? '') : 'DE')) > 1", 0]]},
