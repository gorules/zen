      {expression: "borrower.bucket", value: "(borrower.points <= (borrower.years ?? 0) ? borrower.years : null)"},
      {match: "borrower.surcharge", arms: [["(borrower.discount ?? 0) != (borrower.years ?? 0)", "(round(borrower.points / 7, 3) + len(bonus))"], ["", "(borrower.bucket ?? 0)"]]},
      {table: "t11", inputs: ["(acct.capped ?? 0)"], outputs: ["acct.adjusted[]"], rules: [
        ["1000, 18", ""],
        ["!= 250", "contains(['none', 'high', ''], borrower.sku)"],
        ["> 1.5", "borrower.tag"],
      ]},
      {expression: "borrower.scores.net", value: "{s: 'a', n: string(len(borrower.sku) > 2), a: median([avg([borrower.points, borrower.limit, 250, (borrower.discount ?? 0)]), (0.5 + borrower.surcharge), (min(borrower.total) ?? 0), trunc((borrower.discount ?? 0))])}"},
