        ["false", "2", "tenant.priority", "(tenant.ok) / (abs(tenant.ok) + 1)"],
        ["", "50, 10", "tenant.priority", "(tenant.limit ?? 0)"],
        ["false", "0", "tenant.active", "round((tenant.limit ?? 0))"],
        ["false", "0.25", "tenant.priority", "10"],
        ["true", "5", "tenant.ok >= 0.5", "tenant.ok"],
