      {assertion: "parcel.surcharge", conditions: [["or", "((claim.score ?? 0) % (abs((claim.score ?? 0)) + 1)) <= parcel.qty", 0], ["or", "(claim.score ?? 0) <= (claim.score ?? 0)", 0]]},
      {expression: "flags.health", value: "filter(claim.parcels, contains(['low', 'VIP', ''], (#.label ?? '')))"},
