{
  name: "b 27: applicant/companies + contact: 1 assertion, 2 expression, 4 match, 1 table; 3 root, 5 per-member, 0 top-level computed",
  policy: {
    models: {applicant: {income: "number", limit: "number?", name: "string", kind: "string(retail|corporate)", companies: "company[]", contact: "contactInfo"}, company: {amount: "number", weight: "number?", status: "string(open|closed|pending)?", sku: "string"}, contactInfo: {days: "number?"}},
    blocks: [
      {match: "company.calc.exposure", arms: [["some(applicant.companies, matches(#.sku, 'a'))", "(applicant.limit ?? 0) <= 100"], ["applicant.limit == null", "(company.status ?? '') != 'closed'"], ["", "(company.weight ?? 0) <= 2"]]},
      {match: "company.health", arms: [["matches(company.sku, '^.{2,}$')", "company.sku"], ["", "`${applicant.income}/${company.calc.exposure}`"]]},
      {expression: "applicant.totals.flag", value: "matches((split(applicant.name, '-')[1] ?? 'none'), '^[A-Z]')"},
      {match: "applicant.capped", arms: [["contains(['a', 'ok', ''], applicant.name)", "((applicant.totals.flag ? applicant.name : 'DE') + '-' + (applicant.name + '-' + applicant.name))"], ["(applicant.totals.flag and applicant.totals.flag)", "`${applicant.name}/${((applicant.contact.days ?? 0) - 1000)}`"], ["matches(applicant.name, 'a')", "applicant.name"], ["", "applicant.name"]]},
      {assertion: "applicant.fee", conditions: [["and", "matches(applicant.capped, '[0-9]$')", 2], ["or", "len((applicant.totals.flag ? applicant.capped : applicant.name)) > 0", 1], ["and", "all(applicant.companies, contains(#.health, 'A1'))", 1]]},
      {match: "company.adjusted", arms: [["not (applicant.income > company.amount)", "'retail'"], ["startsWith((applicant.name + '-' + company.health), 'retail')", "(split(company.health, '-')[1] ?? 'none')"], ["(applicant.contact.days ?? 0) in [14..113)", "applicant.name"], ["isNumeric(company.sku)", "applicant.name"], ["", "company.sku"]]},
      {table: "t7", inputs: ["company.calc.exposure", "company.sku"], outputs: ["company.summary[]", "company.penalty"], rules: [
        ["false", "$ != 'US'", "", "(applicant.limit ?? 0)"],
        ["true", "startsWith($, 'ok')", "", "0.25"],
        ["true", "startsWith($, 'ok')", "(company.weight ?? 0)", "0"],
        ["", "'gold'", "1000", "(applicant.contact.days ?? 0)"],
        ["", "'high', 'x'", "company.amount", ""],
        ["false", "'retail', 'low'", "applicant.income", "applicant.income"],
      ]},
      {expression: "contactInfo.flags.segment", value: "(min([abs((avg(map(applicant.companies, trunc((#.penalty ?? 0)))) ?? 0)), 1000]) ^ 1)"},
    ],
  },
