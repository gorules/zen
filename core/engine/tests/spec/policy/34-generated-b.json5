      {match: "tenant.totals.bucket", arms: [["some(tenant.loans, (#.scores.discount or #.scores.discount))", "string((health ?? 0))"], ["", "tenant.flag"]]},
      {expression: "loan.tag", value: "not (tenant.priority)"},
      {table: "t7", hit: "collect", inputs: ["loan.tag"], outputs: ["loan.summary", "loan.eligible"], rules: [
        ["false", "tenant.active", "tenant.priority"],
        ["false", "tenant.active", "tenant.priority"],
        ["true", "loan.tag", ""],
        ["", "isNumeric(tenant.flag)", "tenant.active"],
        ["true", "tenant.priority", "loan.scores.discount"],
        ["false", "(risk ?? false)", "(tenant.birthDate ?? d('2025-01-01')) < d('2000-06-30')"],
      ]},
    ],
