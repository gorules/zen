{
  name: "b 56: claim/loans/drivers: 4 expression, 5 match, 3 table; 5 root, 9 per-member, 2 top-level computed",
  policy: {
    models: {claim: {income: "number", kind: "string(retail|corporate)?", verified: "boolean", dueDate: "date", loans: "loan[]"}, loan: {balance: "number", sku: "string", drivers: "driver[]"}, driver: {limit: "number", status: "string(open|closed|pending)?", country: "string"}},
    blocks: [
      {match: "loan.fee", arms: [["contains(['A1', 'a', ''], loan.sku)", "string(claim.verified)"], ["loan.balance <= (loan.share ?? 0)", "loan.adjusted"], ["", "claim.dueDate.format('%d')"]]},
      {expression: "decision", value: "map(claim.loans, (#.balance % (abs(#.balance) + 1)))"},
      {expression: "claim.points", value: "{v: claim.verified, ok: claim.income in [39..116]}"},
      {match: "loan.adjusted", arms: [["claim.dueDate.isSameOrBefore(d('2025-03-20'), 'month')", "loan.flags.bucket"], ["(claim.kind ?? '') == 'retail'", "loan.sku"], ["all(loan.drivers, isNumeric(#.country))", "(net + '-' + net)"], ["none(loan.drivers, (#.limit == 2 and #.limit == 18))", "net"], ["", "net"]]},
      {expression: "claim.penalty", value: "claim.dueDate.isSame(d('2025-03-20'), 'year')"},
      {table: "t8", inputs: ["max([(loan.surcharge ?? 0), claim.income, (loan.surcharge ?? 0)])", "loan.sku"], outputs: ["loan.rank", "loan.segment"], rules: [
        ["!= 250", "startsWith($, 'gold')", "(loan.surcharge ?? 0)", "loan.flags.quota"],
        ["1, 1.5", "$ != 'VIP'", "claim.income", "claim.points.v"],
      ]},
      {table: "t3", inputs: [null, "count(loan.drivers, isNumeric(#.country))"], outputs: ["loan.surcharge"], rules: [
        ["isNumeric(loan.sku)", "!= 250", "(claim.verified ? loan.balance : loan.balance)"],
        ["", "", "len(loan.sku)"],
      ]},
      {expression: "claim.review", value: "net in ['Oslo', 'a']"},
      {match: "net", arms: [["(claim.kind ?? '') != 'corporate'", "string(claim.income)"], ["claim.verified", "'US'"], ["(claim.income <= claim.income and some(claim.loans, matches(#.sku, 'a')))", "claim.dueDate.format('%d')"], ["claim.income < 0.5", "'A1'"], ["", "string(claim.income)"]]},
      {table: "t10", inputs: ["loan.balance", "loan.flags.bucket"], outputs: ["loan.share", "loan.bonus"], rules: [
        ["!= 50", "'low', 'low'", "sum(decision)", "3"],
        ["[5..133]", "", "18", "loan.balance"],
        [">= 10", "'A1', 'gold'", "loan.balance", "(loan.surcharge ?? 0)"],
        ["", "", "", "claim.income"],
      ]},
      {match: "loan.flags.quota", arms: [["not (claim.verified)", "matches(loan.sku, '^.{2,}$')"], ["loan.surcharge == null", "claim.kind == null"], ["", "claim.dueDate.isAfter(d('2025-03-20'), 'month')"]]},
      {match: "loan.flags.bucket", arms: [["((loan.surcharge ?? 0) / -6) == claim.income", "(claim.dueDate < d('2024-01-01') ? (split(loan.sku, '-')[0] ?? 'none') : string(loan.flags.quota))"], ["(claim.penalty and loan.flags.quota)", "string(claim.penalty)"], ["none(loan.drivers, isNumeric(#.country))", "(loan.sku + '-' + net)"], ["", "'US'"]]},
    ],
  },
