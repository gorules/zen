// seed 341900 (attempt 0)
{
  name: "b 20: tenant/lines + report: 1 assertion, 4 expression, 1 match, 1 table; 1 root, 5 per-member, 5 top-level computed",
  policy: {
    models: {tenant: {score: "number?", urgent: "boolean", code: "string", lines: "line[]", report: "creditReport?"}, line: {balance: "number", sku: "string", score: "number", rate: "number?"}, creditReport: {weight: "number"}},
    blocks: [
      {match: "creditReport.capped", arms: [["tenant.score != null", "tenant.code"], ["(review ?? '') in ['retail', 'A1']", "(string(calc.total.v) + '-' + `${(ok ?? 0)}/${creditReport.weight}`)"], ["(review ?? '') in ['low', 'US']", "`${tenant.urgent}/${creditReport.weight}`"], ["(ok ?? 0) in (21..46]", "tenant.code"], ["", "tenant.code"]]},
      {expression: "tenant.meta.penalty", value: "(min([abs((tenant.report.weight ?? 0)), 1000]) ^ 1)"},
      {expression: "line.decision", value: "{v: line.balance, a: line.sku, s: min([1000, (line.rate ?? 0)])}"},
      {expression: "creditReport.flag", value: "filter(tenant.lines, not ((#.tag and #.tag)))"},
      {table: "t2", inputs: ["tenant.code"], outputs: ["review", "ok"], rules: [
        ["'none', 'A1'", "tenant.code", "(tenant.report.weight ?? 0)"],
        ["'a'", "tenant.code", "(tenant.report.weight ?? 0)"],
        ["$ != 'Oslo'", "tenant.code", "(tenant.report.weight ?? 0)"],
        ["$ != 'high'", "tenant.code", ""],
        ["", "tenant.code", "(tenant.score ?? 0)"],
      ]},
      {expression: "calc.total", value: "{a: (tenant.report.weight ?? 0), v: (ok ?? 0)}"},
      {assertion: "line.tag", conditions: ["all(tenant.lines, 10 < #.score)"]},
    ],
  },
