      {match: "surcharge", arms: [["none(order.lines, #.total == null)", "len(order.lines)"], ["order.birthDate.isBefore(d('2024-01-01'), 'year')", "-((baseRate * baseRate))"], ["matches(`${(order.urgent ?? false)}/${(order.urgent ?? false)}`, '^[A-Z]')", "baseRate"], ["", "floor((order.limit ?? 0))"]]},
      {assertion: "line.tag", conditions: [["and", "order.birthDate.isSame(d('2025-01-01'), 'month')", 1], ["or", "line.total == null", 0], ["and", "((line.active ?? false) or (line.active ?? false))", 0], "not (line.verified)", ["and", "order.birthDate < d('2025-03-20')", 0]]},
      {match: "flags.eligible", arms: [["((order.urgent ?? false) and (order.urgent ?? false))", "order.city"], ["order.rate in [15..126]", "order.city"], ["", "((order.urgent ?? false) ? order.city : order.city)"]]},
      {match: "points", arms: [["(matches((order.segment ?? ''), '^[A-Z]') and not ((order.urgent ?? false)))", "not ((order.urgent ?? false))"], ["flags.eligible != 'US'", "surcharge < (order.limit ?? 0)"], ["all(order.lines, contains(['retail', 'none', ''], #.bonus))", "(order.urgent ?? false)"], ["", "(order.urgent ?? false)"]]},
      {match: "line.exposure", arms: [["contains(['none', 'low', ''], (order.calc.bucket ?? ''))", "(line.active ?? false)"], ["(line.total ?? 0) in [12..27]", "order.birthDate > d('2024-01-01')"], ["not (order.birthDate.isSameOrBefore(d('2025-01-01'), 'day'))", "all(order.lines, 10 > (#.totals.level ?? 0))"], ["((line.active ?? false) or (line.active ?? false))", "line.verified"], ["", "line.tag"]]},
      {table: "t10", inputs: ["(order.calc.bucket ?? '')", "(0 + (order.limit ?? 0))"], outputs: ["scores.capped"], rules: [
        ["$ != 'A1'", "", "points"],
        ["$ != 'ok'", "", ""],
        ["$ != 'retail'", "!= 1000", ""],
