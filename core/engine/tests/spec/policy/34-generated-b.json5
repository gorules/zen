{
  name: "b 10: borrower/companies: 3 expression, 2 match, 2 table; 2 root, 5 per-member, 1 top-level computed",
  policy: {
    models: {borrower: {balance: "number", city: "string", country: "string", companies: "company[]"}, company: {income: "number", vip: "boolean", weight: "number"}},
    blocks: [
      {table: "t1", inputs: ["company.vip"], outputs: ["company.flags.net", "company.health"], rules: [
        ["true", "company.vip", "company.vip"],
        ["", "company.vip", "company.vip"],
        ["false", "company.vip", ""],
        ["false", "company.vip", "company.vip"],
        ["true", "company.vip", "company.vip"],
        ["true", "company.vip", "company.vip"],
        ["", "company.vip", "company.vip"],
      ]},
      {match: "company.decision", arms: [["trunc(borrower.balance) >= borrower.balance", "string(borrower.balance)"], ["", "`${company.income}/${company.vip}`"]]},
      {match: "weighted", arms: [["borrower.balance in [7..152]", "`${borrower.balance == 250}/${len(borrower.country)}`"], ["(borrower.balance * borrower.balance) == 1.5", "borrower.city"], ["none(borrower.companies, #.weight > 1.5)", "(borrower.balance == 1000 ? borrower.country : borrower.city)"], ["", "borrower.city"]]},
      {expression: "company.exposure", value: "(company.income < company.weight ? company.flags.net : null)"},
      {table: "t5", inputs: ["borrower.city", "weighted"], outputs: ["borrower.review[]"], rules: [
        ["startsWith($, 'retail')", "'retail'", "(borrower.balance > 18 ? 250 : borrower.balance)"],
        ["", "", "borrower.balance"],
      ]},
      {expression: "company.tag", value: "`${company.decision}/${company.vip}`"},
      {expression: "borrower.scores.surcharge", value: "floor((max(borrower.review) ?? 0)) >= 1000"},
    ],
  },
  cases: [
