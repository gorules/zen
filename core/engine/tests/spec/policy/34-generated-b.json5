// seed 344300 (attempt 0)
{
  name: "b 44: tenant/accounts + report: 1 assertion, 5 expression, 2 match, 1 table; 2 root, 6 per-member, 1 top-level computed",
  policy: {
    models: {tenant: {limit: "number?", region: "string?", city: "string", rate: "number", accounts: "acct[]?", report: "creditReport?"}, acct: {weight: "number", country: "string", insured: "boolean"}, creditReport: {years: "number"}},
    blocks: [
      {match: "acct.capped", arms: [["some((tenant.accounts ?? []), (#.insured and #.insured))", "(tenant.report.years ?? 0)"], ["", "(acct.insured ? (tenant.report.years ?? 0) : tenant.rate)"]]},
      {table: "t2", inputs: [null], outputs: ["acct.scores.bucket", "acct.scores.fee", "acct.review"], rules: [
        ["", "acct.country", "(tenant.region ?? '')", ""],
        ["(acct.insured and acct.insured)", "tenant.city", "'A1'", "acct.country"],
        ["(tenant.report.years ?? 0) in [14..39)", "acct.country", "`${(tenant.limit ?? 0)}/${acct.insured}`", "tenant.city"],
        ["isNumeric(acct.country)", "acct.country", "(acct.insured ? tenant.city : (tenant.region ?? ''))", "'VIP'"],
      ]},
      {expression: "acct.rank", value: "(matches((acct.review ?? ''), '^.{2,}$') ? acct.scores.fee : null)"},
      {expression: "creditReport.bonus", value: "filter((tenant.accounts ?? []), #.weight <= #.capped)"},
      {assertion: "tenant.calc.share", conditions: ["string((tenant.limit ?? 0) <= 50) != 'retail'", ["or", "tenant.city in ['a', 'x']", 0], ["or", "(tenant.report.years ?? 0) != (tenant.report.years ?? 0)", 0]]},
