  policy: {
    models: {order: {rate: "number", limit: "number?", price: "number", city: "string", birthDate: "date", urgent: "boolean?", lines: "line[]"}, line: {price: "number", active: "boolean?", verified: "boolean"}},
    globals: {settings: {baseRate: "number"}},
