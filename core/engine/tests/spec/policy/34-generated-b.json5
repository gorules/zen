// seed 340800 (attempt 0)
{
  name: "b 09: applicant/accounts/drivers: 4 expression, 3 match, 4 table; 4 root, 12 per-member, 2 top-level computed",
  policy: {
    models: {applicant: {days: "number", flagged: "boolean?", country: "string", priority: "boolean?", amount: "number", vip: "boolean", accounts: "acct[]"}, acct: {weight: "number", rate: "number", verified: "boolean", drivers: "driver[]"}, driver: {balance: "number", years: "number", amount: "number"}},
    blocks: [
      {expression: "acct.bonus", value: "(10 - applicant.amount)"},
      {match: "acct.decision", arms: [["applicant.amount in [7..123)", "applicant.totals.segment.v"], ["", "(acct.margin ?? '')"]]},
      {table: "t4", inputs: ["applicant.days", "applicant.amount"], outputs: ["acct.scores.fee"], rules: [
        ["> 100", "< 0.25", "applicant.days"],
        ["", "1", "len(filter(acct.drivers, #.years >= #.balance))"],
        ["> 5", "10, 250", "acct.rate"],
      ]},
      {expression: "acct.weighted", value: "map(applicant.accounts, #.rate)"},
      {table: "t8", hit: "collect", inputs: ["bucket", "acct.weight", "applicant.vip"], outputs: ["acct.health", "acct.penalty"], rules: [
        ["", "100", "false", "(avg(map(acct.drivers, round(#.amount / 7, 0))) ?? 0)", ""],
        ["true", "", "true", "acct.rate", "applicant.totals.segment.v"],
        ["false", ">= 5", "false", "(acct.scores.fee ?? 0)", "(acct.margin ?? '')"],
        ["", ">= 0.5", "false", "applicant.totals.segment.ok", "applicant.country"],
      ]},
      {match: "bucket", arms: [["not ((applicant.priority ?? false))", "isNumeric(string(applicant.days))"], ["", "(applicant.flagged ?? false)"]]},
      {expression: "applicant.totals.segment", value: "{v: applicant.country, ok: ((applicant.amount) / (abs(applicant.days) + 1) + (applicant.days / 3)), a: applicant.amount}"},
      {table: "t3", inputs: ["applicant.priority"], outputs: ["acct.margin", "acct.flag[]"], rules: [
        ["", "applicant.country", "applicant.country"],
        ["true", "applicant.country", "(applicant.country + '-' + applicant.country)"],
        ["true", "`${acct.rate}/${(applicant.flagged ?? false)}`", "applicant.country"],
        ["", "applicant.country", "applicant.country"],
        ["true", "", ""],
        ["", "'DE'", "applicant.country"],
        ["", "trim(applicant.country)", "applicant.country"],
      ]},
      {expression: "acct.scores.tag", value: "(applicant.days <= (acct.scores.fee ?? 0) and isNumeric(applicant.country))"},
      {match: "capped", arms: [["matches(applicant.totals.segment.v, '^.{2,}$')", "matches(applicant.country, 'a')"], ["applicant.priority != null", "bucket"], ["applicant.priority == null", "not (applicant.days in [5..49])"], ["", "applicant.totals.segment.ok <= applicant.totals.segment.ok"]]},
      {table: "t10", inputs: ["acct.verified", "applicant.days", "acct.rate"], outputs: ["acct.summary", "acct.eligible", "acct.exposure"], rules: [
        ["true", ">= 0.5", "<= 1000", "applicant.vip", "'ok'", ""],
        ["true", "[1000..1284]", "!= 100", "acct.verified", "(acct.margin ?? '')", "applicant.totals.segment.ok"],
        ["", "!= 1.5", "<= 2", "acct.verified", "`${applicant.totals.segment.ok}/${acct.rate}`", "applicant.totals.segment.a"],
        ["false", "", "", "(applicant.flagged ?? false)", "(acct.margin ?? '')", "applicant.amount"],
        ["false", ">= 5", "<= 1", "", "applicant.country", "acct.rate"],
        ["true", "", "0", "some(acct.drivers, not (#.amount == 1000))", "applicant.totals.segment.v", "-((acct.scores.fee ?? 0))"],
      ]},
    ],
  },
