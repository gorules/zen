  policy: {
    models: {tenant: {price: "number", dueDate: "date", kind: "string(retail|corporate)?", parcels: "parcel[]"}, parcel: {amount: "number", limit: "number?", dueDate: "date?", price: "number", employees: "employee[]"}, employee: {rate: "number", income: "number"}},
    globals: {settings: {cap: "number"}},
    blocks: [
      {match: "parcel.fee", arms: [["matches(`${parcel.amount}/${parcel.price}`, 'a')", "((parcel.limit ?? 0) == 10 ? 'a' : 'Oslo')"], ["", "(parcel.dueDate ?? d('2025-01-01')).format('%Y')"]]},
      {assertion: "parcel.penalty", conditions: [["or", "(tenant.kind ?? '') == 'retail'", 0], ["and", "(tenant.kind ?? '') in ['corporate', 'retail']", 1], ["and", "(10 * parcel.price) >= cap", 1], ["and", "parcel.fee != 'gold'", 1]]},
      {expression: "parcel.bucket", value: "parcel.limit"},
      {expression: "surcharge", value: "cap in [9..149]"},
      {expression: "parcel.review", value: "{n: (split(`${surcharge}/${surcharge}`, '-')[0] ?? 'none'), ok: round((0.25 + parcel.amount) / 7, 2)}"},
