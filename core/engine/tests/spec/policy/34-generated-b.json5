      {match: "tenant.grade", arms: [["0.5 == cap", "tenant.price"], ["tenant.bonus == 0.5", "0.5"], ["tenant.kind == null", "cap"], ["not ((tenant.kind ?? '') in ['corporate', 'retail'])", "(sum(map(tenant.parcels, #.price)) - cap)"], ["", "tenant.price"]]},
      {expression: "parcel.band", value: "(none(parcel.employees, #.income <= #.rate) ? len(parcel.employees) : len(parcel.fee))"},
      {expression: "flag", value: "number(string(round(number(string(tenant.grade)), 2)))"},
      {match: "share", arms: [["all(tenant.parcels, contains(['DE', 'US', ''], #.fee))", "`${flag}/${none(tenant.parcels, #.amount >= (#.limit ?? 0))}`"], ["", "'ok'"]]},
    ],
  },
