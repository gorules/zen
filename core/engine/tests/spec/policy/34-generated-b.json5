      {match: "line.bonus", arms: [["order.rate in [-2..91]", "order.city"], ["isNumeric(order.city)", "order.city"], ["order.city == 'Oslo'", "order.city"], ["isNumeric(order.city)", "`${baseRate}/${line.verified}`"], ["", "order.city"]]},
      {table: "t2", hit: "collect", inputs: ["order.city"], outputs: ["net", "margin", "decision"], rules: [
