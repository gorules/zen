{
  name: "b 11: claim/accounts: 2 assertion, 3 expression, 1 match; 2 root, 6 per-member, 0 top-level computed",
  policy: {
    models: {claim: {age: "number", active: "boolean", birthDate: "date", dueDate: "date?", accounts: "acct[]?"}, acct: {price: "number?", tier: "string(gold|silver|bronze)", limit: "number", verified: "boolean"}},
    blocks: [
      {expression: "acct.level", value: "{a: -(sum([(acct.price ?? 0), acct.limit, claim.age, (acct.price ?? 0)])), s: (claim.age + -((acct.price ?? 0)))}"},
      {assertion: "acct.surcharge", conditions: [["or", "(acct.limit in [25..106] or none((claim.accounts ?? []), #.limit in [43..90]))", 1], ["and", "acct.tier == 'silver'", 1]]},
