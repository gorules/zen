      {expression: "borrower.points", value: "(avg(map(borrower.accounts, #.income)) ?? 0)"},
      {match: "borrower.rank", arms: [["contains(['low', 'gold', ''], borrower.sku)", "borrower.points == 1"], ["", "borrower.flagged"]]},
      {assertion: "acct.totals.exposure", conditions: [["or", "not (some(acct.payments, (#.city ?? '') in ['US', 'A1']))", 0], ["and", "some(acct.payments, matches((#.city ?? ''), 'a'))", 1], ["and", "acct.totals.eligible < (borrower.years ?? 0)", 1]]},
      {table: "t6", inputs: ["(borrower.years ?? 0)", null, "borrower.points"], outputs: ["borrower.penalty", "borrower.total[]", "borrower.discount"], rules: [
        ["", "(borrower.flagged and borrower.rank)", ">= 50", "", "borrower.score", "10"],
        ["!= 3", "", "<= 3", "borrower.rank", "(borrower.years ?? 0)", "(1.5) / (abs(borrower.score) + 1)"],
        [">= 100", "", "<= 100", "borrower.flagged", "number(string(borrower.limit))", "borrower.points"],
      ]},
      {table: "t7", inputs: [null, "borrower.tag", null], outputs: ["acct.capped", "acct.quota[]"], rules: [
        ["", "false", "(acct.plan ?? '') in ['premium', 'plus']", "trunc(borrower.score)", "borrower.tag"],
        ["", "false", "(borrower.rank or borrower.tag)", "acct.income", "borrower.tag"],
        ["borrower.openedAt.isSameOrBefore(d('2025-03-20'), 'year')", "false", "", "acct.totals.eligible", "(borrower.penalty ?? false)"],
        ["(borrower.discount ?? 0) > acct.income", "false", "(borrower.years ?? 0) <= (borrower.years ?? 0)", "borrower.limit", "borrower.flagged"],
        ["isNumeric(borrower.sku)", "true", "", "(max(map(acct.payments, #.amount)) ?? 0)", ""],
        ["borrower.discount == null", "false", "(borrower.tag and borrower.flagged)", "len(borrower.total)", "contains(['low', 'high', ''], borrower.sku)"],
