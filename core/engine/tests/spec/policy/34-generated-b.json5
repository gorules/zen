// seed 341300 (attempt 0)
{
  name: "b 14: tenant/parcels/parts: 3 expression, 3 match, 6 table; 11 root, 6 per-member, 1 top-level computed",
  policy: {
    models: {tenant: {balance: "number?", price: "number", years: "number", weight: "number?", since: "date", parcels: "parcel[]"}, parcel: {amount: "number", days: "number", income: "number", parts: "part[]"}, part: {age: "number?", name: "string?", urgent: "boolean?"}},
    blocks: [
      {table: "t3", inputs: ["(tenant.balance ?? 0)", "tenant.since"], outputs: ["tenant.fee"], rules: [
        ["", ">= d('2025-03-20')", "tenant.price == 0.5"],
        ["!= 1.5", "> d('2025-03-20')", "tenant.years <= 5"],
        ["[1000..1005]", "< d('2025-01-01')", "(tenant.weight ?? 0) == 100"],
        ["<= 1000", "", "tenant.years < 10"],
        ["", "< d('2024-01-01')", "(tenant.weight ?? 0) == 1.5"],
        ["2, 10", "> d('2000-06-30')", "(tenant.balance ?? 0) <= 5"],
        ["!= 100", "< d('2025-01-01')", "tenant.years == 1000"],
      ]},
      {match: "tenant.flags.capped", arms: [["tenant.since.isAfter(d('2025-03-20'), 'year')", "`${tenant.discount}/${(tenant.weight ?? 0)}`"], ["not (1000 != (tenant.scores.points ?? 0))", "`${(tenant.fee ?? false)}/${tenant.since.diff(d('2025-01-01'), 'day')}`"], ["matches(tenant.discount, '^[A-Z]')", "(split((split(tenant.discount, '-')[1] ?? 'none'), '-')[1] ?? 'none')"], ["none(tenant.parcels, #.days == 100)", "trim((split(tenant.discount, '-')[0] ?? 'none'))"], ["", "tenant.discount"]]},
      {expression: "tenant.flags.eligible", value: "{v: tenant.flags.capped in ['ok', 'Oslo'], a: all(tenant.parcels, not (#.days > 1))}"},
      {table: "t10", inputs: ["number(string(tenant.price))"], outputs: ["tenant.grade", "tenant.risk", "tenant.summary"], rules: [
        ["100", "(tenant.balance ?? 0)", "tenant.ok", "((tenant.balance ?? 0) % (abs(tenant.years) + 1))"],
        ["1.5", "", "tenant.flags.capped", "sum(map(tenant.parcels, #.income))"],
        ["", "(tenant.weight ?? 0)", "tenant.flags.capped", "1000"],
      ]},
      {table: "t11", inputs: ["parcel.band"], outputs: ["parcel.segment", "parcel.health[]", "parcel.weighted"], rules: [
        ["", "tenant.ok", "parcel.amount", "trunc(parcel.income)"],
        ["'low', 'Oslo'", "(split(tenant.flags.capped, '-')[1] ?? 'none')", "(tenant.summary ?? 0)", ""],
        ["'US', 'high'", "(tenant.flags.eligible.a ? 'retail' : parcel.band)", "0.25", "((tenant.weight ?? 0) * 250)"],
        ["$ != 'retail'", "tenant.discount", "18", "(tenant.summary ?? 0)"],
        ["$ != 'US'", "(tenant.risk ?? '')", "(parcel.penalty ?? 0)", "tenant.price"],
        ["startsWith($, 'retail')", "(tenant.risk ?? '')", "len(filter(parcel.parts, contains(['A1', 'VIP', ''], (#.name ?? ''))))", "tenant.years"],
      ]},
      {table: "t7", hit: "collect", inputs: [null, "(tenant.scores.points ?? 0)", null], outputs: ["tag"], rules: [
        ["not ((tenant.fee ?? false))", "", "tenant.years == tenant.price", "(tenant.fee ?? false)"],
        ["", "", "((tenant.fee ?? false) or (tenant.fee ?? false))", "(tenant.fee ?? false)"],
        ["((tenant.fee ?? false) or (tenant.fee ?? false))", "!= 1.5", "((tenant.fee ?? false) and (tenant.fee ?? false))", "(tenant.fee ?? false)"],
      ]},
      {table: "t1", inputs: ["parcel.income", "parcel.income", "parcel.days"], outputs: ["parcel.penalty"], rules: [
        ["", "< 1000", "!= 0.5", "0.25"],
        ["", "1000", "", "tenant.price"],
        ["5, 250", "!= 100", "", "3"],
      ]},
      {match: "parcel.band", arms: [["isNumeric(string(tenant.price > 5))", "((tenant.balance ?? 0) > 0.5 ? 'A1' : 'none')"], ["parcel.penalty == null", "string((tenant.weight ?? 0))"], ["", "'none'"]]},
      {expression: "parcel.totals.decision", value: "(tenant.balance ?? 0) in [12..29)"},
      {expression: "tenant.ok", value: "('A1' + '-' + tenant.flags.capped)"},
      {match: "tenant.discount", arms: [["((tenant.fee ?? false) or (tenant.fee ?? false))", "tenant.since.format('%Y')"], ["", "'low'"]]},
      {table: "t5", inputs: ["tenant.since", "tenant.since", "tenant.price"], outputs: ["tenant.scores.points"], rules: [
        ["< d('2000-06-30')", ">= d('2024-01-01')", "!= 50", "tenant.years"],
        ["", "", ">= 0.25", ""],
        ["< d('2025-03-20')", "> d('2025-01-01')", "50", "0"],
        ["", "", "", "(tenant.weight ?? 0)"],
      ]},
    ],
  },
