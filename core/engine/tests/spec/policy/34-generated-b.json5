    blocks: [
      {match: "line.exposure", arms: [["not (isNumeric(account.country))", "count((line.payments ?? []), (#.rate > 0.25 and 100 == 2))"], ["", "len(filter((line.payments ?? []), not (#.rate == 1)))"]]},
      {match: "creditReport.discount", arms: [["matches(account.country, '^.{2,}$')", "`${account.country}/${capped.a}`"], ["", "'Oslo'"]]},
      {table: "t8", inputs: ["account.insured"], outputs: ["account.scores.eligible", "account.points[]"], rules: [
        ["", "account.report.discount", "account.country"],
        ["true", "", "`${250}/${account.report.meta.net}`"],
        ["", "", "account.report.discount"],
        ["", "account.report.discount", "'low'"],
        ["true", "account.country", "account.report.discount"],
        ["", "(account.active ? account.country : account.report.discount)", ""],
      ]},
      {expression: "account.scores.health", value: "(split(account.report.discount, '-')[1] ?? 'none')"},
      {expression: "capped", value: "{s: len(account.lines), a: len(filter(account.lines, contains(['high', 'retail', ''], #.code)))}"},
      {expression: "line.calc.quota", value: "upper(account.country)"},
      {table: "t9", inputs: ["(capped.s + account.report.balance)", "account.active", "account.report.discount"], outputs: ["account.ok"], rules: [
        ["< 3", "true", "$ != 'VIP'", "`${(account.scores.eligible ?? '')}/${account.active}`"],
        ["<= 1000", "false", "'A1', 'high'", "account.country"],
        ["< 100", "false", "", "account.report.discount"],
        ["", "", "", "(account.scores.eligible ?? '')"],
      ]},
      {expression: "creditReport.meta.net", value: "(min([abs(len(filter(account.lines, (#.income ?? 0) > #.amount))), 1000]) ^ 1)"},
      {expression: "line.weighted", value: "line.income"},
    ],
  },
