{
  name: "b 51: account/vehicles/drivers: 1 assertion, 3 expression, 1 match, 4 table; 4 root, 9 per-member, 0 top-level computed",
  policy: {
    models: {account: {balance: "number", openedAt: "date", tier: "string(gold|silver|bronze)?", vehicles: "vehicle[]?"}, vehicle: {price: "number", region: "string", country: "string?", drivers: "driver[]"}, driver: {days: "number", openedAt: "date"}},
    blocks: [
      {match: "vehicle.meta.bucket", arms: [["(0.25 > 2 and vehicle.price == 2)", "(isNumeric(vehicle.region) ? `${(vehicle.country ?? '')}/${0 > 10}` : (vehicle.region + '-' + (vehicle.country ?? '')))"], ["account.balance in [40..66]", "'Oslo'"], ["contains(['Oslo', 'retail', ''], vehicle.region)", "account.openedAt.format('%Y-%m')"], ["not (account.balance > 100)", "'DE'"], ["", "vehicle.region"]]},
      {table: "t2", inputs: ["trunc(vehicle.price)", "(account.tier ?? '')", "vehicle.meta.bucket"], outputs: ["vehicle.review"], rules: [
        ["[250..306]", "'silver'", "$ != 'A1'", "vehicle.price"],
        ["1, 0.25", "", "startsWith($, 'a')", "(account.balance * 3)"],
        ["!= 3", "'bronze', 'silver'", "", "account.balance"],
        [">= 100", "", "$ != 'A1'", "100"],
        ["", "'bronze'", "'none'", "count(vehicle.drivers, #.days >= #.days)"],
        ["", "", "", "(account.balance - account.balance)"],
      ]},
      {expression: "vehicle.margin", value: "(vehicle.review ?? 0) == vehicle.price"},
      {assertion: "vehicle.capped", conditions: ["account.openedAt.isSameOrBefore(d('2025-01-01'), 'month')", ["or", "contains(`${vehicle.meta.bucket}/${50}`, 'gold')", 0], ["or", "(vehicle.margin or vehicle.margin)", 0], "contains((vehicle.country ?? ''), 'DE')"]},
