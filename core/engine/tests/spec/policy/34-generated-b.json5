// seed 341200 (attempt 0)
{
  name: "b 13: applicant/companies: 2 assertion, 5 expression, 2 match, 3 table; 6 root, 11 per-member, 3 top-level computed",
  policy: {
    models: {applicant: {rate: "number?", channel: "string", plan: "string(basic|plus|premium|trial)?", verified: "boolean", dueDate: "date?", companies: "company[]"}, company: {weight: "number", income: "number", insured: "boolean", name: "string"}},
    blocks: [
      {match: "applicant.calc.exposure", arms: [["applicant.plan == null", "((applicant.rate ?? 0) == (applicant.rate ?? 0) ? applicant.channel : (applicant.dueDate ?? d('2025-01-01')).format('%Y'))"], ["", "applicant.channel"]]},
      {expression: "company.weighted", value: "{a: (min([abs(company.ok.s), 1000]) ^ 3), ok: (applicant.dueDate ?? d('2025-01-01')).diff(d('2025-01-01'), 'day'), v: (applicant.grade ?? false)}"},
      {assertion: "company.flag", conditions: [["and", "company.income in [45..114]", 2], ["or", "(applicant.dueDate ?? d('2025-01-01')) >= d('2024-01-01')", 0], ["and", "len(applicant.calc.exposure) > 3", 1]]},
      {expression: "company.ok", value: "{s: (applicant.rank ?? 0)}"},
      {table: "t1", hit: "collect", inputs: ["applicant.plan", "applicant.rate"], outputs: ["flags.net"], rules: [
        ["'basic'", "", "applicant.verified"],
        ["'trial'", "", "applicant.verified"],
        ["'basic'", "1", ""],
        ["'trial'", "1.5", "(applicant.verified or applicant.verified)"],
        ["'premium'", "18", "applicant.verified"],
        ["'premium'", "3", "applicant.verified"],
      ]},
      {expression: "company.summary", value: "{s: 100, a: all(applicant.companies, matches(#.totals.eligible, '^[A-Z]'))}"},
      {assertion: "applicant.calc.points", conditions: [["and", "(applicant.rate ?? 0) in [20..164]", 0], ["or", "startsWith(lower(applicant.channel), 'a')", 0], ["or", "(applicant.dueDate ?? d('2025-01-01')) > d('2025-01-01')", 0], "startsWith(applicant.channel, 'VIP')"]},
      {match: "company.totals.eligible", arms: [["(avg(map(applicant.companies, trunc(#.weight))) ?? 0) <= (applicant.tag ?? 0)", "upper(applicant.channel)"], ["", "(company.name + '-' + applicant.calc.exposure)"]]},
      {expression: "applicant.health", value: "(min([abs((min(map(applicant.companies, #.income)) ?? 0)), 1000]) ^ 2)"},
      {table: "t11", inputs: ["(applicant.tag ?? 0)"], outputs: ["share"], rules: [
        ["!= 10", ""],
        ["> 0.25", ""],
        ["!= 1", ""],
        ["<= 0.25", "fee"],
        ["!= 0.25", "(applicant.grade ?? false)"],
        ["", "applicant.calc.points"],
      ]},
      {expression: "fee", value: "applicant.calc.exposure in ['Oslo', 'high']"},
      {table: "t5", inputs: [null, "applicant.verified", "(applicant.plan ?? '')"], outputs: ["applicant.grade", "applicant.tag", "applicant.rank"], rules: [
        ["not (applicant.verified)", "false", "'premium'", "applicant.verified", "(applicant.rate ?? 0)", "(applicant.rate ?? 0)"],
        ["(applicant.rate ?? 0) in [-5..129]", "", "'trial', 'plus'", "applicant.plan != null", "(applicant.rate ?? 0)", "(applicant.rate ?? 0)"],
        ["", "", "", "applicant.calc.points", "", ""],
      ]},
    ],
  },
