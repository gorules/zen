{
  name: "b 19: applicant/companies/parts: 1 assertion, 3 expression, 1 table; 4 root, 3 per-member, 0 top-level computed",
  policy: {
    models: {applicant: {days: "number", vip: "boolean", rate: "number?", qty: "number?", active: "boolean", score: "number", companies: "company[]"}, company: {balance: "number?", dueDate: "date", flagged: "boolean?", parts: "part[]"}, part: {score: "number?", qty: "number", amount: "number?"}},
    blocks: [
      {expression: "applicant.flags.summary", value: "(min([abs(number(string(((applicant.rate ?? 0) / -6)))), 1000]) ^ 3)"},
      {assertion: "company.rank", conditions: [["or", "(applicant.active and applicant.active)", 0]]},
      {table: "t3", inputs: ["number(string(applicant.score))"], outputs: ["applicant.decision", "applicant.capped", "applicant.flags.penalty[]"], rules: [
        ["", "(applicant.qty ?? 0)", "`${3}/${applicant.active}`", "(applicant.active ? 'none' : 'none')"],
        ["<= 250", "18", "'low'", ""],
        ["< 2", "applicant.flags.summary", "string(applicant.active)", ""],
        ["> 50", "len(filter(applicant.companies, #.balance == null))", "'Oslo'", ""],
        ["< 0", "applicant.days", "'A1'", "'x'"],
        ["> 0.5", "(applicant.qty ?? 0)", "'x'", "'low'"],
        ["", "applicant.flags.summary", "(applicant.active ? 'x' : 'low')", "string(applicant.vip)"],
      ]},
      {expression: "company.scores.bonus", value: "map(company.parts, #.qty)"},
      {expression: "company.flag", value: "map(company.parts, (#.score ?? 0))"},
    ],
  },
