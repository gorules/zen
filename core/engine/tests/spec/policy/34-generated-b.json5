{
  name: "b 16: account/lines + contact: 3 assertion, 5 expression, 2 match, 2 table; 5 root, 2 per-member, 0 top-level computed",
  policy: {
    models: {account: {balance: "number", label: "string", score: "number?", country: "string?", kind: "string(retail|corporate)", priority: "boolean", lines: "line[]", contact: "contactInfo?"}, line: {qty: "number", birthDate: "date"}, contactInfo: {limit: "number", amount: "number?", age: "number"}},
    globals: {settings: {factor: "number"}},
    blocks: [
      {assertion: "account.scores.quota", conditions: [["and", "(account.bonus or account.bonus)", 1]]},
      {expression: "account.flag", value: "number(string(len((account.country ?? ''))))"},
      {match: "line.meta.margin", arms: [["all(account.lines, #.qty < 2)", "(account.contact.age ?? 0)"], ["", "((account.contact.age ?? 0) + line.qty)"]]},
      {match: "contactInfo.calc.health", arms: [["number(string(account.balance)) != (contactInfo.review ?? 0)", "account.balance"], ["", "contactInfo.age"]]},
      {table: "t6", inputs: ["len(account.lines)"], outputs: ["contactInfo.total"], rules: [
        ["", ""],
        ["< 3", "len(account.lines)"],
        ["", "3"],
        ["< 3", "(account.score ?? 0)"],
        ["[10..486]", "len((account.country ?? ''))"],
        ["", "contactInfo.calc.health"],
      ]},
      {expression: "line.summary", value: "account.contact.calc.health == null"},
      {expression: "account.bonus", value: "all(account.lines, #.meta.margin < #.qty)"},
      {assertion: "contactInfo.eligible", conditions: [["and", "startsWith((account.priority ? account.label : (account.country ?? '')), 'gold')", 2], ["or", "isNumeric(`${account.scores.quota}/${account.priority}`)", 0], ["or", "account.score == null", 2], ["or", "isNumeric((account.country ?? ''))", 0]]},
      {expression: "account.rank", value: "-((max(map(account.lines, #.qty)) ?? 0))"},
      {assertion: "account.flags.net", conditions: [["and", "account.contact.fee != null", 2]]},
      {expression: "contactInfo.totals.adjusted", value: "{v: (account.country ?? ''), n: (contactInfo.review ?? 0), a: (account.country ?? '')}"},
