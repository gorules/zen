  policy: {
    models: {tenant: {limit: "number?", priority: "boolean", birthDate: "date?", active: "boolean", loans: "loan[]"}, loan: {score: "number", price: "number?", channel: "string", code: "string"}},
    blocks: [
      {assertion: "loan.scores.discount", conditions: [["and", "(tenant.active and tenant.active)", 2], ["or", "(tenant.birthDate ?? d('2025-01-01')) >= d('2025-01-01')", 1]]},
      {expression: "tenant.ok", value: "((tenant.limit ?? 0) * (tenant.limit ?? 0))"},
      {match: "tenant.flag", arms: [["(tenant.priority and tenant.active)", "'ok'"], ["none(tenant.loans, #.score < #.score)", "upper(string(tenant.active))"], ["(all(tenant.loans, (#.scores.discount or #.scores.discount)) or (tenant.birthDate ?? d('2025-01-01')).isAfter(d('2025-03-20'), 'month'))", "(tenant.birthDate ?? d('2025-01-01')).format('%d')"], ["10 == tenant.ok", "'none'"], ["", "'US'"]]},
      {table: "t4", inputs: ["tenant.active", "tenant.limit"], outputs: ["risk", "health"], rules: [
        ["true", "0.5", "tenant.active", ""],
