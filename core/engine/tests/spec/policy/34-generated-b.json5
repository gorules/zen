  policy: {
    models: {borrower: {score: "number", flagged: "boolean", limit: "number", years: "number?", sku: "string", openedAt: "date", accounts: "acct[]"}, acct: {income: "number", plan: "string(basic|plus|premium|trial)?", payments: "payment[]"}, payment: {amount: "number", city: "string?", priority: "boolean"}},
    blocks: [
      {expression: "acct.totals.eligible", value: "(min([abs(sum(map(acct.payments, #.amount))), 1000]) ^ 1)"},
