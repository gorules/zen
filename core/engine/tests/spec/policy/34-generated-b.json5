{
  name: "b 37: claim/items + report: 1 assertion, 4 expression, 2 match, 2 table; 4 root, 1 per-member, 1 top-level computed",
  policy: {
    models: {claim: {limit: "number", dueDate: "date", channel: "string", status: "string(open|closed|pending)?", since: "date?", items: "item[]", report: "creditReport"}, item: {balance: "number", status: "string(open|closed|pending)", insured: "boolean"}, creditReport: {age: "number?", urgent: "boolean"}},
    blocks: [
      {expression: "surcharge", value: "claim.report.age"},
      {table: "t3", inputs: ["claim.limit", "claim.report.segment", "(min(map(claim.items, #.balance)) ?? 0)"], outputs: ["claim.flag", "claim.net[]"], rules: [
        [">= 0.5", "$ != 'VIP'", "", "", "claim.status != null"],
        ["< 50", "'low', 'gold'", "", "(claim.report.age ?? 0)", "claim.report.weighted"],
        ["< 10", "'low'", "< 1.5", "claim.limit", "claim.report.urgent"],
      ]},
      {match: "creditReport.segment", arms: [["some(claim.items, #.balance != #.balance)", "claim.channel"], ["(claim.status ?? '') in ['pending', 'open']", "(creditReport.urgent ? claim.channel : claim.channel)"], ["isNumeric(claim.channel)", "(creditReport.urgent ? claim.channel : 'gold')"], ["none(claim.items, #.status == 'closed')", "claim.channel"], ["", "claim.channel"]]},
      {table: "t4", inputs: [null, "creditReport.urgent"], outputs: ["creditReport.exposure[]", "creditReport.scores.review", "creditReport.capped"], rules: [
        ["len(creditReport.segment) > 1", "true", "claim.limit", "(creditReport.age ?? 0)", "claim.channel"],
        ["(claim.flag ?? 0) >= claim.limit", "false", "(claim.flag ?? 0)", "(claim.flag ?? 0)", "creditReport.segment"],
      ]},
      {expression: "claim.risk", value: "(claim.report.rank * (claim.report.age ?? 0))"},
      {match: "creditReport.rank", arms: [["none(claim.items, (#.insured and #.insured))", "(creditReport.age ?? 0)"], ["", "(claim.limit + (creditReport.age ?? 0))"]]},
      {assertion: "creditReport.weighted", conditions: [["and", "claim.limit >= claim.limit", 1], ["or", "(isNumeric(creditReport.segment) and claim.limit < (creditReport.age ?? 0))", 0], ["and", "claim.channel == 'high'", 1], ["and", "(claim.since != null and (creditReport.age ?? 0) <= (creditReport.age ?? 0))", 0]]},
      {expression: "item.quota", value: "((item.insured and item.insured) ? surcharge : null)"},
      {expression: "claim.flags.penalty", value: "map(claim.items, -((#.quota ?? 0)))"},
    ],
  },
