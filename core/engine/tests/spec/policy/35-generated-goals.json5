      {match: "acct.tag", arms: [["order.since >= d('2024-01-01')", "order.qty"], ["not ((order.address.bonus ?? false))", "(order.address.total ?? 0)"], ["not (matches(order.address.review.s, '^[A-Z]'))", "50"], ["", "(acct.verified ? (order.address.total ?? 0) : 2)"]]},
      {table: "t10", hit: "collect", inputs: ["address.rank", "address.review.s"], outputs: ["address.band", "address.discount"], rules: [
        ["2", "'gold', 'US'", "", ""],
