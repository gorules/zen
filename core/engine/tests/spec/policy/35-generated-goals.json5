      {expression: "loan.fee", value: "{ok: 0.25, v: abs((loan.flagged ? order.weight : 0.25))}"},
      {match: "order.capped", arms: [["order.dueDate.year() == order.weight", "upper((order.country ?? ''))"], ["startsWith((order.country ?? ''), 'a')", "`${'US'}/${(order.risk.n * order.risk.n)}`"], ["isNumeric(((order.country ?? '') + '-' + (order.country ?? '')))", "('A1' + '-' + order.risk.a)"], ["", "(order.weight > 250 ? (order.country ?? '') : 'DE')"]]},
      {table: "t6", inputs: ["order.dueDate", "(order.kind ?? '')"], outputs: ["exposure", "net", "decision"], rules: [
