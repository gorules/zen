  policy: {
    models: {customer: {amount: "number?", flagged: "boolean", weight: "number", label: "string", plan: "string(basic|plus|premium|trial)", sku: "string", accounts: "acct[]"}, acct: {age: "number?", vip: "boolean", label: "string?", employees: "employee[]"}, employee: {rate: "number", insured: "boolean"}},
    blocks: [
      {expression: "acct.penalty", value: "map(acct.employees, #.rate)"},
      {match: "acct.calc.weighted", arms: [["customer.weight >= customer.weight", "customer.sku"], ["(acct.age ?? 0) != customer.weight", "`${(acct.label ?? '')}/${len(filter(acct.employees, (#.insured and #.insured)))}`"], ["", "customer.label"]]},
      {match: "customer.ok", arms: [["customer.weight >= (customer.amount ?? 0)", "customer.plan in ['trial', 'premium']"], ["", "customer.flagged"]]},
      {table: "t4", inputs: ["customer.weight"], outputs: ["acct.decision", "acct.net"], rules: [
        ["[1.5..391.5]", "not (customer.flagged)", "acct.calc.weighted"],
        ["> 0.25", "customer.ok", "'none'"],
