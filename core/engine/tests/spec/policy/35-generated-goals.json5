      {table: "t5", inputs: ["len(filter(acct.employees, (#.insured or #.insured)))", "(acct.decision ?? false)", null], outputs: ["acct.level", "acct.eligible"], rules: [
        ["[50..182]", "false", "customer.plan in ['plus', 'premium']", "matches((acct.net ?? ''), '^[A-Z]')", "(acct.age ?? 0)"],
        ["", "true", "(customer.ok and (acct.decision ?? false))", "(acct.decision ?? false)", "(acct.age ?? 0)"],
        [">= 2", "false", "100 < (acct.age ?? 0)", "customer.plan in ['plus', 'trial']", "customer.weight"],
        ["!= 1", "true", "(customer.amount ?? 0) > (customer.amount ?? 0)", "customer.flagged", "(acct.age ?? 0)"],
        ["< 2", "true", "customer.label == 'DE'", "not (customer.ok)", "len(acct.penalty)"],
