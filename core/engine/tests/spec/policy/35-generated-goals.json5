// seed 354400 (attempt 0)
{
  name: "goals 45: account/vehicles/parts: 3 expression, 4 match, 4 table; 0 root, 12 per-member, 1 top-level computed",
  policy: {
    models: {account: {income: "number", status: "string(open|closed|pending)?", birthDate: "date", vehicles: "vehicle[]"}, vehicle: {qty: "number?", label: "string", parts: "part[]"}, part: {days: "number"}},
    blocks: [
      {match: "vehicle.decision", arms: [["contains(['A1', 'a', ''], vehicle.label)", "`${(vehicle.qty ?? 0)}/${(vehicle.qty ?? 0) <= 250}`"], ["account.birthDate >= d('2025-01-01')", "vehicle.label"], ["250 > account.income", "vehicle.label"], ["", "((vehicle.qty ?? 0) > 0.25 ? vehicle.label : vehicle.label)"]]},
      {match: "vehicle.surcharge", arms: [["vehicle.decision in ['ok', 'DE']", "vehicle.label"], ["account.status == null", "vehicle.decision"], ["contains(['low', 'high', ''], vehicle.decision)", "account.birthDate.format('%Y')"], ["", "vehicle.label"]]},
      {table: "t3", hit: "collect", inputs: ["account.birthDate", "vehicle.decision", "account.income"], outputs: ["vehicle.total", "vehicle.fee"], rules: [
        [">= d('2000-06-30')", "startsWith($, 'low')", "", "'VIP'", "3 == 10"],
        ["", "'DE', 'retail'", "1000", "'A1'", "account.income in (21..182]"],
        ["> d('2025-03-20')", "", "", "vehicle.label", ""],
      ]},
      {expression: "vehicle.segment", value: "map(account.vehicles, len(#.total))"},
      {expression: "vehicle.calc.bonus", value: "(((vehicle.qty ?? 0) * (vehicle.qty ?? 0)) / -6)"},
      {table: "t6", inputs: ["account.income", "vehicle.decision"], outputs: ["vehicle.health"], rules: [
        ["", "", "account.income > 18"],
        ["", "", "vehicle.calc.bonus <= 2"],
        ["<= 100", "", "(vehicle.qty ?? 0) > 3"],
        ["", "", "vehicle.calc.bonus <= 250"],
      ]},
      {match: "vehicle.points", arms: [["account.birthDate < d('2024-01-01')", "`${vehicle.label}/${(vehicle.health ?? false)}`"], ["vehicle.calc.bonus in [38..196)", "(split(string(vehicle.calc.bonus), '-')[0] ?? 'none')"], ["contains(['ok', 'ok', ''], vehicle.label)", "vehicle.decision"], ["", "'Oslo'"]]},
      {table: "t8", inputs: ["account.status", null, "vehicle.surcharge"], outputs: ["vehicle.level", "vehicle.tag"], rules: [
        ["'closed'", "(account.status ?? '') == 'pending'", "$ != 'none'", "account.income", "vehicle.calc.bonus"],
        ["", "", "'US', 'A1'", "(vehicle.qty ?? 0)", "account.income"],
        ["'open'", "0 > (vehicle.qty ?? 0)", "'low', 'low'", "account.income", "((vehicle.qty ?? 0) * (vehicle.qty ?? 0))"],
        ["", "account.birthDate.isSameOrBefore(d('2024-01-01'), 'year')", "", "(vehicle.calc.bonus) / (abs(vehicle.calc.bonus) + 1)", "10"],
        ["'closed'", "not ((vehicle.health ?? false))", "", "round((vehicle.qty ?? 0))", "vehicle.calc.bonus"],
        ["", "", "", "account.income", ""],
      ]},
      {match: "vehicle.weighted", arms: [["(vehicle.level ?? 0) != vehicle.calc.bonus", "(vehicle.health ?? false)"], ["some(vehicle.parts, #.days != #.days)", "account.income == (vehicle.tag ?? 0)"], ["account.income in [19..110)", "vehicle.health != null"], ["vehicle.tag == null", "(vehicle.health ?? false)"], ["", "(vehicle.health ?? false)"]]},
      {table: "t10", hit: "collect", inputs: ["(vehicle.level ?? 0)", "vehicle.decision"], outputs: ["vehicle.summary"], rules: [
        ["", "", "'high'"],
        ["[100..412]", "$ != 'x'", "vehicle.points"],
      ]},
      {expression: "rank", value: "(sum(map(account.vehicles, round(#.calc.bonus / 7, 1))) + max([len(filter(account.vehicles, contains(['x', 'VIP', ''], #.decision))), (0 % (abs(account.income) + 1))]))"},
    ],
  },
  cases: [
