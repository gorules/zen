      {table: "t3", hit: "collect", inputs: ["loan.summary", "loan.weight", null], outputs: ["loan.grade"], rules: [
        ["true", "0.5", "order.balance in [30..175]", "string((loan.weight ?? 0))"],
        ["", "", "len((order.country ?? '')) > 3", "(order.country ?? '')"],
        ["true", "1.5, 1", "0.5 <= order.weight", "string(order.risk.n)"],
        ["false", "3", "((loan.summary ?? false) and (loan.summary ?? false))", "order.risk.a"],
        ["true", "50", "(loan.weight ?? 0) >= (loan.weight ?? 0)", "order.risk.a"],
        ["true", "", "((loan.summary ?? false) or loan.flagged)", "(order.country ?? '')"],
