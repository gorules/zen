{
  name: "goals 33: borrower/vehicles/payments: 2 assertion, 3 expression, 3 match, 4 table; 5 root, 9 per-member, 2 top-level computed",
  policy: {
    models: {borrower: {days: "number?", balance: "number", active: "boolean?", priority: "boolean?", vehicles: "vehicle[]"}, vehicle: {limit: "number?", verified: "boolean?", birthDate: "date", since: "date", payments: "payment[]"}, payment: {rate: "number", balance: "number", country: "string"}},
    blocks: [
      {expression: "surcharge", value: "matches((borrower.calc.net ?? ''), '^.{2,}$')"},
      {expression: "grade", value: "((borrower.balance / 3) > borrower.balance and not ((borrower.days ?? 0) < (borrower.days ?? 0)))"},
      {match: "borrower.level", arms: [["borrower.flag == null", "`${(borrower.calc.net ?? '')}/${2}`"], ["((borrower.days ?? 0) % (abs(50) + 1)) == borrower.balance", "(borrower.calc.net ?? '')"], ["((borrower.priority ?? false) and (borrower.priority ?? false))", "(split((borrower.calc.net ?? ''), '-')[0] ?? 'none')"], ["", "(borrower.calc.net ?? '')"]]},
      {table: "t8", inputs: ["(borrower.days ?? 0)"], outputs: ["vehicle.ok", "vehicle.segment", "vehicle.quota"], rules: [
        ["", "(borrower.days ?? 0)", "(vehicle.limit ?? 0)", "(vehicle.limit ?? 0)"],
        ["<= 2", "(borrower.balance) / (abs(1.5) + 1)", "(vehicle.weighted ?? 0)", "(vehicle.penalty ?? 0)"],
        ["1.5", "(borrower.points ? borrower.review : (vehicle.limit ?? 0))", "(vehicle.penalty ?? 0)", "(vehicle.weighted ?? 0)"],
        ["0.5, 0.5", "vehicle.margin", "borrower.balance", "(min([abs((vehicle.penalty ?? 0)), 1000]) ^ 2)"],
        ["", "vehicle.margin", "1", "borrower.review"],
        ["> 1.5", "(vehicle.weighted ?? 0)", "(max(map(vehicle.payments, #.balance)) ?? 0)", "len(filter(vehicle.payments, #.rate in [25..67]))"],
      ]},
      {match: "vehicle.margin", arms: [["all(borrower.vehicles, #.birthDate.isBefore(d('2025-03-20'), 'year'))", "count(borrower.vehicles, (#.limit ?? 0) in (23..151))"], ["not ((vehicle.verified ?? false))", "(borrower.balance / 3)"], ["borrower.priority != null", "(borrower.days ?? 0)"], ["some(borrower.vehicles, not ((#.verified ?? false)))", "2"], ["", "(vehicle.limit ?? 0)"]]},
      {table: "t2", inputs: ["(borrower.priority ?? false)", "borrower.days", "borrower.priority"], outputs: ["borrower.flag", "borrower.calc.net"], rules: [
        ["false", "5, 10", "true", "(borrower.priority ?? false)", "'a'"],
        ["true", "", "false", "not ((borrower.priority ?? false))", "'x'"],
        ["false", "0", "false", "(borrower.active ?? false)", ""],
        ["true", "0.5, 0", "true", "", "'ok'"],
        ["true", "100", "", "(borrower.active ?? false)", "string((borrower.active ?? false))"],
        ["", "", "", "(borrower.active ?? false)", ""],
      ]},
      {assertion: "vehicle.scores.share", conditions: [["and", "(contains(['gold', 'gold', ''], (borrower.calc.net ?? '')) and (vehicle.weighted ?? 0) < 50)", 2], ["and", "(borrower.calc.net ?? '') != 'A1'", 1], ["or", "((vehicle.segment ?? 0) / 3) <= 0.25", 1], ["and", "matches((vehicle.capped + '-' + borrower.level), 'a')", 0], ["or", "(startsWith((borrower.calc.net ?? ''), 'x') or vehicle.since.isBefore(d('2025-03-20'), 'month'))", 2]]},
      {match: "vehicle.capped", arms: [["not ((borrower.priority ?? false))", "(split((borrower.calc.net ?? ''), '-')[1] ?? 'none')"], ["none(vehicle.payments, matches(#.country, '^[A-Z]'))", "(borrower.calc.net ?? '')"], ["", "(borrower.calc.net ?? '')"]]},
      {table: "t11", inputs: ["(borrower.calc.net ?? '')"], outputs: ["vehicle.band"], rules: [
        ["startsWith($, 'DE')", "matches(vehicle.capped, 'a')"],
        ["'VIP'", "(borrower.priority ?? false)"],
        ["'VIP', 'a'", "(borrower.priority ?? false)"],
        ["", "grade"],
        ["$ != 'A1'", "(borrower.priority ?? false)"],
      ]},
      {assertion: "borrower.points", conditions: ["contains(['gold', 'x', ''], (borrower.calc.net ?? ''))"]},
      {table: "t3", inputs: ["-((borrower.days ?? 0))", "(borrower.flag ?? false)", "(vehicle.verified ?? false)"], outputs: ["vehicle.weighted", "vehicle.penalty"], rules: [
        ["0.5", "", "true", "", "vehicle.margin"],
        ["3, 1.5", "", "false", "count(vehicle.payments, #.balance > #.balance)", "18"],
        ["[0.5..467.5]", "", "false", "(vehicle.limit ?? 0)", "(borrower.days ?? 0)"],
        ["< 3", "", "false", "100", "(1 + (vehicle.limit ?? 0))"],
        ["> 1", "", "true", "(borrower.days ?? 0)", "borrower.balance"],
        ["", "true", "true", "borrower.balance", "(vehicle.limit ?? 0)"],
        ["", "", "", "(borrower.balance) / (abs(vehicle.margin) + 1)", ""],
      ]},
      {expression: "borrower.review", value: "max([(borrower.days ?? 0), borrower.balance, borrower.balance])"},
    ],
  },
