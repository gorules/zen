      ]},
      {match: "acct.points", arms: [["isNumeric(string(order.vip))", "(order.vip ? 'high' : 'x')"], ["", "'x'"]]},
      {table: "t3", inputs: ["-(address.amount)"], outputs: ["address.rank", "address.total"], rules: [
        ["", "order.qty", "address.amount"],
        ["!= 1000", "order.qty", "10"],
        ["< 1", "order.qty", "sum(map(order.accounts, #.weight))"],
        ["18", "order.qty", "address.amount"],
        ["", "order.qty", "order.qty"],
        ["< 1000", "3", "50"],
        ["", "order.qty", ""],
      ]},
      {table: "t4", inputs: ["(avg(map(order.accounts, #.weight)) ?? 0)", "order.vip", "(order.qty % (abs(5) + 1))"], outputs: ["address.bonus"], rules: [
        ["250, 10", "", "5", "order.vip"],
        [">= 3", "false", "", "all(order.accounts, contains(['DE', 'DE', ''], #.points))"],
        ["!= 1", "false", "", "order.vip"],
        ["", "false", "< 2", ""],
      ]},
      {expression: "order.meta.segment", value: "string(order.since > d('2025-03-20'))"},
      {expression: "acct.share", value: "filter(acct.parts, #.days > 1)"},
      {expression: "address.review", value: "{s: `${(address.total ?? 0)}/${len(order.meta.segment)}`}"},
      {table: "t8", inputs: ["order.since", "(address.total ?? 0)", "order.since"], outputs: ["address.risk"], rules: [
        ["< d('2025-01-01')", "1.5", "< d('2025-03-20')", "(address.rank ?? 0)"],
        ["", ">= 50", "", ""],
