    blocks: [
      {match: "share", arms: [["(shipment.since ?? d('2025-01-01')).isAfter(d('2000-06-30'), 'month')", "'VIP'"], ["some((shipment.companies ?? []), contains(['high', 'gold', ''], #.country))", "(shipment.flagged ? 'Oslo' : 'low')"], ["none((shipment.companies ?? []), #.price != null)", "`${0.5}/${(shipment.flagged and shipment.flagged)}`"], ["all((shipment.companies ?? []), isNumeric(#.country))", "'retail'"], ["", "`${shipment.flagged}/${(shipment.address.weight ?? 0)}`"]]},
      {match: "company.penalty", arms: [["(shipment.flagged and shipment.flagged)", "('A1' + '-' + company.country)"], ["", "`${shipment.flagged}/${(shipment.score ?? 0)}`"]]},
      {table: "t3", inputs: ["(min([abs((shipment.score ?? 0)), 1000]) ^ 0)", "share"], outputs: ["shipment.calc.band", "shipment.rank", "shipment.calc.review"], rules: [
