{
  name: "goals 17: applicant/lines/employees: 1 assertion, 4 expression, 2 match, 4 table; 8 root, 8 per-member, 0 top-level computed",
  policy: {
    models: {applicant: {rate: "number", since: "date", status: "string(open|closed|pending)", price: "number", dueDate: "date", lines: "line[]"}, line: {days: "number?", status: "string(open|closed|pending)", employees: "employee[]"}, employee: {rate: "number", years: "number?", insured: "boolean?"}},
    blocks: [
      {match: "line.calc.risk", arms: [["applicant.rate in [20..35]", "applicant.price"], ["line.days != null", "applicant.price"], ["", "applicant.rate"]]},
      {expression: "line.calc.review", value: "line.days == null"},
      {expression: "applicant.totals.weighted", value: "filter(applicant.lines, ((#.days ?? 0) - #.calc.risk) < (#.days ?? 0))"},
      {expression: "applicant.decision", value: "(applicant.price in [37..150] ? max([applicant.price, applicant.rate]) : round(applicant.rate / 7, 0))"},
      {table: "t5", hit: "collect", inputs: ["(min([abs(applicant.decision), 1000]) ^ 0)"], outputs: ["applicant.ok", "applicant.totals.total", "applicant.scores.rank"], rules: [
        ["<= 1", "'A1'", "(avg(map(applicant.lines, 1)) ?? 0)", "'low'"],
        ["", "'gold'", "(max(map(applicant.lines, (#.days ?? 0))) ?? 0)", "'none'"],
        ["> 5", "`${100 <= 3}/${applicant.price}`", "(avg(map(applicant.lines, #.calc.risk)) ?? 0)", "'gold'"],
      ]},
      {assertion: "applicant.surcharge", conditions: ["none(applicant.lines, #.status != 'open')", "isNumeric(string(applicant.price > 100))", ["or", "all(applicant.lines, (#.calc.review and #.calc.review))", 0], ["and", "applicant.decision in [6..140]", 1]]},
      {table: "t7", hit: "collect", inputs: [null], outputs: ["line.exposure", "line.discount", "line.health"], rules: [
        ["applicant.decision >= 1.5", "(line.calc.review and applicant.surcharge)", "applicant.rate", "applicant.rate"],
        ["50 < (line.days ?? 0)", "applicant.surcharge", "(applicant.decision - applicant.rate)", ""],
        ["applicant.price in [35..48]", "line.days != null", "", "applicant.rate"],
        ["applicant.dueDate >= d('2025-01-01')", "all(line.employees, #.years != null)", "(line.days ?? 0)", "(min([abs(applicant.decision), 1000]) ^ 1)"],
        ["", "line.status == 'closed'", "line.calc.risk", "applicant.price"],
        ["line.days != null", "applicant.surcharge", "1000", "(line.days ?? 0)"],
        ["", "line.calc.review", "applicant.price", "applicant.decision"],
      ]},
      {table: "t8", inputs: ["sum(map(applicant.lines, #.calc.risk))", "applicant.since", "applicant.since"], outputs: ["applicant.bonus", "applicant.level"], rules: [
        ["<= 1000", "", "", "'a'", "0.5"],
        ["", "> d('2025-03-20')", ">= d('2000-06-30')", "'Oslo'", "applicant.price"],
        ["> 1", "", "", "'DE'", ""],
        ["", "", "", "`${applicant.rate}/${applicant.price}`", "(1 * applicant.decision)"],
      ]},
      {table: "t9", inputs: ["applicant.since", "line.status", "line.status"], outputs: ["line.eligible"], rules: [
        ["< d('2025-03-20')", "'pending'", "'pending'", "(applicant.level ?? 0)"],
        ["", "", "", ""],
      ]},
      {match: "line.summary", arms: [["applicant.dueDate.year() <= applicant.decision", "(applicant.bonus ?? '')"], ["", "'retail'"]]},
      {expression: "line.band", value: "(applicant.dueDate < d('2000-06-30') ? line.days : null)"},
    ],
  },
