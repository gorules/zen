      {assertion: "loan.discount", conditions: [["or", "loan.price == (loan.rate ?? 0)", 1], ["or", "startsWith((loan.code ?? ''), 'US')", 1], ["and", "isNumeric((shipment.country ?? ''))", 1], ["or", "shipment.years in [29..67]", 0]]},
      {table: "t7", inputs: ["shipment.kind", "(shipment.country ?? '')", null], outputs: ["rank", "totals.adjusted", "fee"], rules: [
