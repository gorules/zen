// Generated policies with random goal subsets.
//
// Generated by gen33.py + run33.py (`python3 run33.py goals` in the generator directory of the
// round-three spec session), seed 350000. Suite i is built from seed 350000 + 100 * i +
// attempt, where attempt is the first candidate whose policy has no error diagnostics.
//
// Each suite has a random data model: a root entity with 3-6 primitive fields (number, string,
// boolean, date, enum; about 30% optional) and one relationship array to a child entity with
// 2-4 fields, sometimes a number global, a second-level array under the child (read through
// aggregates) and a single relationship on the root. Its blocks (5-12 random expression, match,
// assertion and table blocks, in document order or shuffled) write undeclared computed
// properties on the root, on every member and at the top level; later blocks read earlier ones,
// giving chains, aggregates over member computeds and members reading root computeds. Flavor b
// adds nested write paths (`x.totals.y`), object, filter and map valued computeds, nullable
// computeds, a wider function set (templates, modulo, powers, division, regex, conversions,
// date methods) and occasional 8-14 member arrays. Each suite has 12-30 random inputs: valid,
// missing optional, null optional, boundary values, empty relationships, unknown fields and
// invalid requests (missing or null required, wrong type). Every case requests a random subset
// (1-3) of the computed properties as goals, or none (all terminal writes); the output is the
// input plus the writes of the goals' cones.
//
// Outputs recorded from the driver; this chapter exists to differential-test the engines.

// seed 350000 (attempt 0)
{
  name: "goals 01: account/vehicles: 1 assertion, 2 expression, 3 match, 2 table; 1 root, 10 per-member, 1 top-level computed",
  policy: {
    models: {account: {balance: "number", weight: "number?", tier: "string(gold|silver|bronze)?", vehicles: "vehicle[]"}, vehicle: {score: "number?", flagged: "boolean?", years: "number", price: "number"}},
    blocks: [
      {expression: "vehicle.total", value: "map(account.vehicles, trunc(#.price))"},
      {match: "vehicle.net", arms: [["(vehicle.price in (32..201) or not ((vehicle.flagged ?? false)))", "(1.5 * vehicle.years)"], ["(vehicle.score ?? 0) != (account.weight ?? 0)", "((vehicle.flagged ?? false) ? 50 : 1.5)"], ["not ((vehicle.flagged ?? false))", "vehicle.years"], ["", "floor((vehicle.score ?? 0))"]]},
      {expression: "vehicle.calc.weighted", value: "{a: (vehicle.score ?? 0) == (account.weight ?? 0), n: (vehicle.flagged ?? false)}"},
      {match: "vehicle.summary", arms: [["not (vehicle.calc.weighted.n)", "string(vehicle.years != vehicle.years)"], ["not (vehicle.years in [46..66])", "'a'"], ["(account.weight ?? 0) in [45..76]", "'high'"], ["", "`${vehicle.calc.weighted.a}/${(account.weight ?? 0)}`"]]},
      {assertion: "account.points", conditions: [["and", "not (account.balance >= account.balance)", 0], ["and", "(account.balance <= 0.5 or 1.5 > 0.5)", 0], ["and", "account.balance in (6..96]", 1], "none(account.vehicles, #.price in (14..99))"]},
      {match: "totals.band", arms: [["not (account.points)", "(account.points ? (account.weight ?? 0) : account.balance) == account.balance"], ["(account.tier ?? '') in ['bronze', 'silver']", "account.points"], ["", "account.points"]]},
      {table: "t7", hit: "collect", inputs: ["vehicle.calc.weighted.n", "totals.band"], outputs: ["vehicle.decision", "vehicle.flag"], rules: [
        ["", "false", "vehicle.summary", "(avg(map(account.vehicles, len(#.summary))) ?? 0)"],
        ["false", "false", "vehicle.summary", "vehicle.net"],
        ["", "false", "'DE'", "(account.weight ?? 0)"],
        ["true", "true", "vehicle.summary", "account.balance"],
        ["", "false", "", "account.balance"],
        ["false", "", "'low'", "(account.balance * vehicle.net)"],
        ["", "", "vehicle.summary", "(vehicle.score ?? 0)"],
      ]},
      {table: "t8", inputs: ["(vehicle.score ?? 0)", "vehicle.summary"], outputs: ["vehicle.penalty", "vehicle.meta.tag[]"], rules: [
        ["5", "", "(vehicle.score ?? 0)", "(account.weight ?? 0)"],
