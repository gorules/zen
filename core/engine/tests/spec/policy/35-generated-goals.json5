// seed 353901 (attempt 1)
{
  name: "goals 40: claim/vehicles: 3 expression, 2 match; 1 root, 6 per-member, 1 top-level computed",
  policy: {
    models: {claim: {age: "number?", years: "number", amount: "number?", priority: "boolean?", vip: "boolean?", active: "boolean?", vehicles: "vehicle[]?"}, vehicle: {balance: "number?", qty: "number", label: "string"}},
    blocks: [
      {expression: "claim.meta.fee", value: "claim.vip"},
      {match: "vehicle.risk", arms: [["(claim.amount ?? 0) in (2..114]", "contains((vehicle.label + '-' + vehicle.label), 'high')"], ["", "(claim.meta.fee ?? false)"]]},
