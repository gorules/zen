        [">= 0.25", "shipment.score in [1..123)", "shipment.score in [0..121]", "string(shipment.score)", "(totals.review ?? false)", "(totals.review ?? false)"],
        ["3", "(shipment.rate ?? 0) == (shipment.rate ?? 0)", "not ((totals.review ?? false))", "`${(shipment.rate ?? 0)}/${(totals.review ?? false)}`", "(totals.review ?? false)", "(totals.review ?? false)"],
        ["< 0.25", "", "", "'US'", "", "(totals.review ?? false)"],
        ["", "", "", "shipment.birthDate.format('%Y-%m')", "(totals.review ?? false)", "(totals.review ?? false)"],
      ]},
      {expression: "parcel.meta.level", value: "(min(map(shipment.parcels, (#.rate ?? 0))) ?? 0)"},
      {match: "parcel.adjusted", arms: [["some(shipment.parcels, isNumeric(#.code))", "ceil((parcel.rate ?? 0))"], ["all(shipment.parcels, #.rate != null)", "((shipment.rate ?? 0) - 0.5)"], ["shipment.birthDate >= d('2024-01-01')", "parcel.score"], ["", "(shipment.rate ?? 0)"]]},
      {assertion: "decision", conditions: [["and", "shipment.birthDate.isSameOrBefore(d('2024-01-01'), 'month')", 1], ["and", "shipment.score > (shipment.rate ?? 0)", 0], ["or", "not ((totals.review ?? false))", 2]]},
