        ["'high'", "", "> d('2025-01-01')", "'VIP'"],
        ["'gold'", "0.5, 1000", ">= d('2025-03-20')", "'Oslo'"],
        ["'a'", "1000", "> d('2024-01-01')", "(order.country ?? '')"],
