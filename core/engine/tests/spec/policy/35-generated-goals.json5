        ["<= 1.5", "", "shipment.flagged", "(shipment.flagged or shipment.flagged)", "(shipment.score ?? 0)"],
        ["", "'low'", "shipment.flagged", "shipment.flagged", "(shipment.score ?? 0)"],
        ["3", "$ != 'Oslo'", "(shipment.flagged or shipment.flagged)", "shipment.flagged", ""],
        ["[0..366]", "$ != 'US'", "(shipment.score ?? 0) != (shipment.address.weight ?? 0)", "shipment.flagged", "(shipment.score ?? 0)"],
        ["[1..120]", "'ok'", "none((shipment.companies ?? []), not ((#.price ?? 0) > 0.5))", "shipment.flagged", "(shipment.score ?? 0)"],
      ]},
      {match: "shipment.calc.points", arms: [["startsWith(((shipment.calc.band ?? false) ? share : share), 'US')", "len(filter((shipment.companies ?? []), #.amount > #.amount))"], ["(shipment.address.weight ?? 0) in [32..45)", "(number(string((shipment.score ?? 0)))) / (abs((min([abs((shipment.address.weight ?? 0)), 1000]) ^ 1)) + 1)"], ["", "-((shipment.address.weight ?? 0))"]]},
      {table: "t5", hit: "collect", inputs: ["shipment.flagged", "shipment.calc.review"], outputs: ["company.meta.total"], rules: [
