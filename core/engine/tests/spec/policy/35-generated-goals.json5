      {assertion: "company.capped", conditions: [["or", "(matches(company.penalty, 'a') and not ((shipment.calc.band ?? false)))", 2], "contains(['low', 'none', ''], company.country)"]},
      {expression: "company.surcharge", value: "company.penalty"},
