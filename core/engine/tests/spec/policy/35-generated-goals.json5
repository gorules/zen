  policy: {
    models: {claim: {weight: "number", income: "number", price: "number", balance: "number?", lines: "line[]", contact: "contactInfo"}, line: {score: "number?", balance: "number?", rate: "number?", age: "number?", employees: "employee[]"}, employee: {years: "number", priority: "boolean", active: "boolean"}, contactInfo: {age: "number", active: "boolean?", verified: "boolean"}},
    blocks: [
      {match: "line.flags.decision", arms: [["50 > (line.rate ?? 0)", "`${(claim.balance ?? 0)}/${(line.age ?? 0)}`"], ["matches((split(claim.scores.band, '-')[1] ?? 'none'), 'a')", "`${claim.scores.band}/${matches(claim.scores.band, '^[A-Z]')}`"], ["", "`${(claim.quota ?? 0)}/${claim.price}`"]]},
      {expression: "contactInfo.margin", value: "len((contactInfo.verified ? 'high' : 'none')) > 2"},
      {assertion: "penalty", conditions: [["and", "matches(claim.scores.band, 'a')", 0], ["or", "none(claim.lines, #.flags.decision == 'low')", 1]]},
      {match: "claim.scores.band", arms: [["isNumeric(string(claim.exposure))", "string((claim.contact.active ?? false))"], ["claim.balance != null", "'retail'"], ["", "string(claim.contact.age)"]]},
      {expression: "claim.surcharge", value: "map(claim.lines, ((#.balance ?? 0) / 3))"},
      {assertion: "claim.exposure", conditions: [["and", "(claim.contact.margin or (claim.contact.active ?? false))", 1], ["and", "(claim.contact.verified or (claim.contact.active ?? false))", 2], ["and", "some(claim.lines, not ((#.balance ?? 0) > 5))", 1], "claim.weight in [-1..113]", ["and", "(claim.contact.margin and claim.contact.margin)", 2]]},
      {table: "t10", hit: "collect", inputs: ["claim.balance", "penalty"], outputs: ["contactInfo.net"], rules: [
        ["2", "true", "claim.scores.band"],
