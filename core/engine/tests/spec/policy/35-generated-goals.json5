{
  name: "goals 16: applicant/companies: 1 assertion, 4 expression, 4 match, 2 table; 6 root, 6 per-member, 1 top-level computed",
  policy: {
    models: {applicant: {years: "number", plan: "string(basic|plus|premium|trial)", days: "number", balance: "number", qty: "number", urgent: "boolean", companies: "company[]"}, company: {years: "number", limit: "number?", birthDate: "date", city: "string"}},
    blocks: [
      {expression: "margin", value: "filter(applicant.companies, #.penalty != null)"},
      {match: "company.totals.tag", arms: [["company.city in ['retail', 'VIP']", "trunc(((company.limit ?? 0) - company.years))"], ["not ((company.totals.review and (applicant.flags.weighted ?? false)))", "(applicant.days + (applicant.surcharge ?? 0))"], ["", "len(filter(applicant.companies, startsWith(#.share, 'VIP')))"]]},
      {table: "t4", inputs: ["applicant.years"], outputs: ["applicant.flags.weighted", "applicant.surcharge", "applicant.summary"], rules: [
        ["", "applicant.urgent", "applicant.qty", "'gold'"],
        ["2, 10", "applicant.urgent", "applicant.years", "'high'"],
        ["", "applicant.urgent", "applicant.years", "'a'"],
        ["< 0", "applicant.urgent", "applicant.balance", ""],
        ["[0..480]", "applicant.urgent", "applicant.balance", "'VIP'"],
        ["", "applicant.urgent", "applicant.days", "'a'"],
      ]},
      {match: "company.totals.review", arms: [["all(applicant.companies, #.birthDate.isAfter(d('2025-03-20'), 'month'))", "applicant.urgent"], ["number(string(applicant.years)) <= 1000", "(company.share + '-' + 'DE') == 'VIP'"], ["(applicant.urgent and applicant.urgent)", "company.birthDate >= d('2025-01-01')"], ["", "company.years != applicant.qty"]]},
      {expression: "applicant.band", value: "filter(applicant.companies, #.city == 'ok')"},
      {expression: "company.adjusted", value: "company.birthDate"},
      {match: "company.share", arms: [["applicant.balance in [34..142]", "(split((split(company.city, '-')[0] ?? 'none'), '-')[0] ?? 'none')"], ["", "`${company.city}/${applicant.urgent}`"]]},
      {table: "t6", inputs: ["(applicant.years + 18)"], outputs: ["company.penalty"], rules: [
        ["18", "0.5"],
        ["", "(company.limit ?? 0)"],
        ["", ""],
        ["", "company.years"],
      ]},
      {expression: "company.risk", value: "(applicant.urgent or company.totals.review)"},
      {match: "applicant.exposure", arms: [["applicant.years in [2..30]", "'low'"], ["((applicant.urgent and (applicant.flags.weighted ?? false)) and isNumeric((applicant.summary ?? '')))", "'Oslo'"], ["", "(applicant.summary ?? '')"]]},
      {assertion: "applicant.decision", conditions: [["and", "applicant.summary == null", 0], ["and", "applicant.years in [29..137]", 1]]},
    ],
  },
