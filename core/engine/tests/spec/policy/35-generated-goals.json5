// seed 352600 (attempt 0)
{
  name: "goals 27: borrower/vehicles: 1 assertion, 4 expression, 2 match, 3 table; 3 root, 5 per-member, 4 top-level computed",
  policy: {
    models: {borrower: {price: "number", age: "number", urgent: "boolean", limit: "number?", vehicles: "vehicle[]"}, vehicle: {income: "number?", insured: "boolean", active: "boolean?"}},
    globals: {settings: {baseRate: "number"}},
    blocks: [
      {table: "t1", inputs: ["baseRate", "borrower.urgent"], outputs: ["vehicle.ok", "vehicle.weighted"], rules: [
        ["", "", "'US'", "(vehicle.insured ? 'none' : 'x')"],
        ["[100..101]", "true", "'VIP'", ""],
        ["<= 18", "", "'A1'", "'retail'"],
        ["[50..544]", "true", "'A1'", "string(borrower.price)"],
        ["", "false", "'low'", "'ok'"],
        ["<= 0.5", "true", "'gold'", "`${'a'}/${borrower.price}`"],
        ["", "false", "`${250}/${borrower.urgent}`", "((vehicle.active ?? false) ? 'retail' : 'gold')"],
