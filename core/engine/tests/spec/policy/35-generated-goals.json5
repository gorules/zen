      {table: "t4", inputs: [null, "vehicle.price"], outputs: ["vehicle.bonus"], rules: [
        ["not (shipment.priority)", "18", "shipment.country"],
        ["(shipment.priority and shipment.priority)", "50", "shipment.country"],
