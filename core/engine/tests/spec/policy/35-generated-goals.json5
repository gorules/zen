// seed 354001 (attempt 1)
{
  name: "goals 41: applicant/items/parts + profile: 4 expression, 3 match, 4 table; 4 root, 7 per-member, 4 top-level computed",
  policy: {
    models: {applicant: {weight: "number", tier: "string(gold|silver|bronze)", amount: "number", insured: "boolean?", country: "string?", code: "string", items: "item[]", profile: "profile"}, item: {years: "number", since: "date", name: "string", weight: "number", parts: "part[]"}, part: {days: "number", label: "string?"}, profile: {qty: "number", urgent: "boolean?", flagged: "boolean?"}},
    blocks: [
      {match: "item.health", arms: [["(applicant.country ?? '') in ['a', 'retail']", "number(string(applicant.amount))"], ["applicant.weight in [31..219]", "18"], ["", "len(item.parts)"]]},
      {expression: "applicant.ok", value: "(isNumeric(`${applicant.weight}/${(applicant.profile.urgent ?? false)}`) or applicant.tier == 'silver')"},
      {match: "item.weighted", arms: [["applicant.tier != 'bronze'", "((applicant.country ?? '') in ['A1', 'ok'] and isNumeric(item.name))"], ["item.health == 2", "(applicant.profile.urgent ?? false)"], ["", "all(item.parts, matches((#.label ?? ''), '[0-9]$'))"]]},
      {table: "t4", inputs: ["applicant.profile.qty"], outputs: ["penalty", "calc.bucket", "level[]"], rules: [
        ["> 0.25", "applicant.profile.qty", "len((applicant.country ?? ''))", "applicant.weight"],
        ["", "applicant.weight", "(avg(map(applicant.items, 1000)) ?? 0)", "2"],
        ["", "1.5", "applicant.weight", "applicant.amount"],
        ["", "applicant.profile.qty", "applicant.weight", "(applicant.weight + applicant.profile.qty)"],
        ["< 50", "(applicant.profile.qty + applicant.profile.qty)", "applicant.amount", "2"],
        ["2, 50", "sum(map(applicant.items, #.years))", "applicant.amount", "5"],
        ["!= 18", "applicant.profile.qty", "applicant.amount", "10"],
      ]},
      {match: "applicant.segment", arms: [["contains((applicant.country ?? ''), 'ok')", "applicant.code"], ["applicant.profile.qty <= applicant.amount", "(applicant.country ?? '')"], ["isNumeric((applicant.country ?? ''))", "string(applicant.amount)"], ["", "string((calc.bucket ?? 0))"]]},
      {expression: "band", value: "(all(applicant.items, (#.weighted and #.weighted)) ? penalty : null)"},
      {expression: "item.fee", value: "{s: 2}"},
      {table: "t8", inputs: ["applicant.profile.qty", "applicant.ok", "applicant.amount"], outputs: ["applicant.total", "applicant.share"], rules: [
        ["0.25", "true", "< 3", "applicant.segment", "(applicant.insured ?? false)"],
        ["10, 2", "false", "10, 10", "(applicant.country ?? '')", "applicant.ok"],
        ["1.5, 10", "false", "100, 0.25", "(applicant.country ?? '')", "applicant.ok"],
        ["", "", "", "(applicant.country ?? '')", "(applicant.profile.flagged ?? false)"],
      ]},
      {table: "t9", inputs: ["profile.qty"], outputs: ["profile.exposure", "profile.decision"], rules: [
        ["", "(calc.bucket ?? 0)", "applicant.weight in [-5..17]"],
        ["[5..90]", "", "(applicant.share ?? false)"],
        ["", "(applicant.amount + profile.qty)", "(profile.urgent ?? false)"],
        ["1", "", "(applicant.share ?? false)"],
        ["", "applicant.amount", "applicant.tier in ['gold', 'bronze']"],
      ]},
      {table: "t10", inputs: ["applicant.tier"], outputs: ["item.totals.risk", "item.totals.bonus[]"], rules: [
        ["", "(applicant.profile.flagged ?? false)", "(applicant.profile.urgent ?? false)"],
        ["'bronze', 'silver'", "(applicant.insured ?? false)", ""],
        ["'silver', 'gold'", "(applicant.profile.decision ?? false)", ""],
        ["'gold'", "applicant.ok", "(applicant.profile.urgent ?? false)"],
      ]},
      {expression: "item.totals.margin", value: "map(applicant.items, (#.health * 3))"},
    ],
  },
  cases: [
