{
  name: "goals 21: order/accounts/parts + address: 3 expression, 2 match, 5 table; 1 root, 4 per-member, 0 top-level computed",
  policy: {
    models: {order: {qty: "number", vip: "boolean", since: "date", accounts: "acct[]", address: "address"}, acct: {weight: "number", verified: "boolean", parts: "part[]"}, part: {days: "number", tier: "string(gold|silver|bronze)"}, address: {amount: "number"}},
