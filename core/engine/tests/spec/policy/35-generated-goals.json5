      {table: "t5", inputs: ["profile.amount"], outputs: ["profile.scores.quota", "profile.health"], rules: [
        ["> 1.5", "shipment.exposure", "avg([shipment.exposure, profile.amount])"],
        ["5", "profile.amount", "shipment.days"],
        [">= 1000", "", ""],
      ]},
      {match: "vehicle.meta.points", arms: [["none(shipment.vehicles, #.score < (#.price ?? 0))", "string(not (shipment.priority))"], ["contains(['none', 'retail', ''], shipment.label)", "'VIP'"], ["shipment.profile.scores.quota != null", "(vehicle.bonus ?? '')"], ["", "shipment.label"]]},
      {expression: "vehicle.meta.decision", value: "{v: shipment.priority, a: (shipment.exposure - (shipment.profile.amount ?? 0))}"},
      {expression: "profile.capped", value: "sum(map(profile.rank, (#.price ?? 0)))"},
      {match: "profile.segment", arms: [["(shipment.country != 'retail' or matches(shipment.label, '^[A-Z]'))", "shipment.label"], ["((shipment.priority or shipment.priority) or matches(shipment.label, '^.{2,}$'))", "(shipment.priority ? shipment.country : shipment.label)"], ["contains(['Oslo', 'none', ''], shipment.country)", "shipment.label"], ["", "`${10}/${shipment.priority}`"]]},
