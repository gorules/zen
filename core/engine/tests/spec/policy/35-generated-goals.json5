      {table: "t6", inputs: ["customer.weight", "customer.plan"], outputs: ["grade", "adjusted"], rules: [
        ["5, 0.5", "'premium'", "customer.weight", "ceil((customer.amount ?? 0))"],
        ["2, 0.25", "'trial'", "(customer.amount ?? 0)", ""],
        ["[100..412]", "'plus', 'basic'", "customer.weight", "(customer.amount ?? 0)"],
        ["> 5", "'premium'", "customer.weight", "50"],
        [">= 2", "", "avg([customer.weight, (customer.amount ?? 0), (customer.amount ?? 0), 18])", "(min([abs((customer.amount ?? 0)), 1000]) ^ 3)"],
        ["", "", "-(customer.weight)", ""],
      ]},
      {expression: "customer.band", value: "((customer.ok or customer.flagged) ? grade : null)"},
