      {table: "t2", hit: "collect", inputs: ["(shipment.country ?? '')", "shipment.years", "shipment.years"], outputs: ["shipment.level", "shipment.review", "shipment.total"], rules: [
        ["startsWith($, 'x')", "", "> 10", "string(quota)", "shipment.years", "shipment.years"],
        ["'DE'", "", "<= 1", "(shipment.country ?? '')", "(0.5 - shipment.years)", "shipment.years"],
        ["", "< 1.5", "> 1.5", "(shipment.country ?? '')", "median([shipment.years, shipment.years, shipment.years])", "shipment.years"],
        ["", "", "", "(quota ? (shipment.country ?? '') : 'ok')", "", "shipment.years"],
