{
  name: "goals 36: shipment/vehicles + profile: 3 expression, 3 match, 3 table; 1 root, 7 per-member, 0 top-level computed",
  policy: {
    models: {shipment: {days: "number", label: "string", priority: "boolean", plan: "string(basic|plus|premium|trial)?", country: "string", vehicles: "vehicle[]", profile: "profile?"}, vehicle: {price: "number?", dueDate: "date", since: "date", score: "number"}, profile: {amount: "number"}},
    blocks: [
      {expression: "profile.rank", value: "filter(shipment.vehicles, ((1.5 <= 1.5 or #.score <= 3) or ((#.price ?? 0) > 100 or #.score <= 2)))"},
      {match: "shipment.exposure", arms: [["not (matches(shipment.country, '[0-9]$'))", "shipment.days"], ["shipment.plan != null", "(shipment.profile.amount ?? 0)"], ["", "(250 + shipment.days)"]]},
      {table: "t3", hit: "collect", inputs: ["shipment.days", "(vehicle.score - shipment.exposure)", null], outputs: ["vehicle.grade", "vehicle.tag"], rules: [
        ["> 1000", "0.5, 0", "shipment.days != (vehicle.price ?? 0)", "shipment.label", ""],
        ["0", ">= 0", "vehicle.dueDate >= d('2025-01-01')", "shipment.country", "matches(shipment.country, '^.{2,}$')"],
        ["", "!= 5", "(shipment.plan ?? '') in ['premium', 'basic']", "shipment.label", ""],
        ["", "", "", "string(shipment.priority)", "shipment.priority"],
