      {match: "line.risk", arms: [["isNumeric(line.flags.decision)", "claim.contact.margin"], ["all(line.employees, #.years > #.years)", "none(line.employees, #.years in [17..109])"], ["", "some(line.employees, not (#.priority))"]]},
      {table: "t8", inputs: ["line.flags.decision", "claim.weight", "claim.contact.verified"], outputs: ["line.adjusted[]", "line.ok"], rules: [
