{
  name: "goals 23: shipment/vehicles/payments: 3 assertion, 7 expression, 2 table; 7 root, 8 per-member, 2 top-level computed",
  policy: {
    models: {shipment: {qty: "number", dueDate: "date?", active: "boolean", vehicles: "vehicle[]"}, vehicle: {rate: "number", channel: "string", dueDate: "date", payments: "payment[]"}, payment: {price: "number"}},
    blocks: [
      {expression: "shipment.health", value: "{a: string(shipment.qty), ok: (50 % (abs(shipment.qty) + 1))}"},
      {assertion: "shipment.ok", conditions: [["or", "some(shipment.vehicles, #.rate in [25..135))", 1], ["or", "shipment.qty in (40..85)", 1], "shipment.health.a == 'A1'", ["or", "isNumeric(`${shipment.health.ok}/${shipment.active}`)", 0]]},
      {table: "t3", inputs: ["vehicle.rate"], outputs: ["vehicle.totals.risk", "vehicle.share", "vehicle.adjusted"], rules: [
        ["<= 18", "(shipment.active and shipment.ok)", "'retail'", "vehicle.channel"],
        ["<= 3", "shipment.ok", "vehicle.channel", "shipment.health.a"],
      ]},
      {expression: "vehicle.band", value: "map(vehicle.payments, ((#.price - #.price) % (abs(trunc(#.price)) + 1)))"},
      {table: "t5", inputs: ["(shipment.qty - shipment.health.ok)"], outputs: ["shipment.capped", "shipment.summary[]"], rules: [
        [">= 5", "shipment.active", "shipment.qty"],
        ["", "shipment.ok", ""],
        ["100, 100", "all(shipment.vehicles, #.rate == #.rate)", ""],
        ["[3..105]", "(shipment.dueDate ?? d('2025-01-01')).isAfter(d('2025-03-20'), 'day')", "shipment.health.ok"],
        ["!= 3", "shipment.ok", "shipment.health.ok"],
        ["< 18", "shipment.health.a in ['none', 'retail']", "(shipment.qty % (abs(shipment.qty) + 1))"],
        [">= 0.25", "(shipment.ok and shipment.active)", "100"],
      ]},
      {assertion: "vehicle.points", conditions: [["or", "isNumeric(string(shipment.qty))", 0], ["or", "shipment.health.ok in [23..170]", 1], ["and", "matches(string(shipment.health.ok), '^[A-Z]')", 1], ["and", "trunc(shipment.health.ok) < shipment.qty", 1], ["or", "not ((vehicle.totals.risk ?? false))", 1]]},
      {expression: "fee", value: "(shipment.dueDate ?? d('2025-01-01')).isAfter(d('2025-03-20'), 'year')"},
      {expression: "vehicle.scores.net", value: "map(shipment.vehicles, #.rate)"},
      {expression: "vehicle.flag", value: "filter(vehicle.payments, #.price < #.price)"},
      {expression: "vehicle.penalty", value: "-(sum(map(vehicle.flag, #.price)))"},
      {expression: "shipment.bonus", value: "(shipment.dueDate ?? d('2025-01-01')).add(6, 'year')"},
      {assertion: "eligible", conditions: [["or", "(min(map(shipment.vehicles, #.penalty)) ?? 0) != 0.5", 2], ["and", "shipment.bonus < d('2025-03-20')", 0]]},
    ],
  },
