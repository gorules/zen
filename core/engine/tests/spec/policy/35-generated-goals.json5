{
  name: "goals 34: borrower/companies: 1 assertion, 1 expression, 2 match, 2 table; 1 root, 5 per-member, 0 top-level computed",
  policy: {
    models: {borrower: {limit: "number", since: "date?", flagged: "boolean?", price: "number?", dueDate: "date?", rate: "number", companies: "company[]"}, company: {years: "number", score: "number?", income: "number?"}},
    blocks: [
      {table: "t1", inputs: ["borrower.flagged"], outputs: ["company.meta.bonus"], rules: [
        ["false", ""],
        ["false", ""],
        ["true", "(company.income ?? 0)"],
        ["", "(company.score ?? 0)"],
        ["false", "borrower.rate"],
        ["", "round(company.years)"],
      ]},
      {match: "company.surcharge", arms: [["(100 <= borrower.rate and borrower.since == null)", "not ((borrower.flagged ?? false))"], ["all(borrower.companies, (#.income ?? 0) <= 50)", "(company.meta.bonus ?? 0) > borrower.rate"], ["", "(company.income ?? 0) in [45..194]"]]},
      {match: "company.exposure", arms: [["((borrower.price ?? 0) % (abs(250) + 1)) < (company.income ?? 0)", "contains(`${'VIP'}/${(borrower.flagged ?? false)}`, 'A1')"], ["none(borrower.companies, not (#.surcharge))", "((borrower.flagged ?? false) and (borrower.flagged ?? false))"], ["", "company.surcharge"]]},
      {table: "t3", inputs: ["(borrower.dueDate ?? d('2025-01-01'))", "(company.meta.bonus ?? 0)"], outputs: ["company.level"], rules: [
        [">= d('2000-06-30')", "< 1", "number(string((borrower.price ?? 0)))"],
        ["", "", "(company.score ?? 0)"],
      ]},
      {expression: "company.tag", value: "(split((1000 == (company.level ?? 0) ? `${'A1'}/${(borrower.price ?? 0)}` : `${(company.income ?? 0)}/${company.surcharge}`), '-')[0] ?? 'none')"},
      {assertion: "borrower.review", conditions: [["and", "borrower.rate in [27..148]", 0], ["and", "borrower.dueDate != null", 0], "matches(`${borrower.rate}/${(borrower.flagged ?? false)}`, '^.{2,}$')"]},
    ],
  },
  cases: [
    {input: {borrower: {limit: 10, since: null, flagged: true, price: null, dueDate: "2030-12-31", rate: 7.25, companies: []}}, goals: ["company.exposure", "company.level", "company.tag"], output: {borrower: {companies: [], dueDate: "2030-12-31", flagged: true, limit: 10, price: null, rate: 7.25, since: null}}},
