    blocks: [
      {table: "t6", inputs: ["loan.meta.surcharge", "(min(map((applicant.loans ?? []), trunc(#.review))) ?? 0)", "threshold"], outputs: ["loan.risk", "loan.fee", "loan.share[]"], rules: [
        ["<= 5", "< 5", "2", "(max(map((applicant.loans ?? []), (#.margin ? (#.balance ?? 0) : (#.balance ?? 0)))) ?? 0)", "'retail'", "loan.margin"],
